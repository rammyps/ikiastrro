<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="css/tokens.css" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="Ikiastrro.Web.styles.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    @* MudBlazor providers live in MainLayout, not here: popover/dialog/snackbar must render in
       the SAME interactive render scope as the components that open them. App.razor is static
       SSR, so providers here never see the InteractiveServer components under <Routes> and
       MudSelect / MudDatePicker / MudTimePicker popovers silently fail to open. *@
    <Routes @rendermode="InteractiveServer" />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>


