@page "/"
@inject BirthDetailsRepository BirthDetailsRepo
@inject ChartGenerationService ChartGenerationService
@inject IPlaceResolver PlaceResolver
@inject NavigationManager Nav
@inject ActivePerson Active

<PageTitle>Iki-Astrro · Discover Your Path</PageTitle>

<div class="home">
    @* The Ganesha art keeps its natural aspect ratio beside both the search and Add-New
       states. *@
    <div class="home-main">

        <h1 class="home-title">DISCOVER YOUR PATH<img class="home-title-earth" src="/images/planets/orb-earth.png" alt="" aria-hidden="true" /></h1>

        <div class="home-name">
            <MudTextField T="string" @bind-Value="_query" @bind-Value:after="OnQueryChanged"
                          Label="Name" Placeholder="Search saved people…" Immediate="true"
                          Variant="Variant.Outlined" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="home-search" />

            @if (!_adding)
            {
                @if (Matches.Any())
                {
                    <div class="home-results" role="list">
                        @foreach (var p in Matches)
                        {
                            <button type="button" class="home-row" role="listitem" @onclick="@(() => OpenPerson(p))">
                                <span class="home-row-name">@p.Name</span>
                                <span class="home-row-birth">@BirthLine(p)</span>
                                <span class="home-row-open">View chart →</span>
                            </button>
                        }
                    </div>
                }

                @* One dropdown per kind of comparison (PairMode); only one open at a time. Individual is a single
                   saved-person picker that opens the Saved charts screen, the others list saved pairs filtered by the Name box. *@
                <div class="home-results home-drops">
                    @foreach (var (mode, label) in Drops)
                    {
                        var m = mode;
                        var open = _openDrop == m;
                        <div class="home-drop">
                            <button type="button" class="home-drop-head" aria-expanded="@(open ? "true" : "false")"
                                    @onclick="@(() => _openDrop = open ? null : m)">
                                <span>@label</span><span class="home-drop-caret">▾</span>
                            </button>
                            @if (open)
                            {
                                <div class="home-drop-body">
                                    @if (m == PairMode.Individual)
                                    {
                                        <label class="home-pair-field">
                                            <span>Saved person</span>
                                            <select @onchange="OpenSavedCharts">
                                                <option value="0">Choose a saved person…</option>
                                                @foreach (var p in _people.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase))
                                                {
                                                    <option value="@p.Id">@p.Name</option>
                                                }
                                            </select>
                                        </label>
                                    }
                                    else
                                    {
                                        <p class="home-pair-hint">The Name box above filters these pairs.</p>
                                        <FamilyPairsTable Mode="m" Filter="@_query" />
                                    }
                                </div>
                            }
                        </div>
                    }
                    <button type="button" class="home-add-new" @onclick="@(() => Nav.NavigateTo("/charts"))">☰ View charts</button>
                </div>

                <div class="home-results home-addbox">
                    <button type="button" class="home-add-new" @onclick="StartAdd">＋ Add New</button>
                </div>
            }
        </div>

        @if (_adding)
        {
            <div class="home-form">
                <MudTextField T="string" Label="First name" @bind-Value="_f.First" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" Label="Last name" @bind-Value="_f.Last" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <div class="home-sex">
                    <MudRadioGroup T="string" @bind-Value="_f.Sex" Class="home-sex-group">
                        <MudRadio T="string" Value="@("Male")" Color="Color.Primary" Size="Size.Small">Male</MudRadio>
                        <MudRadio T="string" Value="@("Female")" Color="Color.Primary" Size="Size.Small">Female</MudRadio>
                    </MudRadioGroup>
                </div>
                @* Editable so a birth date/time can be typed straight in — a calendar click-path
                   back to a 1900s birth year is unusable. OpenTo=Year for the same reason. *@
                <MudDatePicker Label="Date of Birth" @bind-Date="_f.Dob" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Editable="true" OpenTo="OpenTo.Year" DateFormat="dd/MM/yyyy"
                               MinDate="_minDob" MaxDate="DateTime.Today" Placeholder="dd/MM/yyyy" />
                <MudTimePicker Label="Time of Birth" @bind-Time="_f.Tob" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Editable="true" AmPm="true" Placeholder="hh:mm AM/PM" />
                <MudTextField T="string" Label="City" @bind-Value="_f.City" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" Label="Country" @bind-Value="_f.Country" Variant="Variant.Outlined" Margin="Margin.Dense"
                              OnBlur="@(() => TryGenerate(showErrors: false))" />

                @if (_error is not null)
                {
                    <MudText Class="home-form-error">@_error</MudText>
                }

                <div class="home-form-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="@(() => TryGenerate(showErrors: true))" Disabled="_busy">
                        @(_busy ? "Generating…" : "Generate Chart")
                    </MudButton>
                    <MudButton Variant="Variant.Text" OnClick="CancelAdd">Cancel</MudButton>
                </div>
            </div>
        }
    </div>

    <aside class="home-art" aria-hidden="true">
        <img class="home-art-light" src="/images/Shoden-Ganesha.png" alt="" />
        <img class="home-art-dark" src="/images/ganesha-9planet-dark.png" alt="" />
    </aside>
</div>

@code {
    private List<BirthDetails> _people = new();
    private bool _adding;
    private bool _busy;
    private string? _error;

    private readonly AddForm _f = new();
    private string _query = string.Empty; // the name-search text; never triggers navigation on its own
    private bool _autoAdded;               // Add-New form was revealed automatically by an unmatched search
    private static readonly DateTime _minDob = new(1900, 1, 1);

    protected override void OnInitialized()
    {
        Active.Clear(); // Home has no active person — hide the per-person nav tabs and band.
        _people = BirthDetailsRepo.GetAll().ToList();
    }

    // The saved list is only ever *searched* — typing filters, it never navigates. A person is
    // opened only by an explicit "View chart →" click (docs/ui/components/home.md).
    private IEnumerable<BirthDetails> Matches =>
        string.IsNullOrWhiteSpace(_query)
            ? Enumerable.Empty<BirthDetails>()
            : _people
                .Where(p => PersonName.Matches(p.Name, _query))
                .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase);

    private static string BirthLine(BirthDetails p) => $"{p.DateOfBirth:dd/MM/yyyy} · {p.PlaceCity}";

    private void OpenPerson(BirthDetails p) => Nav.NavigateTo($"/astro-facts/{p.Id}");

    private PairMode? _openDrop;
    private static readonly (PairMode Mode, string Label)[] Drops =
    [
        (PairMode.Individual, "Individual"),
        (PairMode.Marriage, "Marriage"),
        (PairMode.FamilyCore, "Family"),
        (PairMode.FamilyExtended, "Family Ext"),
    ];
    private void OpenSavedCharts(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var id) && id > 0) Nav.NavigateTo("/charts"); }

    // A search that matches no saved person IS the intent to add that person: reveal the
    // Add-New form, pre-filled from the search text (docs/ui/components/home.md). Retract it
    // only when the search is cleared or starts matching again — and only while the form is
    // still untouched, so a half-filled form is never yanked away.
    private void OnQueryChanged()
    {
        var q = _query?.Trim() ?? string.Empty;

        if (q.Length == 0)
        {
            if (_adding && _autoAdded && FormIsPristine()) CancelAdd();
            StateHasChanged();
            return;
        }

        if (!Matches.Any())
        {
            (_f.First, _f.Last) = PersonName.Split(q);
            if (!_adding) { _adding = true; _autoAdded = true; _error = null; }
        }
        else if (_adding && _autoAdded && FormIsPristine())
        {
            CancelAdd();
        }

        StateHasChanged();
    }

    // Nothing entered beyond the name that the search itself carried over.
    private bool FormIsPristine() =>
        string.IsNullOrWhiteSpace(_f.Sex) && _f.Dob is null && _f.Tob is null
        && string.IsNullOrWhiteSpace(_f.City) && string.IsNullOrWhiteSpace(_f.Country);

    private void StartAdd()
    {
        _adding = true;
        _autoAdded = false; // explicit click — never auto-retract
        _error = null;
        if (!string.IsNullOrWhiteSpace(_query))
            (_f.First, _f.Last) = PersonName.Split(_query); // the search text carries over as the new person's name
    }

    private void CancelAdd()
    {
        _adding = false;
        _autoAdded = false;
        _error = null;
    }

    private async Task TryGenerate(bool showErrors)
    {
        if (_busy) return;
        _error = null;

        if (string.IsNullOrWhiteSpace(_f.First) || string.IsNullOrWhiteSpace(_f.Last) || string.IsNullOrWhiteSpace(_f.Sex)
            || _f.Dob is null || _f.Tob is null
            || string.IsNullOrWhiteSpace(_f.City) || string.IsNullOrWhiteSpace(_f.Country))
        {
            // Country can blur before the rest is filled — only nag on an explicit submit.
            if (showErrors) _error = "Fill in first name, last name, sex, date, time, city and country — none can be blank.";
            return;
        }

        _busy = true;
        try
        {
            var dob = DateOnly.FromDateTime(_f.Dob.Value);
            var tob = TimeOnly.FromTimeSpan(_f.Tob.Value);
            var place = await PlaceResolver.ResolveAsync(_f.City!.Trim(), _f.Country!.Trim(), dob);

            var birth = new BirthDetails
            {
                Name = PersonName.Compose(_f.First, _f.Last),
                FirstName = _f.First!.Trim(),
                LastName = _f.Last!.Trim(),
                Sex = string.IsNullOrWhiteSpace(_f.Sex) ? null : _f.Sex,
                DateOfBirth = dob,
                TimeOfBirth = tob,
                PlaceCity = _f.City!.Trim(),
                PlaceCountry = _f.Country!.Trim(),
                Latitude = place.Latitude,
                Longitude = place.Longitude,
                UtcOffset = place.UtcOffset.ToString(),
                IanaTimeZoneId = place.IanaTimeZoneId,
            };

            if (BirthDetailsRepo.ExistsByName(birth.Name))
            {
                _error = $"A saved person named {birth.Name} already exists — use their saved chart, or add a distinguishing last name.";
                return;
            }

            BirthDetailsRepo.Insert(birth);
            ChartGenerationService.GenerateAll(birth);   // uses the DB's active-default ayanamsa
            Nav.NavigateTo($"/astro-facts/{birth.Id}");
        }
        catch (Exception ex)
        {
            _error = $"Could not generate the chart: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class AddForm
    {
        public string? First { get; set; }
        public string? Last { get; set; }
        public string Sex { get; set; } = string.Empty;
        public DateTime? Dob { get; set; }
        public TimeSpan? Tob { get; set; }
        public string? City { get; set; }
        public string? Country { get; set; }
    }
}
