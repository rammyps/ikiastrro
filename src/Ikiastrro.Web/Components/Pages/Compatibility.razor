        yield return ("D9 Lagna", $"{SignLabels.For(g.D9Lagna)}, ruled by {g.D9LagnaLord}", $"{SignLabels.For(b.D9Lagna)}, ruled by {b.D9LagnaLord}");
        yield return ("D9 7th house", $"{SignLabels.For(g.SeventhSign)}, ruled by {g.SeventhLord}", $"{SignLabels.For(b.SeventhSign)}, ruled by {b.SeventhLord}");
        yield return ("D9 7th lord", D9Place(g.SeventhLord, g.SeventhLordPlacement), D9Place(b.SeventhLord, b.SeventhLordPlacement));
        yield return ("Planets in the D9 7th", g.SeventhOccupants.Count == 0 ? "None" : string.Join(", ", g.SeventhOccupants),
                                               b.SeventhOccupants.Count == 0 ? "None" : string.Join(", ", b.SeventhOccupants));
        yield return ("Venus in D9", D9Place(PlanetName.Venus, g.Venus), D9Place(PlanetName.Venus, b.Venus));
        yield return ("Jupiter in D9", D9Place(PlanetName.Jupiter, g.Jupiter), D9Place(PlanetName.Jupiter, b.Jupiter));
        yield return ("Darakaraka", D9Rows_Karaka(g), D9Rows_Karaka(b));
        yield return ("D1 and D9 7th lords", $"D1 {g.D1SeventhLord}, D9 {g.SeventhLord}: {(g.SameSeventhLord ? "the same planet" : "different planets")}",
                                              $"D1 {b.D1SeventhLord}, D9 {b.SeventhLord}: {(b.SameSeventhLord ? "the same planet" : "different planets")}");
        yield return ("Same sign in D1 and D9 (vargottama)", VargottamaText(g), VargottamaText(b));
