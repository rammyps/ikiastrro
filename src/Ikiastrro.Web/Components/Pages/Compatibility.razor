@page "/compatibility/{Id:int}"
@using Ikiastrro.Core.Engines.Matching
@using Ikiastrro.Core.Models
@using Ikiastrro.Core.LifeMatters
@using Ikiastrro.Web.Components.LifeMatters
@using Microsoft.JSInterop
@inject BirthDetailsRepository BirthDetailsRepo
@inject MatchPersonRepository MatchPersonRepo
@inject DoshaChartRepository DoshaRepo
@inject SadeSatiRepository SadeSatiRepo
@inject FamilyRepository FamilyRepo
@inject DashaCompatibilityRepository DashaRepo
@inject NavamsaChartRepository NavamsaRepo
@inject PairHistoryRepository HistoryRepo
@inject ChartResultsRepository ChartResultsRepo
@inject ChartKeyDetailsRepository KeyDetailsRepo
@inject Ikiastrro.Web.Components.LifeMatters.MarriageMattersReader MarriageReader
@inject ActivePerson Active
@inject IJSRuntime JS

@* Compatibility tab — Kuta agreement for the opened person and one chosen partner, computed live by
   Core's AshtakootaCalculator from each person's stored D1 Moon (MatchPersonRepository). Nothing is
   persisted: a pair result is a pure function of the two people and the rules, so there is no pair
   table to go stale (docs/architecture/compatibility_similarity.md). Rules and their gaps are the
   Vasudev book's (SRC_VASUDEV_MATCHING_CHARTS, Ch. VI); a factor the book gives no rule for is shown as
   "not scored", never guessed. *@

<PageTitle>@(_person?.Name ?? "Compatibility") &middot; Compatibility</PageTitle>

@if (_person is null)
{
    <section class="cmp-unavailable" role="status">
        <h1 class="cmp-heading">COMPATIBILITY</h1>
        <p>No saved person found.</p>
        <a href="/">Choose a saved person</a>
    </section>
}
else
{
    @if (!PrintMode)
    {
    <h1 class="cmp-heading">COMPATIBILITY</h1>

    <section class="cmp-controls" aria-label="Choose the partner">
        <label class="cmp-field">
            <select aria-label="Compare @_person.Name with" @bind="PartnerId" @bind:after="Recompute">
                <option value="0">Choose a saved person…</option>
                @foreach (var other in _others)
                {
                    <option value="@other.Id">@other.Name</option>
                }
            </select>
        </label>
    </section>
    }

    @if (_notice is not null)
    {
        <p class="cmp-note" role="status">@_notice</p>
    }

    @if (_result is not null)
    {
        <p class="cmp-printhead">Compatibility comparison · @Groom!.Name &amp; @Bride!.Name · @DateTime.Today.ToString("d MMM yyyy") · rule set @CompatibilityRuleSet.Version</p>

        @if (_kind is not null && _kind != FamilyKind.Spouse)
        {
            <p class="cmp-note" role="status">
                Kuta, the dosha balance and the Navamsa 7th-house facts are marriage factors, so they are @(_showMarriage ? "shown here at your request" : "left out for this relationship").
                <button type="button" class="cmp-swap" @onclick="() => _showMarriage = !_showMarriage">@(_showMarriage ? "Hide marriage factors" : "Show marriage factors anyway")</button>
            </p>
        }

        <section class="cmp-board" aria-label="The two charts">
            @PersonPanel(Groom!, GroomLabel, _chartGroom, true)
            <div class="cmp-board-centre">
        <section class="cmp-glance" aria-label="Pair at a glance">
            <p class="cmp-kicker">Pair at a glance</p>
            <h2 class="cmp-glance-title" id="cmp-overview" tabindex="-1">@Groom!.Name &amp; @Bride!.Name</h2>
            @if (MarriageApplies)
            {
                <KutaDial Low="@_result.TotalMin" High="@_result.TotalMax" Scale="@AshtakootaResult.MaxTotal" Pass="@AshtakootaResult.PassMark" ValueText="@TotalText" />
            }
            <dl class="cmp-tiles">
                @if (MarriageApplies)
                {
                    <div>
                        <dt>Kuta agreement</dt>
                        <dd class="cmp-t-@VerdictClass">@TotalText / @AshtakootaResult.MaxTotal</dd>
                    </div>
                }
                @if (_link is not null && _kind != FamilyKind.Spouse)
                {
                    <div>
                        <dt>Relationship</dt>
                        <dd>@BrideLabel of @Groom!.Name · @FamilyRelation.LayerOf(_kind!.Value) layer</dd>
                    </div>
                }
                @if (MarriageApplies && _balance is not null)
                {
                    <div>
                        <dt>Mars &amp; malefics</dt>
                        <dd class="cmp-t-@BalanceClass">@BalanceText</dd>
                    </div>
                }
                @if (_saturn is not null)
                {
                    <div>
                        <dt>Sade Sati overlap</dt>
                        <dd class="cmp-t-@(_saturn.SadeSatiOverlaps ? "open" : "pass")">@(_saturn.SadeSatiOverlaps ? "Within 30 years" : "None in 30 years")</dd>
                    </div>
                }
                @if (_dashaGroom is not null && _dashaBride is not null)
                {
                    <div>
                        <dt>Running Mahadasha</dt>
                        <dd>@(_dashaGroom.Running.FirstOrDefault(s => s.Level == 1)?.Lord ?? "—") · @(_dashaBride.Running.FirstOrDefault(s => s.Level == 1)?.Lord ?? "—")</dd>
                    </div>
                }
            </dl>
            @if (MarriageApplies)
            {
            <small>The dial shows the score out of @AshtakootaResult.MaxTotal; the tick marks the book's pass mark of @AshtakootaResult.PassMark@(_result.IsComplete ? "" : "; the lighter arc is the range left open by the unscored Yoni").</small>
            }
        </section>
            </div>
            @PersonPanel(Bride!, BrideLabel, _chartBride, false)
        </section>

        @if (!PrintMode)
        {
        <nav class="cmp-nav" id="cmp-nav" aria-label="Sections on this page">
            @foreach (var (id, label) in NavSections())
            {
                <button type="button" class="cmp-navlink" data-target="@id" @onclick="() => Jump(id)">@label</button>
            }
            <span class="cmp-navtools">
                <button type="button" class="cmp-navlink" @onclick="() => SetDetails(true)">Expand all</button>
                <button type="button" class="cmp-navlink" @onclick="() => SetDetails(false)">Collapse all</button>
            </span>
        </nav>
        }

        <section class="cmp-summary" aria-labelledby="cmp-summary">
            <h2 class="cmp-summary-head" id="cmp-summary" tabindex="-1">Summary of findings</h2>
            <p class="cmp-legend cmp-stamp">Made @DateTime.Today.ToString("d MMM yyyy") under rule set @CompatibilityRuleSet.Version. The same two people and rule set always give the same result; a snapshot is kept only if you save one under History.</p>
            @if (BuildBridge() is { } bridge)
            {
                <figure class="cmp-bridge">
                    <div role="img" aria-label="@bridge.Aria">@((MarkupString)bridge.Svg)</div>
                    <figcaption>@((MarkupString)bridge.Legend)</figcaption>
                </figure>
            }        </section>

        <section class="cmp-duo" id="cmp-individual" tabindex="-1" aria-label="Each person's own facts">
            <span id="cmp-d9"></span>
            @if (PrintMode)
            {
                @foreach (var (tabId, tabLabel) in SideTabs())
                {
                    <h3 class="cmp-print-tab">@tabLabel</h3>
                    <div class="cmp-duo-grid">
                        @SideFacts(true, tabId)
                        @SideFacts(false, tabId)
                    </div>
                }
            }
            else
            {
            <div class="cmp-tabs" role="tablist" aria-label="Facts about each person">
                @foreach (var (id, label) in SideTabs())
                {
                    <button type="button" role="tab" class="cmp-tab" aria-selected="@(_sideTab == id ? "true" : "false")" @onclick="() => _sideTab = id">@label</button>
                }
            </div>
            <div class="cmp-duo-grid" role="tabpanel">
                @SideFacts(true)
                @SideFacts(false)
            </div>
            }
        </section>

        <h2 class="cmp-duo-title cmp-together-title" id="cmp-together" tabindex="-1">The two together</h2>

        @if (MarriageApplies)
        {
        <article class="cmp-card">
            <header class="cmp-card-head">
                <h2 id="cmp-kuta" tabindex="-1">Kuta agreement</h2>
                <p class="cmp-total">
                    <strong>@TotalText</strong><span> of @AshtakootaResult.MaxTotal</span>
                    <em class="cmp-verdict cmp-verdict-@VerdictClass">@VerdictText</em>
                </p>
            </header>

            <div class="cmp-people">
                @PersonCard(GroomLabel, Groom!)
                @PersonCard(BrideLabel, Bride!)
            </div>

            <details class="cmp-detail" open>

                <summary>Kuta by Kuta: score, reading and source</summary>

            <div class="cmp-scroll">
                <table class="cmp-table">
                    <thead><tr><th>Kuta</th><th>Score</th><th>Reading</th><th>Source</th></tr></thead>
                    <tbody>
                        @foreach (var k in _result.Scored)
                        {
                            <tr>
                                <th scope="row">@k.Name</th>
                                <td data-label="Score" class="cmp-score cmp-@StatusClass(k)">@(k.Score?.ToString() ?? "—") / @k.MaxScore <span class="cmp-flag cmp-flag-@KutaFlagClass(k)">@KutaFlagText(k)</span></td>
                                <td data-label="Reading">@k.Reason</td>
                                <td data-label="Source" class="cmp-src">@k.SourceLocator</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            </details>
        </article>

        <article class="cmp-card">
            <header class="cmp-card-head">
                <h2>Also tested (South Indian)</h2>
                <p class="cmp-sub">@_result.AdditionalScore / @_result.AdditionalMax. The book gives these no numeric value; 1 per pass is PyJHora's weight, kept outside the 36.</p>
            </header>
            <details class="cmp-detail" open>
                <summary>South Indian factors: score, reading and source</summary>
            <div class="cmp-scroll">
                <table class="cmp-table">
                    <thead><tr><th>Factor</th><th>Score</th><th>Reading</th><th>Source</th></tr></thead>
                    <tbody>
                        @foreach (var k in _result.Additional)
                        {
                            <tr>
                                <th scope="row">@k.Name</th>
                                <td data-label="Score" class="cmp-score cmp-@StatusClass(k)">@(k.Score?.ToString() ?? "—") / @k.MaxScore <span class="cmp-flag cmp-flag-@KutaFlagClass(k)">@KutaFlagText(k)</span></td>
                                <td data-label="Reading">@k.Reason</td>
                                <td data-label="Source" class="cmp-src">@k.SourceLocator</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            </details>
        </article>

        @if (_doshaGroom is not null && _doshaBride is not null && _balance is not null)
        {
            <article class="cmp-card">
                <header class="cmp-card-head">
                    <h2 id="cmp-dosha" tabindex="-1">Mars and the malefics (Dosha Samya)</h2>
                    <p class="cmp-total"><em class="cmp-verdict cmp-verdict-@BalanceClass">@BalanceText</em></p>
                </header>
                <p class="cmp-pad">@_balance.Reason <span class="cmp-src">@_balance.SourceLocator</span></p>
                <details class="cmp-detail" open>
                    <summary>Does each chart carry the same affliction?</summary>
                    <div class="cmp-scroll">
                        <table class="cmp-table">
                            <thead><tr><th>Affliction</th><th>@Groom!.Name</th><th>@Bride!.Name</th><th>In both or neither?</th></tr></thead>
                            <tbody>
                                @foreach (var row in _matchup!)
                                {
                                    <tr>
                                        <th scope="row">@row.Dosha</th>
                                        <td data-label="@Groom!.Name">@(row.First.Count == 0 ? "None" : string.Join("; ", row.First))</td>
                                        <td data-label="@Bride!.Name">@(row.Second.Count == 0 ? "None" : string.Join("; ", row.Second))</td>
                                        <td data-label="In both or neither?">@(row.SameInBoth ? "Yes" : "No")</td>
                                    </tr>
                                }
                                <tr>
                                    <th scope="row">Mars' stored D1 dignity</th>
                                    <td data-label="@Groom!.Name">@DignityText(_dignityGroom, PlanetName.Mars)</td>
                                    <td data-label="@Bride!.Name">@DignityText(_dignityBride, PlanetName.Mars)</td>
                                    <td data-label="In both or neither?">Shown only</td>
                                </tr>
                                <tr>
                                    <th scope="row">Rahu's stored D1 dignity</th>
                                    <td data-label="@Groom!.Name">@DignityText(_dignityGroom, PlanetName.Rahu)</td>
                                    <td data-label="@Bride!.Name">@DignityText(_dignityBride, PlanetName.Rahu)</td>
                                    <td data-label="In both or neither?">Shown only</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </details>
                <p class="cmp-pad cmp-sub">The book's one balancing rule (pp.56-58) is the only cancellation applied, and it is the result above. Not applied, because no cited source gives them: cancellation by Mars or Rahu being in its own, exalted or debilitated sign, by benefic aspects on the afflicted planet, or by its dispositor. The dignity row is shown for the reader and changes nothing. Whether Sun, Saturn or Ketu afflictions need balancing is not stated by the book.</p>
            </article>
        }

        }

        @if (_synastry is not null)
        {
            <article class="cmp-card">
                <header class="cmp-card-head">
                    <h2 id="cmp-synastry" tabindex="-1">Cross-chart contacts (synastry)</h2>
                    <p class="cmp-sub">Directional facts from D1 signs: no source is cited yet for what a contact means.</p>
                </header>
                @if (!MarriageApplies)
                {
                    <div class="cmp-people">
                        @PersonCard(GroomLabel, Groom!)
                        @PersonCard(BrideLabel, Bride!)
                    </div>
                }
                <details class="cmp-detail" open>
                    <summary>Moon to Moon and Venus to Mars, each way</summary>
                    <div class="cmp-scroll">
                        <table class="cmp-table">
                            <thead><tr><th>Contact</th><th>Counted from the first to the second</th></tr></thead>
                            <tbody>
                                @foreach (var row in SynastryPairRows())
                                {
                                    <tr>
                                        <th scope="row">@row.Contact</th>
                                        <td data-label="Reading">@row.Reading</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
                <details class="cmp-detail" open>
                    <summary>Each person's planets in the other's houses</summary>
                    <div class="cmp-scroll">
                        <table class="cmp-table">
                            <thead><tr><th>Point</th><th>@Groom!.Name's points in @Bride!.Name's chart</th><th>@Bride!.Name's points in @Groom!.Name's chart</th></tr></thead>
                            <tbody>
                                @foreach (var row in OverlayRows())
                                {
                                    <tr>
                                        <th scope="row">@row.Point</th>
                                        <td data-label="@(Groom!.Name + " in " + Bride!.Name)">@row.GroomInBride</td>
                                        <td data-label="@(Bride!.Name + " in " + Groom!.Name)">@row.BrideInGroom</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
                <details class="cmp-detail">
                    <summary>Planets sharing a sign or in opposite signs (@_synastry.Contacts.Count)</summary>
                    <div class="cmp-scroll">
                        <table class="cmp-table">
                            <thead><tr><th>@Groom!.Name's planet</th><th>@Bride!.Name's planet</th><th>Contact</th></tr></thead>
                            <tbody>
                                @foreach (var c in _synastry.Contacts)
                                {
                                    <tr>
                                        <th scope="row">@c.First</th>
                                        <td data-label="@Bride!.Name">@c.Second</td>
                                        <td data-label="Contact">@(c.Kind == ContactKind.SameSign ? "Same sign" : "Opposite signs")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
                <p class="cmp-pad cmp-sub">Houses are Whole Sign, counted from the other person's Lagna. Contacts are by sign, not by degree, and the special aspects of Mars, Jupiter and Saturn are not computed. "Key house" marks the houses that signify this relationship (@Bride!.Name as @BrideLabel.ToLowerInvariant() in @Groom!.Name's chart: @KeyHousesText(KeyKindInGroomChart); @Groom!.Name as @GroomLabel.ToLowerInvariant() in @Bride!.Name's chart: @KeyHousesText(KeyKindInBrideChart)). They are a display choice on the standard house meanings, and traditions differ on parents; no verdict is given.</p>
            </article>
        }

        @if (_shared is not null)
        {
            <article class="cmp-card">
                <header class="cmp-card-head">
                    <h2 id="cmp-similarity" tabindex="-1">What the two charts share</h2>
                    <p class="cmp-sub">@_shared.Count shared @(_shared.Count == 1 ? "fact" : "facts"). A count of coincidences, not a score.</p>
                </header>
                @if (_shared.Count == 0)
                {
                    <p class="cmp-pad">The two charts share no Lagna, Moon, Sun, nakshatra or planetary sign.</p>
                }
                else
                {
                    <details class="cmp-detail" open>
                        <summary>Shared facts by kind</summary>
                        <div class="cmp-scroll">
                            <table class="cmp-table">
                                <thead><tr><th>Kind</th><th>Shared</th></tr></thead>
                                <tbody>
                                    @foreach (var f in _shared)
                                    {
                                        <tr>
                                            <th scope="row">@f.Category</th>
                                            <td data-label="Shared">@f.Text</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                }
                <p class="cmp-pad cmp-sub">How common each coincidence is in the general population has not been measured yet (base rates are a later step), so a shared fact is not offered as evidence of a connection. This works for any two saved people, whatever their recorded relationship.</p>
            </article>
        }

        @if (_saturn is not null)
        {
            <article class="cmp-card">
                <header class="cmp-card-head">
                    <h2 id="cmp-saturn" tabindex="-1">Saturn from the Moon: periods that coincide</h2>
                    <p class="cmp-total"><em class="cmp-verdict cmp-verdict-@(_saturn.SadeSatiOverlaps ? "open" : "pass")">@(_saturn.SadeSatiOverlaps ? "Sade Sati overlaps in the next 30 years" : "Sade Sati does not overlap in the next 30 years")</em></p>
                </header>
                <details class="cmp-detail" open>
                    <summary>When both are in the same Saturn period (each person's own periods are in their panel above)</summary>
                <div class="cmp-scroll">
                    <table class="cmp-table">
                        <thead><tr><th>Period</th><th>Both at once</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < _saturn.First.Count; i++)
                            {
                                var category = _saturn.First[i].Category;
                                <tr>
                                    <th scope="row">@category</th>
                                    <td data-label="Both at once" class="cmp-score">@Overlaps(category)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                </details>
                <p class="cmp-pad cmp-sub">Saturn over the 12th, 1st and 2nd signs from the Moon is Sade Sati (Rising, Peak, Setting); over the 4th and 8th it is Kantaka and Ashtama Shani. The periods come from the stored Saturn transit table; neither the book nor the stored rules give a verdict on two people's periods coinciding, so only the dates are shown.</p>
            </article>
        }

        @if (_dasha is not null && _dashaGroom is not null && _dashaBride is not null)
        {
            <article class="cmp-card">
                <header class="cmp-card-head">
                    <h2 id="cmp-dasha" tabindex="-1">Dasha picture</h2>
                    <p class="cmp-sub">Vimshottari, from the stored periods. Facts only: no verdict is given on whether a period supports or strains a marriage.</p>
                </header>

                <details class="cmp-detail">

                    <summary>Dasha table: birth, Mahadasha, Antardasha and Pratyantar lords</summary>

                <div class="cmp-scroll">
                    <table class="cmp-table">
                        <thead><tr><th>Dasha</th><th>@Groom!.Name</th><th>@Bride!.Name</th><th>How each lord regards the other</th></tr></thead>
                        <tbody>
                            <tr>
                                <th scope="row">Birth dasha (Moon's nakshatra lord)</th>
                                <td data-label="@Groom!.Name" class="cmp-score">@_dashaGroom.BirthLord</td>
                                <td data-label="@Bride!.Name" class="cmp-score">@_dashaBride.BirthLord</td>
                                <td data-label="Regard">@Regard(_dasha.BirthLordFirstToSecond) · @Regard(_dasha.BirthLordSecondToFirst)</td>
                            </tr>
                            @foreach (var level in new[] { 1, 2, 3 })
                            {
                                var g = _dashaGroom.Running.FirstOrDefault(s => s.Level == level);
                                var b = _dashaBride.Running.FirstOrDefault(s => s.Level == level);
                                <tr>
                                    <th scope="row">@LevelName(level)</th>
                                    <td data-label="@Groom!.Name">@RunningText(g)</td>
                                    <td data-label="@Bride!.Name">@RunningText(b)</td>
                                    <td data-label="Regard">
                                        @if (level == 1 && _dasha.MahaFirstToSecond is not null && _dasha.MahaSecondToFirst is not null)
                                        {
                                            @($"{Regard(_dasha.MahaFirstToSecond)} · {Regard(_dasha.MahaSecondToFirst)}")
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                </details>
                <p class="cmp-pad cmp-sub">Regard is permanent (natural) friendship from the stored table, which is not defined for Rahu and Ketu.</p>

                @if (_dasha.SandhiNotes.Count > 0)
                {
                    <ul class="cmp-notes">
                        @foreach (var note in _dasha.SandhiNotes)
                        {
                            <li>@note (The width of this junction window is a display choice; no source is cited for it.)</li>
                        }
                    </ul>
                }
            </article>

            <article class="cmp-card">
                <header class="cmp-card-head">
                    <h2 id="cmp-timing" tabindex="-1">Dashas on one timeline</h2>
                    <p class="cmp-sub">Mahadasha (upper bar) and Antardasha (lower bar) for the next @DashaYears years, both people on the same dates.</p>
                </header>
                @TimelineLane(Groom!.Name, _dashaGroom)
                @TimelineLane(Bride!.Name, _dashaBride)
                <div class="cmp-axis" aria-hidden="true">
                    @foreach (var year in AxisYears())
                    {
                        <span style="left:@AxisPercent(year)%">@year</span>
                    }
                </div>
            </article>

            <article class="cmp-card">
                <header class="cmp-card-head">
                    <h2 id="cmp-changes" tabindex="-1">Dasha changes ahead</h2>
                    <p class="cmp-sub">Every Mahadasha and Antardasha change for either person in the next @DashaYears years, in date order. Facts only: no source classifies a period as supportive or difficult.</p>
                </header>
                <details class="cmp-detail" open>
                    <summary>Next @Math.Min(12, _timeline!.Changes.Count) changes</summary>
                    <div class="cmp-scroll">
                        @ChangesTable(_timeline.Changes.Take(12))
                    </div>
                </details>
                @if (_timeline.Changes.Count > 12)
                {
                    <details class="cmp-detail">
                        <summary>Later changes (@(_timeline.Changes.Count - 12))</summary>
                        <div class="cmp-scroll">
                            @ChangesTable(_timeline.Changes.Skip(12))
                        </div>
                    </details>
                }
                <details class="cmp-detail" open>
                    <summary>Periods both people share (same lord, same level, at the same time)</summary>
                    @if (_timeline.SharedWindows.Count == 0)
                    {
                        <p class="cmp-pad">No Mahadasha or Antardasha lord is shared at the same time in the next @DashaYears years.</p>
                    }
                    else
                    {
                        <div class="cmp-scroll">
                            <table class="cmp-table">
                                <thead><tr><th>Level</th><th>Lord</th><th>From</th><th>To</th></tr></thead>
                                <tbody>
                                    @foreach (var w in _timeline.SharedWindows)
                                    {
                                        <tr>
                                            <th scope="row">@LevelName(w.Level)</th>
                                            <td data-label="Lord" class="cmp-score">@w.Lord</td>
                                            <td data-label="From">@w.Start.ToString("d MMM yyyy")</td>
                                            <td data-label="To">@w.End.ToString("d MMM yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </details>
                <p class="cmp-pad cmp-sub">"Rules" and "sits in" are houses counted from that person's own Lagna, for the lord that begins. Which of them help or hinder a marriage is not classified here until a source is cited.</p>
            </article>
        }

        @if (!PrintMode)
        {
        <article class="cmp-card">
            <header class="cmp-card-head">
                <h2 id="cmp-history" tabindex="-1">History and notes</h2>
                <p class="cmp-sub">What you record about this pair. Notes and saved snapshots are kept as written; the page itself never stores a result.</p>
            </header>
            <div class="cmp-pad cmp-history">
                @if (_kind == FamilyKind.Spouse)
                {
                    <h3>Marriage</h3>
                    <div class="cmp-historyrow">
                        <label class="cmp-field"><span>Date of marriage</span>
                            <input type="date" value="@_marriageInput" @onchange="e => _marriageInput = e.Value?.ToString() ?? string.Empty" />
                        </label>
                        <button type="button" class="cmp-swap" @onclick="SaveMarriage">Save date</button>
                        @if (_marriage is not null)
                        {
                            <button type="button" class="cmp-swap" @onclick="ClearMarriage">Clear</button>
                        }
                    </div>
                    @if (_marriage is not null)
                    {
                        <p class="cmp-sub">Married on @_marriage.Value.ToString("d MMM yyyy"). The Vimshottari periods then running (facts only; no source classifies them):</p>
                        <table class="cmp-table cmp-cardtable">
                            <thead><tr><th>Person</th><th>Mahadasha</th><th>Antardasha</th><th>Pratyantar</th></tr></thead>
                            <tbody>
                                @foreach (var (name, d) in new[] { (Groom!.Name, _marriageDashaGroom), (Bride!.Name, _marriageDashaBride) })
                                {
                                    <tr>
                                        <td data-label="Person">@name</td>
                                        <td data-label="Mahadasha">@(d?.Maha ?? "—")</td>
                                        <td data-label="Antardasha">@(d?.Antar ?? "—")</td>
                                        <td data-label="Pratyantar">@(d?.Pratyantar ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }

                <h3>Notes</h3>
                <div class="cmp-historyrow">
                    <label class="cmp-field cmp-grow"><span>Add a note about this pair</span>
                        <textarea rows="2" maxlength="1000" @bind="_newNote" @bind:event="oninput"></textarea>
                    </label>
                    <button type="button" class="cmp-swap" @onclick="AddNote" disabled="@(string.IsNullOrWhiteSpace(_newNote))">Add note</button>
                </div>
                @if (_notes.Count == 0)
                {
                    <p class="cmp-sub">No notes yet.</p>
                }
                else
                {
                    <ul class="cmp-notelist">
                        @foreach (var n in _notes)
                        {
                            var id = n.Id;
                            <li>
                                <span class="cmp-notedate">@n.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy")</span>
                                <span class="cmp-notetext">@n.NoteText</span>
                                <button type="button" class="cmp-navlink" @onclick="() => DeleteNote(id)" aria-label="Delete this note">Delete</button>
                            </li>
                        }
                    </ul>
                }

                <h3>Saved snapshots</h3>
                @if (_canSave)
                {
                    <div class="cmp-historyrow">
                        <button type="button" class="cmp-swap" @onclick="SaveReport">Save snapshot of this summary</button>
                    </div>
                }
                else
                {
                    <p class="cmp-sub">A snapshot can be saved only for a pair with a recorded relationship (spouse, parent, child, grandparent or sibling). Record the family under Saved people first.</p>
                }
                @if (_reports.Count > 0)
                {
                    <ul class="cmp-notelist">
                        @foreach (var r in _reports)
                        {
                            var id = r.Id;
                            <li>
                                <span class="cmp-notedate">@r.SavedAtUtc.ToLocalTime().ToString("d MMM yyyy")</span>
                                <span class="cmp-notetext">
                                    Rule set @r.RuleSetVersion@(r.KutaScore is null ? "" : $", Kuta {r.KutaScore:0.#} of {r.KutaMax:0.#}")
                                    <details class="cmp-detail cmp-inline"><summary>Show the saved text</summary><pre class="cmp-pre">@r.SummaryText</pre></details>
                                </span>
                                <button type="button" class="cmp-navlink" @onclick="() => DeleteReport(id)" aria-label="Delete this snapshot">Delete</button>
                            </li>
                        }
                    </ul>
                }
                <p class="cmp-copystatus" role="status" aria-live="polite">@_historyMsg</p>
            </div>
        </article>
        }

        <article class="cmp-card">
            <header class="cmp-card-head">
                <h2 id="cmp-data" tabindex="-1">What this reading is based on</h2>
                <p class="cmp-sub">What was available for each person, and what this page does not read yet.</p>
            </header>
            <details class="cmp-detail" open>
                <summary>Inputs and sources</summary>
            <div class="cmp-scroll">
                <table class="cmp-table">
                    <thead><tr><th>Input</th><th>@Groom!.Name</th><th>@Bride!.Name</th></tr></thead>
                    <tbody>
                        <tr><th scope="row">Moon sign, nakshatra and pada (Kuta)</th><td data-label="@Groom!.Name">@Have(true)</td><td data-label="@Bride!.Name">@Have(true)</td></tr>
                        <tr><th scope="row">D1 positions for the dosha balance</th><td data-label="@Groom!.Name">@Have(_dataGroom.Dosha)</td><td data-label="@Bride!.Name">@Have(_dataBride.Dosha)</td></tr>
                        <tr><th scope="row">D1 and D9 positions for the Navamsa comparison</th><td data-label="@Groom!.Name">@Have(_dataGroom.D9)</td><td data-label="@Bride!.Name">@Have(_dataBride.D9)</td></tr>
                        <tr><th scope="row">Saturn transit periods</th><td data-label="@Groom!.Name">@Have(_dataGroom.Saturn)</td><td data-label="@Bride!.Name">@Have(_dataBride.Saturn)</td></tr>
                        <tr><th scope="row">Vimshottari periods</th><td data-label="@Groom!.Name">@Have(_dataGroom.Dasha)</td><td data-label="@Bride!.Name">@Have(_dataBride.Dasha)</td></tr>
                        <tr><th scope="row">Birth-time confidence</th><td colspan="2">Not recorded in the saved details, so every reading assumes the entered time is exact.</td></tr>
                        <tr><th scope="row">Not read by this page yet</th><td colspan="2">Upapada Lagna, cross-chart synastry, Vedha, and any good-or-bad verdict on dasha periods.</td></tr>
                        <tr><th scope="row">Rules and sources</th><td colspan="2">Vasudev, <em>The Art of Matching Charts</em>, Ch. V and VI; Yoni pair values and the weight of Rajju, Stree Deergha and Mahendra from PyJHora's South Indian scheme. Rule gaps are listed in the notes below.</td></tr>
                    </tbody>
                </table>
            </div>
            </details>
        </article>

        <ul class="cmp-notes" id="cmp-notes" tabindex="-1">
            @if (MarriageApplies && _result.SameSignLord)
            {
                <li>Both Moon signs share a ruler. The book says the absence of Rajju, Vedha, Gana and Rasi Kutas then need not be considered (p.77–78).</li>
            }
            @if (MarriageApplies)
            {
            <li>Yoni for different animals uses PyJHora's pair values (the book gives only the same-animal 4, a hostile 0 and "2 to 3" for passable pairs, with no pair table). Vedha, the tenth factor, is not computed: no pair table is available from a cited source. Rajju, Stree Deergha and Mahendra score 1 per pass by PyJHora's South Indian weight and are kept outside the 36 (p.66, p.77).</li>
            <li>Kuta agreement is not decisive. The book places it after longevity, health, balance of doshas and Kuja dosha have been cleared (p.79). The dosha reading above is the book's Chapter V; it states its results are not absolute (p.54).</li>
            }
        </ul>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    /// <summary>Optional partner to open the pair directly: /compatibility/5?with=6.</summary>
    [SupplyParameterFromQuery(Name = "with")] public int? With { get; set; }

    /// <summary>Print mode (PrintReport.razor, Saved Charts' Print picker): the comparison with this
    /// partner as a static report: no controls, jump nav or history form, every tab laid out in turn,
    /// every detail opened.</summary>
    [Parameter] public int? PrintPartner { get; set; }
    private bool PrintMode => PrintPartner is not null;
    private bool _detailsOpened;

    private BirthDetails? _person;
    private IReadOnlyList<BirthDetails> _others = [];
    private MatchPersonSnapshot? _me;
    private MatchPersonSnapshot? _partner;
    private bool _meIsGroom = true;
    private AshtakootaResult? _result;
    private string? _notice;
    private int _partnerId;

    private int PartnerId
    {
        get => _partnerId;
        set => _partnerId = value;
    }

    private MatchPersonSnapshot? Groom => _meIsGroom ? _me : _partner;
    private MatchPersonSnapshot? Bride => _meIsGroom ? _partner : _me;

    protected override void OnParametersSet()
    {
        _person = BirthDetailsRepo.GetById(Id);
        if (_person is null)
        {
            Active.Clear();
            return;
        }

        if (!PrintMode)
        {
            Active.Set(Id, _person.Name,
                $"{_person.DateOfBirth:dd MMM yyyy} · {_person.TimeOfBirth:HH\\:mm} · {_person.PlaceCity}, {_person.PlaceCountry}");
            Active.SetHeaderExtra(null);
        }

        if (PrintPartner is int printPartner) _partnerId = printPartner;
        else if (With is int requested && requested != Id) _partnerId = requested;
        if (_partnerId == Id) _partnerId = 0;
        _others = BirthDetailsRepo.GetAll().Where(p => p.Id != Id).OrderBy(p => p.Name).ToList();
        _me = MatchPersonRepo.GetByBirthDetailId(Id);
        _meIsGroom = !string.Equals(_person.Sex, "Female", StringComparison.OrdinalIgnoreCase);
        Recompute();
    }

    private void Recompute()
    {
        _result = null;
        _notice = null;
        _partner = null;
        _showMarriage = false;
        if (_person is null) return;

        if (_me is null)
        {
            _notice = $"{_person.Name} has no stored Moon position yet, so Kuta agreement cannot be read. Generate the chart first.";
            return;
        }
        if (_partnerId == 0)
        {
            _notice = "Choose a saved person to compare with.";
            return;
        }

        _partner = MatchPersonRepo.GetByBirthDetailId(_partnerId);
        if (_partner is null)
        {
            _notice = "The chosen person has no stored Moon position yet, so Kuta agreement cannot be read.";
            return;
        }

        // Left is the man and right the woman when the pair is one of each; otherwise the elder is on the left.
        var mine = _person.Sex?.ToLowerInvariant();
        var theirs = _partner.Sex?.ToLowerInvariant();
        if (mine is "male" or "female" && theirs is "male" or "female" && mine != theirs)
            _meIsGroom = mine == "male";
        else
        {
            var other = _others.FirstOrDefault(o => o.Id == _partnerId);
            _meIsGroom = other is null || _person.DateOfBirth <= other.DateOfBirth;
            _notice = $"The two are not recorded as one man and one woman, so the elder ({(_meIsGroom ? _person.Name : other!.Name)}) is placed on the left.";
        }

        _result = AshtakootaCalculator.Score(Groom!.Person, Bride!.Person);
        ComputeDetails();
    }

    private const int DashaYears = 25;
    private DashaPairReading? _dasha;
    private DashaPerson? _dashaGroom;
    private DashaPerson? _dashaBride;
    private DateTime _tlStart;
    private DateTime _tlEnd;

    // The dasha cards read the stored Vimshottari periods; they are skipped when either person has none.
    private void ComputeDasha()
    {
        _dasha = null;
        _dashaGroom = _dashaBride = null;
        if (Groom is null || Bride is null) return;

        _tlStart = DateTime.Today;
        _tlEnd = _tlStart.AddYears(DashaYears);
        var groom = DashaRepo.Get(Groom.BirthDetailId, Groom.Name, _tlStart, _tlEnd);
        var bride = DashaRepo.Get(Bride.BirthDetailId, Bride.Name, _tlStart, _tlEnd);
        _dataGroom = _dataGroom with { Dasha = groom is not null };
        _dataBride = _dataBride with { Dasha = bride is not null };
        if (groom is null || bride is null) return;
        _dashaGroom = groom;
        _dashaBride = bride;
        _dasha = DashaCompatibility.Compare(groom, bride, _tlStart, _tlEnd);
        _timeline = PairDashaTimeline.Build(groom, bride, _tlStart, _tlEnd);
    }

    private static string LevelName(int level) => level switch { 1 => "Mahadasha", 2 => "Antardasha", _ => "Pratyantar" };

    private static string Regard(DashaAttitude a) =>
        a.From == a.To ? $"both lords are {a.From}"
        : $"{a.From} regards {a.To} {(a.Attitude is null ? "— (not in the table)" : a.Attitude.ToLowerInvariant())}";

    private static string RunningText(DashaSpan? s) =>
        s is null ? "—" : $"{s.Lord}, to {s.End:d MMM yyyy}";

    private IEnumerable<(string Person, DashaLordFacts F)> LordFactRows() =>
        _dasha!.FirstFacts.Select(f => (Groom!.Name, f)).Concat(_dasha.SecondFacts.Select(f => (Bride!.Name, f)));

    private static string AlsoText(DashaLordFacts f)
    {
        var parts = new List<string>();
        if (f.IsDarakaraka) parts.Add("Darakaraka");
        if (f.IsVenusOrJupiter) parts.Add("natural marriage significator");
        return parts.Count == 0 ? "—" : string.Join("; ", parts);
    }

    private static string MeterPercent(int points) => Pct(points * 100.0 / AshtakootaResult.MaxTotal);

    private static string Pct(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private double TimelinePercent(DateTime d) =>
        Math.Clamp((d - _tlStart).TotalDays / (_tlEnd - _tlStart).TotalDays * 100, 0, 100);

    private IEnumerable<int> AxisYears() => Enumerable.Range(_tlStart.Year + 1, DashaYears).Where(y => y % 5 == 0);

    private string AxisPercent(int year) => Pct(TimelinePercent(new DateTime(year, 1, 1)));

    private RenderFragment TimelineLane(string name, DashaPerson p) => @<div class="cmp-lane">
        <span class="cmp-lane-name">@name</span>
        @foreach (var level in new[] { 1, 2 })
        {
            <div class="cmp-track">
                @foreach (var s in p.Upcoming.Where(u => u.Level == level))
                {
                    var from = TimelinePercent(s.Start);
                    var to = TimelinePercent(s.End);
                    <span class="cmp-seg cmp-seg-@level" style="left:@Pct(from)%;width:@Pct(to - from)%"
                          title="@s.Lord @LevelName(level), @s.Start.ToString("MMM yyyy") to @s.End.ToString("MMM yyyy")">@(to - from >= (level == 1 ? 3.5 : 4.5) ? s.Lord : "")</span>
                }
            </div>
        }
    </div>;

    private DoshaReading? _doshaGroom;
    private DoshaReading? _doshaBride;
    private DoshaBalance? _balance;
    private SaturnComparison? _saturn;

    // Dosha Samya and the Saturn periods read stored D1 positions and the stored Saturn transit table;
    // either is skipped (its card does not render) when a person lacks the stored data.
    private void ComputeDetails()
    {
        _doshaGroom = _doshaBride = null;
        _d9Groom = _d9Bride = null;
        _synastry = null;
        _shared = null;
        _timeline = null;
        _matchup = null;
        _chartGroom = _chartBride = null;
        _dataGroom = _dataBride = new(false, false, false, false);
        _balance = null;
        _saturn = null;
        _familyNote = null;
        _findings = [];
        _karakaGroom = _karakaBride = [];
        _gridsGroom = _gridsBride = [];
        _marriageGroom = _marriageBride = null;
        if (Groom is null || Bride is null) return;

        _familyNote = FamilyNote(Groom, Bride);
        ComputeRelation();
        ComputeDasha();
        LoadHistory();

        var groomChart = DoshaRepo.GetByBirthDetailId(Groom.BirthDetailId);
        var brideChart = DoshaRepo.GetByBirthDetailId(Bride.BirthDetailId);
        _chartGroom = groomChart;
        _chartBride = brideChart;
        _dataGroom = _dataGroom with { Dosha = groomChart is not null };
        _dataBride = _dataBride with { Dosha = brideChart is not null };
        if (groomChart is not null && brideChart is not null)
        {
            _doshaGroom = DoshaSamyaCalculator.Read(groomChart);
            _doshaBride = DoshaSamyaCalculator.Read(brideChart);
            _balance = DoshaSamyaCalculator.Balance(_doshaGroom, _doshaBride);
            _matchup = DoshaMatchup.Build(_doshaGroom, _doshaBride);
            _dignityGroom = DoshaRepo.GetDignities(Groom.BirthDetailId);
            _dignityBride = DoshaRepo.GetDignities(Bride.BirthDetailId);
        }

        var groomSaturn = SadeSatiRepo.GetByBirthDetailId(Groom.BirthDetailId);
        var brideSaturn = SadeSatiRepo.GetByBirthDetailId(Bride.BirthDetailId);
        var groomD9 = NavamsaRepo.GetByBirthDetailId(Groom.BirthDetailId);
        var brideD9 = NavamsaRepo.GetByBirthDetailId(Bride.BirthDetailId);
        _dataGroom = _dataGroom with { D9 = groomD9 is not null };
        _dataBride = _dataBride with { D9 = brideD9 is not null };
        if (groomD9 is not null && brideD9 is not null)
        {
            _d9Groom = NavamsaCompatibility.Read(groomD9);
            _d9Bride = NavamsaCompatibility.Read(brideD9);
        }

        _dataGroom = _dataGroom with { Saturn = groomSaturn.Count > 0 };
        _dataBride = _dataBride with { Saturn = brideSaturn.Count > 0 };
        if (groomSaturn.Count > 0 && brideSaturn.Count > 0)
            _saturn = SadeSatiCompatibility.Compare(groomSaturn, brideSaturn, DateTime.UtcNow);
        if (groomChart is not null && brideChart is not null)
        {
            _synastry = SynastryCalculator.Read(groomChart, brideChart);
            _shared = ChartSimilarity.Compare(
                new SimilarityInput(groomChart, Groom.Person, Groom.Pada, groomD9),
                new SimilarityInput(brideChart, Bride.Person, Bride.Pada, brideD9),
                Groom.Name, Bride.Name);
        }
        _gridsGroom = ReadGrids(Groom.BirthDetailId);
        _gridsBride = ReadGrids(Bride.BirthDetailId);
        _karakaGroom = ReadKarakas(Groom.BirthDetailId);
        _karakaBride = ReadKarakas(Bride.BirthDetailId);
        _marriageGroom = MarriageReader.Read(Groom.BirthDetailId);
        _marriageBride = MarriageReader.Read(Bride.BirthDetailId);
        _findings = BuildFindings();
    }

    private string? _familyNote;

    private DashaTimelineReading? _timeline;
    private IReadOnlyList<DoshaMatchupRow>? _matchup;
    private IReadOnlyDictionary<PlanetName, string?> _dignityGroom = new Dictionary<PlanetName, string?>();
    private IReadOnlyDictionary<PlanetName, string?> _dignityBride = new Dictionary<PlanetName, string?>();

    private static string DignityText(IReadOnlyDictionary<PlanetName, string?> d, PlanetName planet) =>
        d.TryGetValue(planet, out var v) && !string.IsNullOrWhiteSpace(v) ? v : "None recorded";

    private RenderFragment ChangesTable(IEnumerable<DashaChange> rows) => @<table class="cmp-table">
        <thead><tr><th>Date</th><th>Whose period</th><th>Level</th><th>Change</th><th>New lord rules</th><th>New lord sits in</th></tr></thead>
        <tbody>
            @foreach (var c in rows)
            {
                <tr>
                    <th scope="row">@c.Date.ToString("d MMM yyyy")</th>
                    <td data-label="Whose period">@c.Person</td>
                    <td data-label="Level">@LevelName(c.Level)</td>
                    <td data-label="Change" class="cmp-score">@c.FromLord to @c.ToLord</td>
                    <td data-label="Rules">@(c.Rules.Count == 0 ? "no sign" : string.Join(", ", c.Rules.Select(Ordinal)))</td>
                    <td data-label="Sits in">@(c.PlacedIn is int h ? Ordinal(h) : "—")</td>
                </tr>
            }
        </tbody>
    </table>;

    // The summary as plain text, with the date and rule set it was made under, for pasting into notes or a message.
    private string SummaryText()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Compatibility: {Groom!.Name} ({GroomLabel}) and {Bride!.Name} ({BrideLabel})");
        sb.AppendLine($"Made {DateTime.Today:d MMM yyyy} under rule set {CompatibilityRuleSet.Version}");
        if (_familyNote is not null) sb.AppendLine(_familyNote);
        foreach (var kind in new[] { FindingKind.Good, FindingKind.Concern, FindingKind.Open })
        {
            sb.AppendLine();
            sb.AppendLine(kind switch { FindingKind.Good => "Favourable:", FindingKind.Concern => "Concern:", _ => "Unresolved:" });
            var items = _findings.Where(f => f.Kind == kind).ToList();
            if (items.Count == 0) sb.AppendLine("  none");
            foreach (var f in items) sb.AppendLine($"  - {f.Text}");
        }
        sb.AppendLine();
        sb.AppendLine("No single score decides compatibility; the results are read separately and never combined.");
        sb.AppendLine($"Sources: {CompatibilityRuleSet.Sources}");
        return sb.ToString();
    }

    private DateTime? _marriage;
    private string _marriageInput = "";
    private DashaOnDate? _marriageDashaGroom;
    private DashaOnDate? _marriageDashaBride;
    private IReadOnlyList<PairNote> _notes = [];
    private IReadOnlyList<SavedPairReport> _reports = [];
    private string _newNote = "";
    private string _historyMsg = "";
    private bool _canSave;

    private void LoadHistory()
    {
        _newNote = "";
        _historyMsg = "";
        _marriage = null;
        _marriageInput = "";
        _marriageDashaGroom = _marriageDashaBride = null;
        _canSave = HistoryRepo.HasRecordedRelationship(Groom!.BirthDetailId, Bride!.BirthDetailId);
        _notes = HistoryRepo.GetNotes(Groom.BirthDetailId, Bride.BirthDetailId);
        _reports = HistoryRepo.GetReports(Groom.BirthDetailId, Bride.BirthDetailId);
        if (_kind != FamilyKind.Spouse) return;
        _marriage = HistoryRepo.GetMarriageDate(Groom.BirthDetailId, Bride.BirthDetailId);
        if (_marriage is null) return;
        _marriageInput = _marriage.Value.ToString("yyyy-MM-dd");
        _marriageDashaGroom = HistoryRepo.DashaOn(Groom.BirthDetailId, _marriage.Value);
        _marriageDashaBride = HistoryRepo.DashaOn(Bride.BirthDetailId, _marriage.Value);
    }

    private void SaveMarriage()
    {
        if (!DateTime.TryParse(_marriageInput, out var date)) { _historyMsg = "Enter the marriage date first."; return; }
        HistoryRepo.SetMarriageDate(Groom!.BirthDetailId, Bride!.BirthDetailId, date);
        LoadHistory();
        _historyMsg = "Marriage date saved.";
    }

    private void ClearMarriage()
    {
        HistoryRepo.ClearMarriageDate(Groom!.BirthDetailId, Bride!.BirthDetailId);
        LoadHistory();
        _historyMsg = "Marriage date cleared.";
    }

    private void AddNote()
    {
        HistoryRepo.AddNote(Groom!.BirthDetailId, Bride!.BirthDetailId, _newNote);
        LoadHistory();
        _historyMsg = "Note added.";
    }

    private void DeleteNote(int id)
    {
        HistoryRepo.DeleteNote(Groom!.BirthDetailId, Bride!.BirthDetailId, id);
        LoadHistory();
        _historyMsg = "Note deleted.";
    }

    private void SaveReport()
    {
        var saved = HistoryRepo.SaveReport(Groom!.BirthDetailId, Bride!.BirthDetailId, CompatibilityRuleSet.Version,
            MarriageApplies && _result is not null ? (decimal)_result.TotalMin : null,
            MarriageApplies && _result is not null ? (decimal)AshtakootaResult.MaxTotal : null,
            SummaryText());
        LoadHistory();
        _historyMsg = saved ? "Snapshot saved." : "Nothing saved: this pair has no recorded relationship.";
    }

    private void DeleteReport(int id)
    {
        HistoryRepo.DeleteReport(Groom!.BirthDetailId, Bride!.BirthDetailId, id);
        LoadHistory();
        _historyMsg = "Snapshot deleted.";
    }


    private FamilyMember? _link;
    private FamilyMember? _reverseLink;
    private FamilyKind? _kind;
    private bool _showMarriage;
    private DoshaChart? _chartGroom;
    private DoshaChart? _chartBride;
    private SynastryCalculator.Reading? _synastry;
    private IReadOnlyList<SharedFact>? _shared;

    // The marriage factors (Kuta, doshas, the D9 7th-house facts) apply to a spouse or to a pair with no
    // recorded relationship (a prospective match); for a recorded parent, child, grandparent or sibling
    // they are hidden unless asked for.
    private bool MarriageApplies => _kind is null or FamilyKind.Spouse || _showMarriage;

    private FamilyKind KindOfBrideFromGroom => _kind ?? FamilyKind.Spouse;
    private FamilyKind KeyKindInGroomChart => KindOfBrideFromGroom;
    private FamilyKind KeyKindInBrideChart => FamilyRelation.Invert(KindOfBrideFromGroom);

    // The role as the stored view names it from the other person (it keeps the paternal or maternal side of a grandparent),
    // else the turned-around kind labelled by sex.
    private string GroomLabel => _kind is null or FamilyKind.Spouse ? "Groom" : _reverseLink?.Role ?? FamilyRelation.Label(FamilyRelation.Invert(_kind.Value), Groom?.Sex);
    private string BrideLabel => _kind is null or FamilyKind.Spouse ? "Bride" : _link!.Role;

    private void ComputeRelation()
    {
