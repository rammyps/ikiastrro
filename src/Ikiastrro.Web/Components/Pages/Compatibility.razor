    private sealed record KarakaRow(string Code, string Role, string Planet, string D1Sign, int? House, string? Dignity, string? D9Sign);

    private static readonly (string Code, string Role)[] KarakaRoles =
    [
        ("AK", "Atmakaraka (self)"), ("AmK", "Amatyakaraka (career)"), ("BK", "Bhratrukaraka (siblings)"),
        ("MK", "Matrukaraka (mother)"), ("PiK", "Pitrukaraka (father)"), ("PK", "Putrakaraka (children)"),
        ("GK", "Gnatikaraka (relatives)"), ("DK", "Darakaraka (spouse)"),
    ];

    // One stored chart as SindUniDtlGrid draws it: Lagna, Moon and each graha's sign, dignity,
    // retrograde and combust flags, exactly as the chart pipeline stored them.
    private sealed record GridChart(string Type, string Title, string Ascendant, string? Moon,
        IReadOnlyDictionary<string, IReadOnlyList<GridPlanetGlyph>> Planets);

    private IReadOnlyList<GridChart> _gridsGroom = [];
    private IReadOnlyList<GridChart> _gridsBride = [];

    private IReadOnlyList<GridChart> ReadGrids(int birthDetailId)
    {
        var charts = ChartResultsRepo.GetByBirthDetailId(birthDetailId);
        var list = new List<GridChart>();
        foreach (var (type, title) in new[] { ("D1", "D1 · Rasi"), ("D9", "D9 · Navamsa") })
        {
            var header = charts.FirstOrDefault(c => c.ChartType == type);
            if (header is null) continue;
            var rows = KeyDetailsRepo.GetByChartResultId(header.Id).Where(k => k.PointKind == "Graha").ToList();
            var asc = rows.FirstOrDefault(k => k.Planet == "Ascendant")?.Sign;
            if (asc is null) continue;
            var planets = rows.Where(k => k.Planet != "Ascendant").GroupBy(k => k.Sign)
                .ToDictionary(g => g.Key, g => (IReadOnlyList<GridPlanetGlyph>)g.Select(k => new GridPlanetGlyph(
                    k.Planet, Ikiastrro.Core.Presentation.ChartViewModel.DignityToken(k.DignityStatus),
                    k.IsRetrograde ?? false, k.IsCombust ?? false)).ToList());
            list.Add(new GridChart(type, title, asc, rows.FirstOrDefault(k => k.Planet == "Moon")?.Sign, planets));
        }
        return list;
    }

    private IReadOnlyList<KarakaRow> _karakaGroom = [];
    private IReadOnlyList<KarakaRow> _karakaBride = [];
    private MarriageMatters? _marriageGroom;
    private MarriageMatters? _marriageBride;

    // Chara karakas as the chart pipeline stored them on the D1 grahas, with each one's D9 sign.
    private IReadOnlyList<KarakaRow> ReadKarakas(int birthDetailId)
    {
        var charts = ChartResultsRepo.GetByBirthDetailId(birthDetailId);
        var d1 = charts.FirstOrDefault(c => c.ChartType == "D1");
        if (d1 is null) return [];
        var d1Rows = KeyDetailsRepo.GetByChartResultId(d1.Id).Where(k => k.PointKind == "Graha").ToList();
        var d9Id = charts.FirstOrDefault(c => c.ChartType == "D9")?.Id;
        var d9Rows = d9Id is int id ? KeyDetailsRepo.GetByChartResultId(id) : [];
        var rows = new List<KarakaRow>();
        foreach (var (code, role) in KarakaRoles)
        {
            var g = d1Rows.FirstOrDefault(k => string.Equals(k.CharaKaraka, code, StringComparison.OrdinalIgnoreCase));
            if (g is null) continue;
            rows.Add(new KarakaRow(code, role, g.Planet, SignLabels.For(Enum.Parse<ZodiacName>(g.Sign)),
                g.HouseNumberFromLagna is { } h ? h : null, g.DignityStatus,
                d9Rows.FirstOrDefault(k => k.Planet == g.Planet) is { } n ? SignLabels.For(Enum.Parse<ZodiacName>(n.Sign)) : null));
        }
        return rows;
    }

