    private IEnumerable<(string Point, string GroomInBride, string BrideInGroom)> OverlayRows()
    {
        var s = _synastry!;
        // Groom's points lie in the bride's chart, where the groom is the other: key houses are those of the groom's kind to the bride.
        var inBride = FamilyRelation.KeyHouses(KeyKindInBrideChart);
        var inGroom = FamilyRelation.KeyHouses(KeyKindInGroomChart);
        string Cell(ZodiacName sign, int house, IReadOnlyList<int> keys) =>
            $"{SignLabels.For(sign)}, {Ordinal(house)} house" + (keys.Contains(house) ? " · key house" : "");

        yield return ("Lagna", Cell(s.FirstInSecond.LagnaSign, s.FirstInSecond.LagnaHouseInOther, inBride),
                               Cell(s.SecondInFirst.LagnaSign, s.SecondInFirst.LagnaHouseInOther, inGroom));
        for (var i = 0; i < s.FirstInSecond.Planets.Count; i++)
        {
            var a = s.FirstInSecond.Planets[i];
            var b = s.SecondInFirst.Planets[i];
            yield return (a.Malefic ? $"{a.Planet} (malefic)" : a.Planet.ToString(),
                          Cell(a.Sign, a.HouseInOther, inBride), Cell(b.Sign, b.HouseInOther, inGroom));
        }
    }

