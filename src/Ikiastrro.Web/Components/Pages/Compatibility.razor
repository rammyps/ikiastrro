@page "/compatibility/{Id:int}"
@using Ikiastrro.Core.Engines.Matching
@using Ikiastrro.Core.Models
@inject BirthDetailsRepository BirthDetailsRepo
@inject MatchPersonRepository MatchPersonRepo
@inject DoshaChartRepository DoshaRepo
@inject SadeSatiRepository SadeSatiRepo
@inject FamilyRepository FamilyRepo
@inject DashaCompatibilityRepository DashaRepo
@inject ActivePerson Active

@* Compatibility tab — Kuta agreement for the opened person and one chosen partner, computed live by
   Core's AshtakootaCalculator from each person's stored D1 Moon (MatchPersonRepository). Nothing is
   persisted: a pair result is a pure function of the two people and the rules, so there is no pair
   table to go stale (docs/architecture/compatibility_similarity.md). Rules and their gaps are the
   Vasudev book's (SRC_VASUDEV_MATCHING_CHARTS, Ch. VI); a factor the book gives no rule for is shown as
   "not scored", never guessed. *@

<PageTitle>@(_person?.Name ?? "Compatibility") &middot; Compatibility</PageTitle>

@if (_person is null)
{
    <section class="cmp-unavailable" role="status">
        <h1 class="cmp-heading">COMPATIBILITY</h1>
        <p>No saved person found.</p>
        <a href="/">Choose a saved person</a>
    </section>
}
else
{
    <h1 class="cmp-heading">COMPATIBILITY</h1>

    <section class="cmp-controls" aria-label="Choose the partner">
        <label class="cmp-field">
            <span>Compare @_person.Name with</span>
            <select @bind="PartnerId" @bind:after="Recompute">
                <option value="0">Choose a saved person…</option>
                @foreach (var other in _others)
                {
                    <option value="@other.Id">@other.Name</option>
                }
            </select>
        </label>
        @if (_partner is not null)
        {
            <span class="cmp-roles">
                <b>@Groom!.Name</b> is the groom · <b>@Bride!.Name</b> is the bride
                <button type="button" class="cmp-swap" @onclick="Swap">Swap roles</button>
            </span>
        }
    </section>

    @if (_notice is not null)
    {
        <p class="cmp-note" role="status">@_notice</p>
    }

    @if (_result is not null)
    {
        @if (_familyNote is not null)
        {
            <p class="cmp-family">@_familyNote</p>
        }

        <section class="cmp-glance" aria-label="Pair at a glance">
            <p class="cmp-kicker">Pair at a glance</p>
            <h2 class="cmp-glance-title">@Groom!.Name &amp; @Bride!.Name</h2>
            <dl class="cmp-tiles">
                <div>
                    <dt>Kuta agreement</dt>
                    <dd class="cmp-t-@VerdictClass">@TotalText / @AshtakootaResult.MaxTotal</dd>
                </div>
                @if (_balance is not null)
                {
                    <div>
                        <dt>Mars &amp; malefics</dt>
                        <dd class="cmp-t-@BalanceClass">@BalanceText</dd>
                    </div>
                }
                @if (_saturn is not null)
                {
                    <div>
                        <dt>Sade Sati overlap</dt>
                        <dd class="cmp-t-@(_saturn.SadeSatiOverlaps ? "open" : "pass")">@(_saturn.SadeSatiOverlaps ? "Within 30 years" : "None in 30 years")</dd>
                    </div>
                }
                @if (_dashaGroom is not null && _dashaBride is not null)
                {
                    <div>
                        <dt>Running Mahadasha</dt>
                        <dd>@(_dashaGroom.Running.FirstOrDefault(s => s.Level == 1)?.Lord ?? "—") · @(_dashaBride.Running.FirstOrDefault(s => s.Level == 1)?.Lord ?? "—")</dd>
                    </div>
                }
            </dl>
            <div class="cmp-meter" role="meter" aria-label="Kuta agreement out of @AshtakootaResult.MaxTotal" aria-valuemin="0" aria-valuemax="@AshtakootaResult.MaxTotal" aria-valuenow="@_result.TotalMin">
                <span class="cmp-meter-min" style="width:@MeterPercent(_result.TotalMin)%"></span>
                <span class="cmp-meter-range" style="left:@MeterPercent(_result.TotalMin)%;width:@MeterPercent(_result.TotalMax - _result.TotalMin)%"></span>
                <i class="cmp-meter-pass" style="left:@MeterPercent(AshtakootaResult.PassMark)%" title="Pass mark @AshtakootaResult.PassMark"></i>
            </div>
            <small>Bar shows the score out of @AshtakootaResult.MaxTotal; the line marks the book's pass mark of @AshtakootaResult.PassMark@(_result.IsComplete ? "" : "; the lighter part is the range left open by the unscored Yoni").</small>
        </section>

        <article class="cmp-card">
            <header class="cmp-card-head">
                <h2>Kuta agreement</h2>
                <p class="cmp-total">
                    <strong>@TotalText</strong><span> of @AshtakootaResult.MaxTotal</span>
                    <em class="cmp-verdict cmp-verdict-@VerdictClass">@VerdictText</em>
                </p>
            </header>

            <div class="cmp-people">
                @PersonCard("Groom", Groom!)
                @PersonCard("Bride", Bride!)
            </div>

            <div class="cmp-scroll">
                <table class="cmp-table">
                    <thead><tr><th>Kuta</th><th>Score</th><th>Reading</th><th>Source</th></tr></thead>
                    <tbody>
                        @foreach (var k in _result.Scored)
                        {
                            <tr>
                                <th scope="row">@k.Name</th>
                                <td class="cmp-score cmp-@StatusClass(k)">@(k.Score?.ToString() ?? "—") / @k.MaxScore</td>
                                <td>@k.Reason</td>
                                <td class="cmp-src">@k.SourceLocator</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>

        <article class="cmp-card">
            <header class="cmp-card-head">
                <h2>Also tested, not scored</h2>
                <p class="cmp-sub">The book gives these no numeric value.</p>
            </header>
            <div class="cmp-scroll">
                <table class="cmp-table">
                    <thead><tr><th>Factor</th><th>Result</th><th>Reading</th><th>Source</th></tr></thead>
                    <tbody>
                        @foreach (var k in _result.Additional)
                        {
                            <tr>
                                <th scope="row">@k.Name</th>
                                <td class="cmp-score cmp-@StatusClass(k)">@(k.Status == KutaStatus.Present ? "Present" : "Absent")</td>
                                <td>@k.Reason</td>
                                <td class="cmp-src">@k.SourceLocator</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>

        @if (_doshaGroom is not null && _doshaBride is not null && _balance is not null)
        {
            <article class="cmp-card">
                <header class="cmp-card-head">
                    <h2>Mars and the malefics (Dosha Samya)</h2>
                    <p class="cmp-total"><em class="cmp-verdict cmp-verdict-@BalanceClass">@BalanceText</em></p>
                </header>
                <div class="cmp-people">
                    @MarsCard("Groom", Groom!.Name, _doshaGroom)
                    @MarsCard("Bride", Bride!.Name, _doshaBride)
                </div>
                <p class="cmp-pad">@_balance.Reason <span class="cmp-src">@_balance.SourceLocator</span></p>
                <div class="cmp-scroll">
                    <table class="cmp-table">
                        <thead><tr><th>Person</th><th>Malefic</th><th>From</th><th>House</th><th>Weight</th><th>Reading</th></tr></thead>
                        <tbody>
                            @foreach (var row in AfflictionRows())
                            {
                                <tr>
                                    <th scope="row">@row.Person</th>
                                    <td>@row.A.Malefic</td>
                                    <td>@row.A.From</td>
                                    <td class="cmp-score">@Ordinal(row.A.House)</td>
                                    <td class="cmp-score cmp-w-@row.A.Weight.ToString().ToLowerInvariant()">@row.A.Weight</td>
                                    <td>@row.A.Note</td>
                                </tr>
                            }
                            @if (!AfflictionRows().Any())
                            {
                                <tr><td colspan="6">Neither chart has Sun, Mars, Saturn, Rahu or Ketu in the 2nd, 4th, 7th, 8th or 12th (or Mars or Saturn in the 1st) from the Lagna, Moon or Venus.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </article>
        }

        @if (_saturn is not null)
        {
            <article class="cmp-card">
                <header class="cmp-card-head">
                    <h2>Saturn from the Moon (Sade Sati)</h2>
                    <p class="cmp-total"><em class="cmp-verdict cmp-verdict-@(_saturn.SadeSatiOverlaps ? "open" : "pass")">@(_saturn.SadeSatiOverlaps ? "Sade Sati overlaps in the next 30 years" : "Sade Sati does not overlap in the next 30 years")</em></p>
                </header>
                <div class="cmp-scroll">
                    <table class="cmp-table">
                        <thead><tr><th>Period</th><th>@Groom!.Name (Moon in @SignLabels.For(Groom.Person.MoonSign))</th><th>@Bride!.Name (Moon in @SignLabels.For(Bride.Person.MoonSign))</th><th>Both at once</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < _saturn.First.Count; i++)
                            {
                                var category = _saturn.First[i].Category;
                                <tr>
                                    <th scope="row">@category</th>
                                    <td>@Standing(_saturn.First[i])</td>
                                    <td>@Standing(_saturn.Second[i])</td>
                                    <td class="cmp-score">@Overlaps(category)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="cmp-pad cmp-sub">Saturn over the 12th, 1st and 2nd signs from the Moon is Sade Sati (Rising, Peak, Setting); over the 4th and 8th it is Kantaka and Ashtama Shani. The periods come from the stored Saturn transit table; neither the book nor the stored rules give a verdict on two people's periods coinciding, so only the dates are shown.</p>
            </article>
        }

        @if (_dasha is not null && _dashaGroom is not null && _dashaBride is not null)
        {
            <article class="cmp-card">
                <header class="cmp-card-head">
                    <h2>Dasha picture</h2>
                    <p class="cmp-sub">Vimshottari, from the stored periods. Facts only: no verdict is given on whether a period supports or strains a marriage.</p>
                </header>

                <div class="cmp-scroll">
                    <table class="cmp-table">
                        <thead><tr><th>Dasha</th><th>@Groom!.Name</th><th>@Bride!.Name</th><th>How each lord regards the other</th></tr></thead>
                        <tbody>
                            <tr>
                                <th scope="row">Birth dasha (Moon's nakshatra lord)</th>
                                <td class="cmp-score">@_dashaGroom.BirthLord</td>
                                <td class="cmp-score">@_dashaBride.BirthLord</td>
                                <td>@Regard(_dasha.BirthLordFirstToSecond) · @Regard(_dasha.BirthLordSecondToFirst)</td>
                            </tr>
                            @foreach (var level in new[] { 1, 2, 3 })
                            {
                                var g = _dashaGroom.Running.FirstOrDefault(s => s.Level == level);
                                var b = _dashaBride.Running.FirstOrDefault(s => s.Level == level);
                                <tr>
                                    <th scope="row">@LevelName(level)</th>
                                    <td>@RunningText(g)</td>
                                    <td>@RunningText(b)</td>
                                    <td>
                                        @if (level == 1 && _dasha.MahaFirstToSecond is not null && _dasha.MahaSecondToFirst is not null)
                                        {
                                            @($"{Regard(_dasha.MahaFirstToSecond)} · {Regard(_dasha.MahaSecondToFirst)}")
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="cmp-pad cmp-sub">Regard is permanent (natural) friendship from the stored table, which is not defined for Rahu and Ketu.</p>

                @if (_dasha.SandhiNotes.Count > 0)
                {
                    <ul class="cmp-notes">
                        @foreach (var note in _dasha.SandhiNotes)
                        {
                            <li>@note (The width of this junction window is a display choice; no source is cited for it.)</li>
                        }
                    </ul>
                }
            </article>

            <article class="cmp-card">
                <header class="cmp-card-head">
                    <h2>Running lords in their own charts</h2>
                    <p class="cmp-sub">Houses counted from each person's own Lagna.</p>
                </header>
                <div class="cmp-scroll">
                    <table class="cmp-table">
                        <thead><tr><th>Person</th><th>Period</th><th>Lord</th><th>Rules</th><th>Sits in</th><th>Also</th><th>Ends</th></tr></thead>
                        <tbody>
                            @foreach (var row in LordFactRows())
                            {
                                <tr>
                                    <th scope="row">@row.Person</th>
                                    <td>@LevelName(row.F.Level)</td>
                                    <td class="cmp-score">@row.F.Lord</td>
                                    <td>@(row.F.Rules.Count == 0 ? "no sign" : string.Join(", ", row.F.Rules.Select(Ordinal)))</td>
                                    <td>@(row.F.PlacedIn is int h ? Ordinal(h) : "—")</td>
                                    <td>@AlsoText(row.F)</td>
                                    <td class="cmp-src">@row.F.End.ToString("d MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="cmp-pad cmp-sub">These are facts only. Which lordships help or hinder a marriage is not classified here until a source is cited. The Upapada lord is not yet included.</p>
            </article>

            <article class="cmp-card">
                <header class="cmp-card-head">
                    <h2>Dashas on one timeline</h2>
                    <p class="cmp-sub">Mahadasha (upper bar) and Antardasha (lower bar) for the next @DashaYears years, both people on the same dates.</p>
                </header>
                @TimelineLane(Groom!.Name, _dashaGroom)
                @TimelineLane(Bride!.Name, _dashaBride)
                <div class="cmp-axis" aria-hidden="true">
                    @foreach (var year in AxisYears())
                    {
                        <span style="left:@AxisPercent(year)%">@year</span>
                    }
                </div>
            </article>
        }

        <ul class="cmp-notes">
            @if (_result.SameSignLord)
            {
                <li>Both Moon signs share a ruler. The book says the absence of Rajju, Vedha, Gana and Rasi Kutas then need not be considered (p.77–78).</li>
            }
            @if (!_result.IsComplete)
            {
                <li>Yoni is not scored: the book scores hostile animals 0 and passable pairs 2–3 but gives no table of hostile pairs, so the total is shown as a range. Vedha, the tenth factor of the ten-factor scheme, is not tabulated in the book and is not computed.</li>
            }
            <li>Kuta agreement is not decisive. The book places it after longevity, health, balance of doshas and Kuja dosha have been cleared (p.79). The dosha reading above is the book's Chapter V; it states its results are not absolute (p.54).</li>
        </ul>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    /// <summary>Optional partner to open the pair directly: /compatibility/5?with=6.</summary>
    [SupplyParameterFromQuery(Name = "with")] public int? With { get; set; }

    private BirthDetails? _person;
    private IReadOnlyList<BirthDetails> _others = [];
    private MatchPersonSnapshot? _me;
    private MatchPersonSnapshot? _partner;
    private bool _meIsGroom = true;
    private AshtakootaResult? _result;
    private string? _notice;
    private int _partnerId;

    private int PartnerId
    {
        get => _partnerId;
        set => _partnerId = value;
    }

    private MatchPersonSnapshot? Groom => _meIsGroom ? _me : _partner;
    private MatchPersonSnapshot? Bride => _meIsGroom ? _partner : _me;

    protected override void OnParametersSet()
    {
        _person = BirthDetailsRepo.GetById(Id);
        if (_person is null)
        {
            Active.Clear();
            return;
        }

        Active.Set(Id, _person.Name,
            $"{_person.DateOfBirth:dd MMM yyyy} · {_person.TimeOfBirth:HH\\:mm} · {_person.PlaceCity}, {_person.PlaceCountry}");
        Active.SetHeaderExtra(null);

        if (With is int requested && requested != Id) _partnerId = requested;
        if (_partnerId == Id) _partnerId = 0;
        _others = BirthDetailsRepo.GetAll().Where(p => p.Id != Id).OrderBy(p => p.Name).ToList();
        _me = MatchPersonRepo.GetByBirthDetailId(Id);
        _meIsGroom = !string.Equals(_person.Sex, "Female", StringComparison.OrdinalIgnoreCase);
        Recompute();
    }

    private void Recompute()
    {
        _result = null;
        _notice = null;
        _partner = null;
        if (_person is null) return;

        if (_me is null)
        {
            _notice = $"{_person.Name} has no stored Moon position yet, so Kuta agreement cannot be read. Generate the chart first.";
            return;
        }
        if (_partnerId == 0)
        {
            _notice = "Choose a saved person to compare with.";
            return;
        }

        _partner = MatchPersonRepo.GetByBirthDetailId(_partnerId);
        if (_partner is null)
        {
            _notice = "The chosen person has no stored Moon position yet, so Kuta agreement cannot be read.";
            return;
        }

        // Roles follow Sex when the pair is one man and one woman; otherwise the person opened is the
        // groom until the roles are swapped.
        var mine = _person.Sex?.ToLowerInvariant();
        var theirs = _partner.Sex?.ToLowerInvariant();
        if (mine is "male" or "female" && theirs is "male" or "female" && mine != theirs)
            _meIsGroom = mine == "male";
        else
            _notice = "The two people are not recorded as one man and one woman, so the roles were assigned by choice; use Swap roles to reverse them.";

        _result = AshtakootaCalculator.Score(Groom!.Person, Bride!.Person);
        ComputeDetails();
    }

    private void Swap()
    {
        _meIsGroom = !_meIsGroom;
        if (_me is not null && _partner is not null)
        {
            _result = AshtakootaCalculator.Score(Groom!.Person, Bride!.Person);
            ComputeDetails();
        }
    }

    private const int DashaYears = 25;
    private DashaPairReading? _dasha;
    private DashaPerson? _dashaGroom;
    private DashaPerson? _dashaBride;
    private DateTime _tlStart;
    private DateTime _tlEnd;

    // The dasha cards read the stored Vimshottari periods; they are skipped when either person has none.
    private void ComputeDasha()
    {
        _dasha = null;
        _dashaGroom = _dashaBride = null;
        if (Groom is null || Bride is null) return;

        _tlStart = DateTime.Today;
        _tlEnd = _tlStart.AddYears(DashaYears);
        var groom = DashaRepo.Get(Groom.BirthDetailId, Groom.Name, _tlStart, _tlEnd);
        var bride = DashaRepo.Get(Bride.BirthDetailId, Bride.Name, _tlStart, _tlEnd);
        if (groom is null || bride is null) return;
        _dashaGroom = groom;
        _dashaBride = bride;
        _dasha = DashaCompatibility.Compare(groom, bride, _tlStart, _tlEnd);
    }

    private static string LevelName(int level) => level switch { 1 => "Mahadasha", 2 => "Antardasha", _ => "Pratyantar" };

    private static string Regard(DashaAttitude a) =>
        a.From == a.To ? $"both lords are {a.From}"
        : $"{a.From} regards {a.To} {(a.Attitude is null ? "— (not in the table)" : a.Attitude.ToLowerInvariant())}";

    private static string RunningText(DashaSpan? s) =>
        s is null ? "—" : $"{s.Lord}, to {s.End:d MMM yyyy}";

    private IEnumerable<(string Person, DashaLordFacts F)> LordFactRows() =>
        _dasha!.FirstFacts.Select(f => (Groom!.Name, f)).Concat(_dasha.SecondFacts.Select(f => (Bride!.Name, f)));

    private static string AlsoText(DashaLordFacts f)
    {
        var parts = new List<string>();
        if (f.IsDarakaraka) parts.Add("Darakaraka");
        if (f.IsVenusOrJupiter) parts.Add("natural marriage significator");
        return parts.Count == 0 ? "—" : string.Join("; ", parts);
    }

    private static string MeterPercent(int points) => Pct(points * 100.0 / AshtakootaResult.MaxTotal);

    private static string Pct(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private double TimelinePercent(DateTime d) =>
        Math.Clamp((d - _tlStart).TotalDays / (_tlEnd - _tlStart).TotalDays * 100, 0, 100);

    private IEnumerable<int> AxisYears() => Enumerable.Range(_tlStart.Year + 1, DashaYears).Where(y => y % 5 == 0);

    private string AxisPercent(int year) => Pct(TimelinePercent(new DateTime(year, 1, 1)));

    private RenderFragment TimelineLane(string name, DashaPerson p) => @<div class="cmp-lane">
        <span class="cmp-lane-name">@name</span>
        @foreach (var level in new[] { 1, 2 })
        {
            <div class="cmp-track">
                @foreach (var s in p.Upcoming.Where(u => u.Level == level))
                {
                    var from = TimelinePercent(s.Start);
                    var to = TimelinePercent(s.End);
                    <span class="cmp-seg cmp-seg-@level" style="left:@Pct(from)%;width:@Pct(to - from)%"
                          title="@s.Lord @LevelName(level), @s.Start.ToString("MMM yyyy") to @s.End.ToString("MMM yyyy")">@(to - from >= (level == 1 ? 3.5 : 4.5) ? s.Lord : "")</span>
                }
            </div>
        }
    </div>;

    private DoshaReading? _doshaGroom;
    private DoshaReading? _doshaBride;
    private DoshaBalance? _balance;
    private SaturnComparison? _saturn;

    // Dosha Samya and the Saturn periods read stored D1 positions and the stored Saturn transit table;
    // either is skipped (its card does not render) when a person lacks the stored data.
    private void ComputeDetails()
    {
        _doshaGroom = _doshaBride = null;
        _balance = null;
        _saturn = null;
        _familyNote = null;
        if (Groom is null || Bride is null) return;

        _familyNote = FamilyNote(Groom, Bride);
        ComputeDasha();

        var groomChart = DoshaRepo.GetByBirthDetailId(Groom.BirthDetailId);
        var brideChart = DoshaRepo.GetByBirthDetailId(Bride.BirthDetailId);
        if (groomChart is not null && brideChart is not null)
        {
            _doshaGroom = DoshaSamyaCalculator.Read(groomChart);
            _doshaBride = DoshaSamyaCalculator.Read(brideChart);
            _balance = DoshaSamyaCalculator.Balance(_doshaGroom, _doshaBride);
        }

        var groomSaturn = SadeSatiRepo.GetByBirthDetailId(Groom.BirthDetailId);
        var brideSaturn = SadeSatiRepo.GetByBirthDetailId(Bride.BirthDetailId);
        if (groomSaturn.Count > 0 && brideSaturn.Count > 0)
            _saturn = SadeSatiCompatibility.Compare(groomSaturn, brideSaturn, DateTime.UtcNow);
    }

    private string? _familyNote;

    // What the saved family details say about this pair: how the bride is related to the groom, and the
    // children they have in common. Null when nothing is recorded between them.
    private string? FamilyNote(MatchPersonSnapshot groom, MatchPersonSnapshot bride)
    {
        var groomFamily = FamilyRepo.GetFor(groom.BirthDetailId);
        var brideFamily = FamilyRepo.GetFor(bride.BirthDetailId);
        var link = groomFamily.FirstOrDefault(f => f.RelativeId == bride.BirthDetailId);
        var children = groomFamily
            .Where(f => f.Role is "Son" or "Daughter" or "Child")
            .Where(f => brideFamily.Any(b => b.RelativeId == f.RelativeId && b.Role is "Son" or "Daughter" or "Child"))
            .Select(f => $"{f.RelativeName} ({f.Role.ToLowerInvariant()})").ToList();

        if (link is null && children.Count == 0) return null;
        var parts = new List<string>();
        if (link is not null)
            parts.Add(link.Role is "Wife" or "Husband"
                ? $"Recorded as married ({(link.Status == "Current" ? "current" : "ended")})."
                : $"Recorded as {link.Role.ToLowerInvariant()}.");
        if (children.Count > 0) parts.Add($"Children together: {string.Join(", ", children)}.");
        return string.Join(" ", parts);
    }

    private string BalanceClass => _balance?.Status switch
    {
        DoshaBalanceStatus.NoSevereDosha or DoshaBalanceStatus.Balanced => "pass",
        DoshaBalanceStatus.PartlyBalanced => "open",
        _ => "fail",
    };

    private string BalanceText => _balance?.Status switch
    {
        DoshaBalanceStatus.NoSevereDosha => "No severe Mars or Rahu dosha in either chart",
        DoshaBalanceStatus.Balanced => "Balanced",
        DoshaBalanceStatus.PartlyBalanced => "Partly balanced",
        _ => "Not balanced",
    };

    private IEnumerable<(string Person, DoshaAffliction A)> AfflictionRows() =>
        (_doshaGroom!.Afflictions.Select(a => (Groom!.Name, a)).Concat(_doshaBride!.Afflictions.Select(a => (Bride!.Name, a))))
        .OrderBy(r => r.Item2.Weight).ThenBy(r => r.Item1);

    private static string Ordinal(int n) => n switch { 1 => "1st", 2 => "2nd", 3 => "3rd", _ => $"{n}th" };

    private static string Standing(SaturnStanding s)
    {
        if (s.Current is { } c)
            return $"{(s.Phase is null ? "In it" : $"In it ({s.Phase})")} until {c.EndUtc:MMM yyyy}"
                   + (s.Next is { } n ? $"; next {n.StartUtc:MMM yyyy}–{n.EndUtc:MMM yyyy}" : "");
        return s.Next is { } next ? $"Next {next.StartUtc:MMM yyyy}–{next.EndUtc:MMM yyyy}" : "None in the stored range";
    }

    private string Overlaps(string category)
    {
        var rows = _saturn!.Overlaps.Where(o => o.Category == category).ToList();
        return rows.Count == 0
            ? "Never together"
            : string.Join("; ", rows.Select(o => $"{o.StartUtc:MMM yyyy}–{o.EndUtc:MMM yyyy}"));
    }

    private RenderFragment MarsCard(string role, string name, DoshaReading r) => @<div class="cmp-person">
        <span class="cmp-role">@role</span>
        <strong>@name</strong>
        <span>Mars from Lagna @Ordinal(r.MarsHouses[DoshaReference.Lagna]) · Moon @Ordinal(r.MarsHouses[DoshaReference.Moon]) · Venus @Ordinal(r.MarsHouses[DoshaReference.Venus])</span>
        <span>@(r.ClassicalKuja ? "Mars is in the 1st, 2nd, 4th, 7th, 8th or 12th from at least one reference (classical Kuja dosha)" : "Mars is in none of the 1st, 2nd, 4th, 7th, 8th, 12th from Lagna, Moon or Venus")</span>
    </div>;

    private string TotalText => _result is null ? "" :
        _result.IsComplete ? _result.TotalMin.ToString() : $"{_result.TotalMin}–{_result.TotalMax}";

    private string VerdictClass => _result?.Passes switch { true => "pass", false => "fail", _ => "open" };

    private string VerdictText => _result?.Passes switch
    {
        true => $"Reaches the book's pass mark of {AshtakootaResult.PassMark}",
        false => $"Below the book's pass mark of {AshtakootaResult.PassMark}",
        _ => $"Cannot be settled against the pass mark of {AshtakootaResult.PassMark}",
    };

    private static string StatusClass(KutaResult k) => k.Status switch
    {
        KutaStatus.Present => "present",
        KutaStatus.Absent => "absent",
        _ => "unscored",
    };

    private RenderFragment PersonCard(string role, MatchPersonSnapshot s) => @<div class="cmp-person">
        <span class="cmp-role">@role</span>
        <strong>@s.Name</strong>
        <span>Moon in @SignLabels.For(s.Person.MoonSign), @s.NakshatraName pada @s.Pada</span>
        <span>@s.Person.Gana gana · @s.Person.YoniAnimal (@s.Person.YoniGender.ToLowerInvariant()) · @s.Person.Nadi nadi</span>
        @if (s.NameNumberRoot is int root)
        {
            <span>Name number @root (compound @s.NameNumberCompound)</span>
        }
    </div>;
}
