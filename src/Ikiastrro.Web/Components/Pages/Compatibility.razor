            {
                <div class="cmp-scroll"><table class="cmp-table">
                    <tbody>
                        @foreach (var row in D9Rows())
                        {
                            <tr><th scope="row">@row.Fact</th><td data-label="@m.Name">@(left ? row.Groom : row.Bride)</td></tr>
                        }
                    </tbody>
                </table></div>
            }
            else if (tab == "karaka")
            {
                @if (karakas.Count == 0)
                {
                    <p class="cmp-pad cmp-sub">No chara karakas are stored for this chart.</p>
                }
                else
                {
                    <div class="cmp-scroll"><table class="cmp-table">
                        <thead><tr><th>Karaka</th><th>Planet</th><th>Rasi sign</th><th>House</th><th>Navamsa sign</th><th>Toward the 7th house</th></tr></thead>
                        <tbody>
                            @foreach (var k in karakas)
                            {
                                <tr class="@(k.Code == "DK" ? "cmp-row-key" : null)">
                                    <th scope="row">@k.Role</th>
                                    <td data-label="Planet" class="cmp-score">@k.Planet</td>
                                    <td data-label="Rasi sign">@k.D1Sign@(string.IsNullOrWhiteSpace(k.Dignity) ? "" : $" ({k.Dignity})")</td>
                                    <td data-label="House">@(k.House is int h ? Ordinal(h) : "—")</td>
                                    <td data-label="Navamsa sign">@(k.D9Sign ?? "—")</td>
                                    <td data-label="Toward the 7th house">@LeanText(marriage?.Seventh, k.Planet)</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    <p class="cmp-pad cmp-sub">Ranked by degree within the sign (Jaimini). Houses are from this person's own Lagna. "Toward the 7th house" is PVR's step 5 (Ch. 13): a planet in a quadrant, trine or upachaya from the 7th supports it; in a dusthana from it, or as its bādhaka, obstructs it. It is read within each person's own chart; no source is cited for how one chart's karakas help or hinder the other.</p>
                }
            }
            else if (tab == "marriage")
            {
                @if (marriage is null)
                {
                    <p class="cmp-pad cmp-sub">The marriage reading needs this chart's stored strength facts.</p>
                }
                else
                {
                    <p class="cmp-pad">Marriage overall: @PctText(marriage.AreaPercent) <b>@LifeMatterReading.Band(marriage.AreaPercent).Label</b> (the @marriage.AreaHouses of the main birth chart).</p>
                    <div class="cmp-scroll"><table class="cmp-table">
                        <thead><tr><th>Question</th><th>Houses</th><th>Strength</th><th>Support</th></tr></thead>
                        <tbody>
                            @foreach (var r in marriage.Matters)
                            {
                                <tr>
                                    <th scope="row">@r.Matter</th>
                                    <td data-label="Houses">@r.Houses</td>
                                    <td data-label="Strength" class="cmp-score">@PctText(r.Percent)</td>
                                    <td data-label="Support">@LifeMatterReading.Band(r.Percent).Label</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    <p class="cmp-pad cmp-sub">The same figures as Key Inference, read from Lagna in the main birth chart. 50% is the ordinary middle.</p>
                    @if (marriage.Seventh is { } sev)
                    {
                        var helpers = TargetInfluenceText.Helpers(sev);
                        var hinderers = TargetInfluenceText.Hinderers(sev);
                        <div class="cmp-scroll"><table class="cmp-table">
                            <thead><tr><th>On the 7th house</th><th>Planet</th><th>Why</th></tr></thead>
                            <tbody>
                                @foreach (var pl in helpers)
                                {
                                    <tr><th scope="row"><span class="cmp-flag cmp-flag-good">&#10003; Helps</span></th><td data-label="Planet" class="cmp-score">@pl.Planet</td><td data-label="Why">@TargetInfluenceText.Why(pl)</td></tr>
                                }
                                @foreach (var pl in hinderers)
                                {
                                    <tr><th scope="row"><span class="cmp-flag cmp-flag-concern">! Hinders</span></th><td data-label="Planet" class="cmp-score">@pl.Planet</td><td data-label="Why">@TargetInfluenceText.Why(pl)</td></tr>
                                }
                                @if (!helpers.Any() && !hinderers.Any())
                                {
                                    <tr><td colspan="3" class="cmp-sub">No planet acts on the 7th house or rules it in a way PVR's step 5 classes as helping or hindering.</td></tr>
                                }
                            </tbody>
                        </table></div>
                        <p class="cmp-pad cmp-sub">PVR step 5 (Ch. 13) on the 7th house: planets that sit in, aspect, intervene on or rule it, up to two a side.</p>
                    }
                }
            }
            else if (tab == "saturn" && saturn is not null)
            {
                <p class="cmp-pad cmp-sub">Moon in @SignLabels.For(m.Person.MoonSign)</p>
                <div class="cmp-scroll"><table class="cmp-table">
                    <tbody>
                        @foreach (var st in saturn)
                        {
                            <tr><th scope="row">@st.Category</th><td data-label="@m.Name">@Standing(st)</td></tr>
                        }
                    </tbody>
                </table></div>
            }
            else if (tab == "dasha" && lords.Count > 0)
            {
                <div class="cmp-scroll"><table class="cmp-table">
                    <thead><tr><th>Period</th><th>Lord</th><th>Rules</th><th>Sits in</th><th>Ends</th></tr></thead>
                    <tbody>
                        @foreach (var row in lords)
                        {
                            <tr>
                                <td data-label="Period">@LevelName(row.F.Level)</td>
                                <td data-label="Lord" class="cmp-score">@row.F.Lord</td>
                                <td data-label="Rules">@(row.F.Rules.Count == 0 ? "no sign" : string.Join(", ", row.F.Rules.Select(Ordinal)))</td>
                                <td data-label="Sits in">@(row.F.PlacedIn is int h ? Ordinal(h) : "—")</td>
                                <td data-label="Ends" class="cmp-src">@row.F.End.ToString("d MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
                <p class="cmp-pad cmp-sub">Houses from this person's own Lagna. Facts only: which lordships help or hinder a marriage is not classified until a source is cited.</p>
            }
        </article>
    </div>;

    private static string LeanText(TargetInfluenceReading? sev, string planet)
    {
        var p = sev is null || !Enum.TryParse<PlanetName>(planet, out var pn) ? null : sev.Planets.FirstOrDefault(x => x.Planet == pn);
        return p is null ? "—" : p.Lean switch
        {
            InfluenceLean.Supports => "\u2713 Supports",
            InfluenceLean.Obstructs => "! Obstructs",
            InfluenceLean.Mixed => "? Mixed",
            _ => "Neutral",
        } + " (" + TargetInfluenceText.PositionText(p.HouseFromTarget, p.Position) + ")";
    }

    private static string PctText(int? p) => p is null ? "—" : $"{p}%";

    // Bridge (waterfall) of the Ashtakoota total: each scored Kuta steps up by its points, then the total
    // bar stands against the 36-point scale, with a dashed line at the book's pass mark. An unscored Kuta
    // (Yoni, until both Moon nakshatras are known) is left out and the total is then a minimum.
    private (string Svg, string Legend, string Aria)? BuildBridge()
    {
        if (!MarriageApplies || _result is null) return null;
        var kutas = _result.Scored.Where(k => k.Score is not null).ToList();
        if (kutas.Count == 0) return null;
        var max = AshtakootaResult.MaxTotal;
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        string N(double d) => d.ToString("0.#", inv);

        const int colW = 66, barW = 44, pad = 20, top = 22, plotH = 190, labelH = 34;
        var cols = kutas.Count + 1;
        var width = pad * 2 + cols * colW;
        double Y(double v) => top + (max - v) * plotH / max;
        var markup = new System.Text.StringBuilder();
        markup.Append($"<line class=\"cmp-br-zero\" x1=\"{pad / 2}\" x2=\"{width - pad / 2}\" y1=\"{N(Y(0))}\" y2=\"{N(Y(0))}\"/>");
        markup.Append($"<line class=\"cmp-br-pass\" x1=\"{pad / 2}\" x2=\"{width - pad / 2}\" y1=\"{N(Y(AshtakootaResult.PassMark))}\" y2=\"{N(Y(AshtakootaResult.PassMark))}\"/>");
        markup.Append($"<text class=\"cmp-br-lab\" x=\"{pad / 2}\" y=\"{N(Y(AshtakootaResult.PassMark) - 4)}\">pass mark {AshtakootaResult.PassMark}</text>");
        markup.Append($"<text class=\"cmp-br-lab\" x=\"{pad / 2}\" y=\"{N(Y(max) - 6)}\">{max}</text>");

        var running = 0;
        for (var i = 0; i < kutas.Count; i++)
        {
            var k = kutas[i];
            var pts = k.Score!.Value;
            var x = pad + i * colW + (colW - barW) / 2;
            var yTop = Y(running + pts);
            var h = Math.Max(2, Y(running) - Y(running + pts));
            markup.Append($"<rect class=\"cmp-br-step\" x=\"{x}\" y=\"{N(yTop)}\" width=\"{barW}\" height=\"{N(h)}\" rx=\"3\"><title>{System.Net.WebUtility.HtmlEncode(k.Name)}: {pts} of {k.MaxScore}</title></rect>");
            markup.Append($"<text class=\"cmp-br-val\" x=\"{x + barW / 2}\" y=\"{N(yTop - 5)}\" text-anchor=\"middle\">+{pts}</text>");
            markup.Append($"<line class=\"cmp-br-link\" x1=\"{x + barW}\" x2=\"{x + colW}\" y1=\"{N(Y(running + pts))}\" y2=\"{N(Y(running + pts))}\"/>");
            markup.Append($"<text class=\"cmp-br-lab\" x=\"{x + barW / 2}\" y=\"{top + plotH + 16}\" text-anchor=\"middle\">{System.Net.WebUtility.HtmlEncode(k.Name)}</text>");
            running += pts;
        }
        var tx = pad + kutas.Count * colW + (colW - barW) / 2;
        var tTop = Y(running);
        markup.Append($"<rect class=\"cmp-br-net\" x=\"{tx}\" y=\"{N(tTop)}\" width=\"{barW}\" height=\"{N(Math.Max(2, Y(0) - tTop))}\" rx=\"3\"><title>Total: {TotalText} of {max}</title></rect>");
        markup.Append($"<text class=\"cmp-br-val\" x=\"{tx + barW / 2}\" y=\"{N(tTop - 5)}\" text-anchor=\"middle\">{running} / {max}</text>");
        markup.Append($"<text class=\"cmp-br-lab\" x=\"{tx + barW / 2}\" y=\"{top + plotH + 16}\" text-anchor=\"middle\">Total</text>");

        var legend = _result.IsComplete ? "" : "<small>Yoni is not scored yet, so the total is a minimum.</small>";
        var svg = $"<svg viewBox=\"0 0 {width} {top + plotH + labelH}\" aria-hidden=\"true\">{markup}</svg>";
        return (svg, legend, $"Bridge chart of the Ashtakoota: the Kuta points stack up to {TotalText} of {max}.");
    }

    private RenderFragment MarsCard(string role, string name, DoshaReading r) => @<div class="cmp-person">
        <span class="cmp-role">@role</span>
        <strong>@name</strong>
        <span>Mars from Lagna @Ordinal(r.MarsHouses[DoshaReference.Lagna]) · Moon @Ordinal(r.MarsHouses[DoshaReference.Moon]) · Venus @Ordinal(r.MarsHouses[DoshaReference.Venus])</span>
        <span>@(r.ClassicalKuja ? "Mars is in the 1st, 2nd, 4th, 7th, 8th or 12th from at least one reference (classical Kuja dosha)" : "Mars is in none of the 1st, 2nd, 4th, 7th, 8th, 12th from Lagna, Moon or Venus")</span>
    </div>;

    private string TotalText => _result is null ? "" :
        _result.IsComplete ? _result.TotalMin.ToString() : $"{_result.TotalMin}–{_result.TotalMax}";

    private string VerdictClass => _result?.Passes switch { true => "pass", false => "fail", _ => "open" };

    private string VerdictText => _result?.Passes switch
    {
        true => $"Reaches the book's pass mark of {AshtakootaResult.PassMark}",
        false => $"Below the book's pass mark of {AshtakootaResult.PassMark}",
        _ => $"Cannot be settled against the pass mark of {AshtakootaResult.PassMark}",
    };

    private static string StatusClass(KutaResult k) => k.Status switch
    {
        KutaStatus.Present => "present",
        KutaStatus.Absent => "absent",
        _ => "unscored",
    };

    private RenderFragment PersonCard(string role, MatchPersonSnapshot s) => @<div class="cmp-person">
        <span class="cmp-role">@role</span>
        <strong>@s.Name</strong>
        <span>Moon in @SignLabels.For(s.Person.MoonSign), @s.NakshatraName pada @s.Pada</span>
        <span>@s.Person.Gana gana · @s.Person.YoniAnimal (@s.Person.YoniGender.ToLowerInvariant()) · @s.Person.Nadi nadi</span>
        @if (s.NameNumberRoot is int root)
        {
            <span>Name number @root (compound @s.NameNumberCompound)</span>
        }
    </div>;
}
