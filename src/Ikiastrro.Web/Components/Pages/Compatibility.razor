    private async Task Jump(string id) => await JS.InvokeVoidAsync("ikiastrroScroll.toSection", id);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_result is null) return;
        if (PrintMode && !_detailsOpened)
        {
            _detailsOpened = true;
            try { await SetDetails(true); }
            catch (JSException) { /* a cached older scroll.js lacks setDetails; the report still prints, details as they were */ }
        }
        var ids = NavSections().Select(n => n.Id).ToArray();
        var key = string.Join(",", ids);
        if (key == _spyKey) return;
        _spyKey = key;
        try { await JS.InvokeVoidAsync("ikiastrroScroll.spy", "cmp-nav", ids); }
        catch (JSException) { /* the section highlight is cosmetic; a cached older scroll.js must not break the page */ }
    }

    // Every line is read straight off a computed result and names the card that shows it; nothing here
    // is a new rule, and no line combines results into a score.
    private List<Finding> BuildFindings()
    {
        var list = new List<Finding>();
        var r = _result!;
        void Add(FindingKind k, string t, string target) => list.Add(new(k, t, target));

        if (MarriageApplies)
        {
        foreach (var k in r.Scored)
        {
            if (k.Status == KutaStatus.Unscored) Add(FindingKind.Open, $"{k.Name} could not be scored", "cmp-kuta");
            else if (k.Score == k.MaxScore) Add(FindingKind.Good, $"{k.Name}: full score ({k.Score} of {k.MaxScore})", "cmp-kuta");
            else if (k.Score == 0) Add(FindingKind.Concern, $"{k.Name}: 0 of {k.MaxScore}", "cmp-kuta");
        }
        Add(r.Passes == false ? FindingKind.Concern : FindingKind.Good,
            r.Passes == false ? $"Kuta total {TotalText} is below the book's traditional pass mark of {AshtakootaResult.PassMark}"
                              : $"Kuta total {TotalText} reaches the book's traditional pass mark of {AshtakootaResult.PassMark}", "cmp-kuta");

        foreach (var k in r.Additional)
            Add(k.Status == KutaStatus.Present ? FindingKind.Good : FindingKind.Concern, $"{k.Name}: {(k.Status == KutaStatus.Present ? "passes" : "does not pass")}", "cmp-kuta");

        if (_balance is not null)
            Add(BalanceClass == "pass" ? FindingKind.Good : FindingKind.Concern, $"Mars and malefics: {char.ToLowerInvariant(BalanceText[0])}{BalanceText[1..]}", "cmp-dosha");
        else
            Add(FindingKind.Open, "Mars and malefic balance could not be read (a chart lacks stored positions)", "cmp-data");

        if (_d9Groom is null)
            Add(FindingKind.Open, "Navamsa could not be compared (a chart lacks stored D1 or D9 positions)", "cmp-data");
        }

        if (MarriageApplies)
            foreach (var (name, karakas, m) in new[] { (Groom!.Name, _karakaGroom, _marriageGroom), (Bride!.Name, _karakaBride, _marriageBride) })
            {
                if (m?.Seventh is not { } sev) continue;
                void Lean(string who, PlanetName planet)
                {
                    var p = sev.Planets.FirstOrDefault(x => x.Planet == planet);
                    if (p is null) return;
                    var why = TargetInfluenceText.PositionText(p.HouseFromTarget, p.Position);
                    if (p.Lean == InfluenceLean.Supports) Add(FindingKind.Good, $"{name}: {who} {planet} supports the 7th house ({why})", "cmp-individual");
                    else if (p.Lean == InfluenceLean.Obstructs) Add(FindingKind.Concern, $"{name}: {who} {planet} obstructs the 7th house ({why})", "cmp-individual");
                    else if (p.Lean == InfluenceLean.Mixed) Add(FindingKind.Open, $"{name}: {who} {planet} both helps and hinders the 7th house ({why})", "cmp-individual");
                }
                Lean("the 7th lord", sev.Lord);
                if (karakas.FirstOrDefault(k => k.Code == "DK") is { } dk && Enum.TryParse<PlanetName>(dk.Planet, out var dkPlanet))
                    Lean("the Darakaraka", dkPlanet);
            }

        if (_synastry is not null)
            Add(FindingKind.Open, "Cross-chart contacts are shown as facts only: no cited source classifies them", "cmp-synastry");

        if (_saturn is not null)
            Add(_saturn.SadeSatiOverlaps ? FindingKind.Concern : FindingKind.Good,
                _saturn.SadeSatiOverlaps ? "Sade Sati overlaps within 30 years" : "No Sade Sati overlap within 30 years", "cmp-saturn");
        else
            Add(FindingKind.Open, "Saturn periods could not be compared (a chart lacks stored periods)", "cmp-data");

        if (_dasha is null) Add(FindingKind.Open, "Dashas could not be compared (a chart lacks stored periods)", "cmp-data");
        else Add(FindingKind.Open, "Dasha periods are shown as facts only: no cited source classifies them", "cmp-dasha");

        if (MarriageApplies)
        {
            Add(FindingKind.Open, "Vedha is not computed (no cited pair table)", "cmp-notes");
            Add(FindingKind.Open, "Rasi is scored 7 or 0 from the book's qualitative verdicts; the Vashya direction is read from one example", "cmp-notes");
        }
        return list;
    }

    // What the saved family details say about this pair: how the bride is related to the groom, and the
    // children they have in common. Null when nothing is recorded between them.
    private string? FamilyNote(MatchPersonSnapshot groom, MatchPersonSnapshot bride)
    {
        var groomFamily = FamilyRepo.GetFor(groom.BirthDetailId);
        var brideFamily = FamilyRepo.GetFor(bride.BirthDetailId);
        var link = groomFamily.FirstOrDefault(f => f.RelativeId == bride.BirthDetailId);
        var children = groomFamily
            .Where(f => f.Role is "Son" or "Daughter" or "Child")
            .Where(f => brideFamily.Any(b => b.RelativeId == f.RelativeId && b.Role is "Son" or "Daughter" or "Child"))
            .Select(f => $"{f.RelativeName} ({f.Role.ToLowerInvariant()})").ToList();

        if (link is null && children.Count == 0) return null;
        var parts = new List<string>();
        if (link is not null)
            parts.Add(link.Role is "Wife" or "Husband"
                ? $"Recorded as married ({(link.Status == "Current" ? "current" : "ended")})."
                : $"{bride.Name} is recorded as {groom.Name}'s {link.Role.ToLowerInvariant()} ({FamilyRelation.LayerOf(FamilyRelation.FromRole(link.Role))} family).");
        if (children.Count > 0) parts.Add($"Children together: {string.Join(", ", children)}.");
        return string.Join(" ", parts);
    }

