@page "/transit-wheel"
@page "/transit-wheel/{Id:int}"
@using System.Globalization
@using Ikiastrro.Core.Models
@using Ikiastrro.Core.Engines.Astronomy
@inject BirthDetailsRepository BirthDetailsRepo
@inject Natal_Transit_Comp_WheelRepository D1Repo
@inject DashaPeriodsRepository DashaRepo
@inject Ikiastrro.Data.GocharaRepository Gochara
@inject ActivePerson Active
@inject NavigationManager Nav

@* Natal/transit comparison — docs/ui/components/spec_Natal_Transit_Comp_Wheel.md. Date and
   dasha controls share one active instant through TransitSelection. *@

<PageTitle>@(_personName ?? "Transit") · D1 Birth Chart</PageTitle>

@if (_error is not null)
{
    <section class="tw-unavailable" role="status">
        <h1 class="transit-heading">TRANSIT - D1 BIRTH CHART</h1>
        <p>@_error</p>
        <a href="/">Choose a saved person</a>
    </section>
}
else
{
    <h1 class="transit-heading">TRANSIT - D1 BIRTH CHART</h1>

    <div class="tw-grid">
        @if (_selection is not null)
        {
            <section class="tw-controls" aria-label="Transit date and dasha filters">
                    <label class="tw-field">
                        <span>Current transit date</span>
                        <input type="date" value="@DateValue" @onchange="OnDateChanged" />
                    </label>
                    <label class="tw-field">
                        <span>Mahadasha</span>
                        <select value="@(_selection.Maha?.Id.ToString() ?? string.Empty)" @onchange="OnMahaChanged">
                            <option value="">Select Mahadasha</option>
                            @foreach (var period in _selection.Periods)
                            {
                                <option value="@period.Id">@PlanetGlyph(period.Lord) @period.Lord · @PeriodDates(period)</option>
                            }
                        </select>
                    </label>
                    <label class="tw-field">
                        <span>Antardasha</span>
                        <select value="@(_selection.Antar?.Id.ToString() ?? string.Empty)" @onchange="OnAntarChanged" disabled="@(_selection.Maha is null)">
                            <option value="">Select Antardasha</option>
                            @foreach (var period in _selection.AntarPeriods)
                            {
                                <option value="@period.Id">@PlanetGlyph(period.Lord) @period.Lord · @PeriodDates(period)</option>
                            }
                        </select>
                    </label>
            </section>
        }
        <div class="tw-wheel">
            @* The D1 data loaded for the birth table also drives the shared chart component. *@
            @if (D1AscendantSign is string ascendantSign)
            {
                <Natal_Transit_Comp_WheelChart AscendantSign="@ascendantSign"
                                   NatalPoints="@D1WheelPoints"
                                   TransitPoints="@TransitWheelPoints"
                                   AsOfUtc="@_asOfUtc" />
            }
            else
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="tw-alert">
                    Generate a D1 chart for this person first.
                </MudAlert>
            }
        </div>

        <div class="tw-tables">
            <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" Class="tw-tabs">
                <MudTabPanel Text="D1 Birth">
                    @if (_d1.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="tw-alert">
                            Generate a D1 chart for this person first.
                        </MudAlert>
                    }
                    else
                    {
                        <div class="tw-scroll">
                            <MudSimpleTable Dense="true" Hover="true" Bordered="false" Class="tw-table">
                                <thead>
                                    <tr>
                                        <th>House</th><th>Planet</th><th>Motion</th><th>Degree</th>
                                        <th>Sign</th><th>Nakṣatra</th><th>Nak. Pad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in D1Rows)
                                    {
                                        <tr>
                                            <td class="num">@(r.House?.ToString() ?? "—")</td>
                                            <td>@r.Planet</td>
                                            <td>@MotionCell(r)</td>
                                            <td class="num">@(Dash(r.DegreesInSignDisplay))</td>
                                            <td>@(Dash(r.Sign))</td>
                                            <td>@(Dash(r.Nakshatra))</td>
                                            <td class="num">@(r.NakshatraPada?.ToString() ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </div>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Current Transit">
                    @if (_transitError is not null || _transits.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="tw-alert">
                            Transit reference not backfilled — run <code>backfill-planet-transits</code>.
                        </MudAlert>
                    }
                    else
                    {
                        <div class="tw-scroll">
                            <MudSimpleTable Dense="true" Hover="true" Bordered="false" Class="tw-table">
                                <thead>
                                    <tr>
                                        <th>House<br />from D1</th><th>Planet</th><th>Motion</th><th>Degree</th>
                                        <th>Speed<br />°/day</th><th>In sign<br />since</th>
                                        <th>In-sign<br />motion</th><th>Next<br />change</th><th>Next-change<br />motion</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in TransitRows)
                                    {
                                        <tr>
                                            <td class="num">@(HouseFromD1(s)?.ToString() ?? "—")</td>
                                            <td>@s.Planet</td>
                                            <td>@s.MotionDirection</td>
                                            <td class="num">@SignName(s.SignId) @s.DegreeInSign.ToString("0.00", CultureInfo.InvariantCulture)°</td>
                                            <td class="num">@s.SpeedDegreesPerDay.ToString("0.0000", CultureInfo.InvariantCulture)</td>
                                            <td class="num">@s.InSignSinceUtc.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</td>
                                            <td>@(s.InSignMotion ?? "—")</td>
                                            <td class="num">@(s.NextChangeUtc?.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) ?? "—")</td>
                                            <td>@(s.NextChangeMotion ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </div>
                    }
                </MudTabPanel>
            </MudTabs>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private string? _personName;
    private string? _error;
    private string? _transitError;
    private IReadOnlyList<Natal_Transit_Comp_WheelD1Row> _d1 = Array.Empty<Natal_Transit_Comp_WheelD1Row>();
    private Dictionary<string, string> _natalSignByPlanet = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<PlanetTransitSnapshot> _transits = Array.Empty<PlanetTransitSnapshot>();
    private DateTime _asOfUtc = DateTime.UtcNow;
    private TransitSelection? _selection;

    private static readonly string[] SignById =
        { "", "Aries", "Taurus", "Gemini", "Cancer", "Leo", "Virgo", "Libra", "Scorpio",
          "Sagittarius", "Capricorn", "Aquarius", "Pisces" };

    protected override void OnParametersSet()
    {
        _error = _transitError = null;

        if (Id is not int id)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        var person = BirthDetailsRepo.GetAll().FirstOrDefault(p => p.Id == id);
        if (person is null)
        {
            Active.Clear();
            _error = "This saved person could not be found.";
            return;
        }

        _personName = person.Name;
        var birthLine =
            $"{person.DateOfBirth:dd MMM yyyy} · {person.TimeOfBirth:HH\\:mm} · {person.PlaceCity}, {person.PlaceCountry}";
        Active.Set(id, person.Name, birthLine);

        _d1 = D1Repo.LoadD1Birth(id);
        _natalSignByPlanet = _d1
            .Where(r => !string.IsNullOrWhiteSpace(r.Sign))
            .GroupBy(r => r.Planet, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First().Sign!, StringComparer.OrdinalIgnoreCase);

        var offset = TimeSpan.TryParse(person.UtcOffset.TrimStart('+'), out var parsedOffset)
            ? parsedOffset
            : TransitSelection.IstOffset;
        _selection = new TransitSelection(DashaRepo.GetTreeByBirthDetailId(id), offset, DateTimeOffset.UtcNow);
        _asOfUtc = _selection.ActiveUtc.UtcDateTime;
        LoadTransits();
    }

    private void LoadTransits()
    {
        try
        {
            _transits = Gochara.GetSnapshots(_asOfUtc);
        }
        catch (Exception ex)
        {
            _transitError = ex.Message;
            _transits = Array.Empty<PlanetTransitSnapshot>();
        }
    }

    private string DateValue => _selection?.ActiveIst.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;

    private void OnDateChanged(ChangeEventArgs args)
    {
        if (_selection is null || !DateTime.TryParseExact(args.Value?.ToString(), "yyyy-MM-dd",
                CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)) return;
        _selection.SetDate(date);
        RefreshSelection();
    }

    private void OnMahaChanged(ChangeEventArgs args)
    {
        if (_selection is null || !int.TryParse(args.Value?.ToString(), out var id)) return;
        _selection.SelectMaha(id);
        RefreshSelection();
    }

    private void OnAntarChanged(ChangeEventArgs args)
    {
        if (_selection is null || !int.TryParse(args.Value?.ToString(), out var id)) return;
        _selection.SelectAntar(id);
        RefreshSelection();
    }

    private void RefreshSelection()
    {
        _asOfUtc = _selection!.ActiveUtc.UtcDateTime;
        LoadTransits();
    }

    private static string PeriodDates(Ikiastrro.Core.Engines.Dasha.DashaPeriodRecord period) =>
        $"{period.StartDate:dd MMM yyyy} – {period.EndDate:dd MMM yyyy}";

    private static string PlanetGlyph(string planet) =>
        Ikiastrro.Core.Presentation.ChartViewModel.PlanetGlyph(planet);

    // D1 Birth: grahas plus the Lagna row, ordered slow → fast (Lagna first).
    private IEnumerable<Natal_Transit_Comp_WheelD1Row> D1Rows =>
        _d1.OrderBy(r => Natal_Transit_Comp_WheelMath.PlanetRank(r.Planet));

    private IEnumerable<PlanetTransitSnapshot> TransitRows =>
        _transits.OrderBy(s => Natal_Transit_Comp_WheelMath.PlanetRank(s.Planet.ToString()));

    private string? D1AscendantSign => _d1.FirstOrDefault(r =>
        r.Planet.Equals("Lagna", StringComparison.OrdinalIgnoreCase) ||
        r.Planet.Equals("Ascendant", StringComparison.OrdinalIgnoreCase))?.Sign;

    private IReadOnlyList<Natal_Transit_Comp_WheelChart.Point> D1WheelPoints => _d1
        .Select(r => new Natal_Transit_Comp_WheelChart.Point(r.Planet, r.LongitudeDegrees)).ToList();

    private IReadOnlyList<Natal_Transit_Comp_WheelChart.Point> TransitWheelPoints => _transits
        .Select(r => new Natal_Transit_Comp_WheelChart.Point(r.Planet.ToString(), r.LongitudeDegrees)).ToList();

    private int? HouseFromD1(PlanetTransitSnapshot s) =>
        Natal_Transit_Comp_WheelMath.HouseFromD1(
            _natalSignByPlanet.GetValueOrDefault(s.Planet.ToString()), SignName(s.SignId));

    private static string MotionCell(Natal_Transit_Comp_WheelD1Row r)
    {
        if (r.Planet.Equals("Lagna", StringComparison.OrdinalIgnoreCase) ||
            r.Planet.Equals("Ascendant", StringComparison.OrdinalIgnoreCase)) return "—";
        return Natal_Transit_Comp_WheelMath.FormatMotion(r.IsRetrograde, r.IsCombust);
    }

    private static string SignName(byte id) => id >= 1 && id <= 12 ? SignById[id] : "—";

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
