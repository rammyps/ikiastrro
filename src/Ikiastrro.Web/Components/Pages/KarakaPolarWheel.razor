@page "/charts/{Id:int}/karaka-wheel"
@using Ikiastrro.Web.Components.Workspace
@inject BirthDetailsRepository BirthDetailsRepo
@inject ChartResultsRepository ChartResultsRepo
@inject ChartKeyDetailsRepository ChartKeyDetailsRepo
@inject ChartHouseLordsRepository ChartHouseLordsRepo
@inject ChartHouseLordInterpretationRepository ChartHouseLordInterpretationRepo
@inject ChartAspectsRepository ChartAspectsRepo
@inject ChartConjunctionsRepository ChartConjunctionsRepo
@inject ChartMultiGrahaConjunctionRepository ChartMultiGrahaConjunctionRepo
@inject ChartTypeRepository ChartTypeRepo
@inject SqlConnectionFactory ConnectionFactory
@inject ActivePerson Active
@inject NavigationManager Nav

@if (!Embedded)
{
    @* Legacy route retained as a redirect so bookmarks land on the canonical Key Inference step. *@
}
else if (_data is null || _rules is null)
{
 <section class="karaka-unavailable" role="status"><h1>SPECIAL LAGNAS &amp; KARAKAS</h1><p>No generated divisional charts were found for this person.</p><a href="/">Choose a saved person</a></section>
}
else
{
 <header class="karaka-head">
  <h1>SPECIAL LAGNAS &amp; KARAKAS</h1>
  <nav class="karaka-view-tabs" aria-label="Chart view">
   <button type="button" class="@(_view == "polar" ? "is-active" : null)" @onclick="ShowPolar">Polar-Wheel</button>
   <button type="button" class="@(_view == "south" ? "is-active" : null)" @onclick="ShowSouth">SouthIND-Grid</button>
  </nav>
 </header>
 <label class="karaka-chart-selector">Chart<select value="@_chartCode" @onchange="ChangeChart">@foreach(var chart in AvailableCharts){<option value="@chart.ChartType">@chart.ChartType · @chart.SanskritName</option>}</select></label>
 @if (SelectedChart is { } selected)
 {
  <PolarGridLagnaSelect Sectors="BuildSectors(selected)" PlanetPlacements="BuildPlanetPlacements(selected)" ReferencePoints="BuildReferencePoints(selected,_rules.LagnaReferences)" ChartCode="@selected.ChartType" AscendantSign="@selected.AscendantSign" View="@_view" />

  var lagnaRows = BuildSpecialLagnaRows(selected, _rules.LagnaReferences);
  @if (lagnaRows.Count > 0)
  {
   <h3 class="karaka-sectionhead">Special Lagnas</h3>
   <div class="karaka-scroll">
    <table class="karaka-table">
     <thead><tr><th>Special Lagna</th><th>Sign</th><th>House</th><th>Degree</th><th>Signifies</th></tr></thead>
     <tbody>
      @foreach (var r in lagnaRows)
      {
       <tr><td>@r.Name <span class="karaka-code">(@r.Code)</span></td><td>@r.Sign</td><td class="num">@r.House</td><td class="num">@r.Degree</td><td>@r.Signifies</td></tr>
      }
     </tbody>
    </table>
   </div>
  }
 }
}
@code {
 [Parameter] public int Id { get; set; }
 [Parameter] public bool Embedded { get; set; }
 private WorkspaceData? _data; private NaisargikaKarakaRules? _rules; private string _chartCode = "D1"; private string _view = "polar";
 private IEnumerable<LoadedChart> AvailableCharts => _data?.Charts.Values.OrderBy(c => _data.ChartTypes.FirstOrDefault(t => t.Code == c.ChartType)?.DivisionalFactor ?? int.MaxValue) ?? Enumerable.Empty<LoadedChart>();
 private LoadedChart? SelectedChart => _data?.Charts.GetValueOrDefault(_chartCode);
 protected override void OnParametersSet()
 {
  if(!Embedded){Nav.NavigateTo($"/key-inference/{Id}?step=karakas",replace:true);return;}
  _data=WorkspaceData.Load(Id,BirthDetailsRepo,ChartResultsRepo,ChartKeyDetailsRepo,ChartHouseLordsRepo,ChartHouseLordInterpretationRepo,ChartAspectsRepo,ChartConjunctionsRepo,ChartMultiGrahaConjunctionRepo,ChartTypeRepo.GetAll());
  _rules=_data is null ? null : new NaisargikaKarakaRepository(ConnectionFactory).LoadActive();
  if(_data is not null && !_data.Charts.ContainsKey(_chartCode)) _chartCode=_data.Charts.ContainsKey("D1") ? "D1" : _data.Charts.Keys.First();
  if(_data is null){Active.Clear();return;} var p=_data.Person; Active.Set(Id,p.Name,$"{p.DateOfBirth:dd MMM yyyy} · {p.TimeOfBirth:HH\\:mm} · {p.PlaceCity}, {p.PlaceCountry}");
 }
 private void ChangeChart(ChangeEventArgs e) => _chartCode=e.Value?.ToString()??"D1";
 private void ShowPolar() => _view = "polar";
 private void ShowSouth() => _view = "south";
 private static IReadOnlyList<PolarGridLagnaSelect.Sector> BuildSectors(LoadedChart c)
 {
  string[] signs={"Aries","Taurus","Gemini","Cancer","Leo","Virgo","Libra","Scorpio","Sagittarius","Capricornus","Aquarius","Pisces"};
  var lagnaIndex=Array.FindIndex(signs,s=>string.Equals(s,c.AscendantSign,StringComparison.OrdinalIgnoreCase));
  if(lagnaIndex<0) lagnaIndex=0;
  return Enumerable.Range(1,12).Select(h=>new PolarGridLagnaSelect.Sector(h,signs[(lagnaIndex+h-1)%12])).ToList();
 }
 private static IReadOnlyList<PolarGridLagnaSelect.PlanetPlacement> BuildPlanetPlacements(LoadedChart c) => c.Grahas
  .Where(k=>k.Planet!="Ascendant")
  .Select(k=>new PolarGridLagnaSelect.PlanetPlacement(k.Planet,k.Sign,k.DignityStatus)).ToList();
 private static IReadOnlyList<PolarGridLagnaSelect.ReferencePoint> BuildReferencePoints(LoadedChart c,IReadOnlyList<LagnaReferenceRow> definitions)
 {
  var points=c.SpecialPoints.Where(p=>p.PointKind is "SpecialLagna" or "Arudha").ToDictionary(p=>p.Planet,p=>p.Sign,StringComparer.OrdinalIgnoreCase);
  return definitions.Where(d=>d.ReferenceCode=="LAGNA"||d.Abbreviation is not null&&points.ContainsKey(d.Abbreviation))
   .Where(d=>d.AppliesInVarga=="Any"||d.AppliesInVarga=="Rasi"&&c.ChartType=="D1"||d.AppliesInVarga=="Navamsa"&&c.ChartType=="D9")
   .Where(d=>d.ReferenceCode is "LAGNA" or "ARUDHA_LAGNA" or "HORA_LAGNA" or "SREE_LAGNA" or "GHATI_LAGNA")
   .Select(d=>new PolarGridLagnaSelect.ReferencePoint(d.ReferenceCode,d.ReferenceCode=="LAGNA"?"Sign Lagna":d.ReferenceName,d.ReferenceCode=="LAGNA"?c.AscendantSign:points[d.Abbreviation!])).ToList();
 }

 /// <summary>All 4 special lagnas (BL/HL/GL/SL — tbl_Dim_SpecialLagnas) with their computed
 /// position (tbl_Chart_KeyDetails, PointKind='SpecialLagna') and classical signification
 /// (tbl_Dim_HouseReference.Perspective, PVR sec 7.3). Unlike <see cref="BuildReferencePoints"/>
 /// (which only marks Hora/Sree/Ghati on the wheel diagram — Bhaava is PVR "for completeness"
 /// only), this table surfaces all four, previously computed but never shown anywhere.</summary>
 private static IReadOnlyList<SpecialLagnaRow> BuildSpecialLagnaRows(LoadedChart c,IReadOnlyList<LagnaReferenceRow> definitions)
 {
  var points=c.SpecialPoints.Where(p=>p.PointKind=="SpecialLagna").ToDictionary(p=>p.Planet,StringComparer.OrdinalIgnoreCase);
  return definitions.Where(d=>d.Abbreviation is not null&&points.ContainsKey(d.Abbreviation))
   .Where(d=>d.AppliesInVarga=="Any"||d.AppliesInVarga=="Rasi"&&c.ChartType=="D1"||d.AppliesInVarga=="Navamsa"&&c.ChartType=="D9")
   .OrderBy(d=>d.SortOrder)
   .Select(d=>{var p=points[d.Abbreviation!];return new SpecialLagnaRow(d.Abbreviation!,d.ReferenceName,p.Sign,p.HouseNumberFromLagna,p.DegreesInSignDisplay??"—",d.Perspective);})
   .ToList();
 }
 private sealed record SpecialLagnaRow(string Code,string Name,string Sign,int House,string Degree,string Signifies);
}