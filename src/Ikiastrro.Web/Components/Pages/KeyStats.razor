@page "/key-stats/{Id:int}"
@inject NavigationManager Nav

@* Key Stats now lives inside Key Inference as its POPULATION view (2026-10-08 consolidation);
   this route stays so existing links keep working. *@

@code {
    [Parameter] public int Id { get; set; }

    protected override void OnInitialized() =>
        Nav.NavigateTo($"/key-inference/{Id}?view=stats", replace: true);
}
