@page "/transit-wheel"
@page "/transit-wheel/{Id:int}"
@using System.Globalization
@using Ikiastrro.Core.Models
@using Ikiastrro.Core.Engines.Astronomy
@inject BirthDetailsRepository BirthDetailsRepo
@inject AstrologerEvidenceRepository EvidenceRepo
@inject Ikiastrro.Data.GocharaRepository Gochara
@inject ActivePerson Active
@inject NavigationManager Nav

@* v2 Transit landing — docs/ui/components/transit.md. The page a person lands on from Home.
   Left column places the hand-authored transit wheel (a Codex Components/Charts/** component —
   static placeholder here); right column is a two-tab persisted-rows table. No astrology is
   computed on this page (docs/architecture/domain-contracts.md). *@

<PageTitle>@(_personName ?? "Transit") · D1 Birth Chart</PageTitle>

@if (_error is not null)
{
    <section class="tw-unavailable" role="status">
        <h1 class="transit-heading">TRANSIT - D1 BIRTH CHART</h1>
        <p>@_error</p>
        <a href="/">Choose a saved person</a>
    </section>
}
else
{
    <h1 class="transit-heading">TRANSIT - D1 BIRTH CHART</h1>

    <div class="tw-grid">
        <div class="tw-wheel">
            @* Codex (Components/Charts/**): replace this placeholder with the live natal ↔ transit
               wheel component. This page only places it (docs/ui/components/transit.md). *@
            <img src="/ikiastrro-transit-wheel.svg" alt="Natal and transit wheel" />
            <p class="tw-wheel-note">Natal ↔ transit overlay pending (charts component).</p>
        </div>

        <div class="tw-tables">
            <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" Class="tw-tabs">
                <MudTabPanel Text="D1 Birth">
                    @if (_positions is null || _positions.Rows.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="tw-alert">
                            Generate a D1 chart for this person first.
                        </MudAlert>
                    }
                    else
                    {
                        <div class="tw-scroll">
                            <MudSimpleTable Dense="true" Hover="true" Bordered="false" Class="tw-table">
                                <thead>
                                    <tr>
                                        <th>House</th><th>Planet</th><th>Motion</th><th>Degree</th>
                                        <th>Sign</th><th>Nakṣatra</th><th>Nak. Pad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in D1Rows)
                                    {
                                        <tr>
                                            <td class="num">@(Str(r, "HouseNumberFromLagna") ?? "—")</td>
                                            <td>@(Str(r, "Planet") ?? "—")</td>
                                            <td>@MotionCell(r)</td>
                                            <td class="num">@(Str(r, "DegreesInSignDisplay") ?? "—")</td>
                                            <td>@(Str(r, "Sign") ?? "—")</td>
                                            <td>@(Str(r, "Nakshatra") ?? "—")</td>
                                            <td class="num">@(Str(r, "NakshatraPada") ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </div>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Current Transit">
                    @if (_transitError is not null || _transits.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="tw-alert">
                            Transit reference not backfilled — run <code>backfill-planet-transits</code>.
                        </MudAlert>
                    }
                    else
                    {
                        <p class="tw-asof">as of @_asOfUtc.ToString("dd MMM yyyy HH:mm 'UTC'", CultureInfo.InvariantCulture)</p>
                        <div class="tw-scroll">
                            <MudSimpleTable Dense="true" Hover="true" Bordered="false" Class="tw-table">
                                <thead>
                                    <tr>
                                        <th>House<br />from D1</th><th>Planet</th><th>Motion</th><th>Degree</th>
                                        <th>Speed<br />°/day</th><th>In sign<br />since</th>
                                        <th>In-sign<br />motion</th><th>Next<br />change</th><th>Next-change<br />motion</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in TransitRows)
                                    {
                                        <tr>
                                            <td class="num">@(HouseFromD1(s)?.ToString() ?? "—")</td>
                                            <td>@s.Planet</td>
                                            <td>@s.MotionDirection</td>
                                            <td class="num">@SignName(s.SignId) @s.DegreeInSign.ToString("0.00", CultureInfo.InvariantCulture)°</td>
                                            <td class="num">@s.SpeedDegreesPerDay.ToString("0.0000", CultureInfo.InvariantCulture)</td>
                                            <td class="num">@s.InSignSinceUtc.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</td>
                                            <td>—</td>
                                            <td class="num">@(s.NextChangeUtc?.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) ?? "—")</td>
                                            <td>—</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </div>
                        <p class="tw-pending">
                            <em>In-sign motion</em> and <em>Next-change motion</em> arrive with the
                            <code>tbl_TransitPositionReference</code> boundary-motion columns (Codex).
                        </p>
                    }
                </MudTabPanel>
            </MudTabs>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private string? _personName;
    private string? _error;
    private string? _transitError;
    private EvidenceTableData? _positions;
    private Dictionary<string, string> _natalSignByPlanet = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<PlanetTransitSnapshot> _transits = Array.Empty<PlanetTransitSnapshot>();
    private DateTime _asOfUtc = DateTime.UtcNow;

    private static readonly string[] SignById =
        { "", "Aries", "Taurus", "Gemini", "Cancer", "Leo", "Virgo", "Libra", "Scorpio",
          "Sagittarius", "Capricorn", "Aquarius", "Pisces" };

    protected override void OnParametersSet()
    {
        _error = _transitError = null;

        if (Id is not int id)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        var person = BirthDetailsRepo.GetAll().FirstOrDefault(p => p.Id == id);
        if (person is null)
        {
            Active.Clear();
            _error = "This saved person could not be found.";
            return;
        }

        _personName = person.Name;
        var birthLine =
            $"{person.DateOfBirth:dd MMM yyyy} · {person.TimeOfBirth:HH\\:mm} · {person.PlaceCity}, {person.PlaceCountry}";
        Active.Set(id, person.Name, birthLine);

        var evidence = EvidenceRepo.Load(id, "D1");
        _positions = evidence?.Sections.FirstOrDefault(s => s.Code == "positions");
        _natalSignByPlanet = (_positions?.Rows ?? Enumerable.Empty<IReadOnlyDictionary<string, object?>>())
            .Where(r => Str(r, "Planet") is not null && Str(r, "Sign") is not null)
            .GroupBy(r => Str(r, "Planet")!, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => Str(g.First(), "Sign")!, StringComparer.OrdinalIgnoreCase);

        _asOfUtc = DateTime.UtcNow;
        try
        {
            _transits = Gochara.GetSnapshots(_asOfUtc);
        }
        catch (Exception ex)
        {
            _transitError = ex.Message;
            _transits = Array.Empty<PlanetTransitSnapshot>();
        }
    }

    // D1 Birth: grahas plus the Lagna row, ordered slow → fast (Lagna first).
    private IEnumerable<IReadOnlyDictionary<string, object?>> D1Rows =>
        (_positions?.Rows ?? Enumerable.Empty<IReadOnlyDictionary<string, object?>>())
        .Where(r =>
        {
            var pk = Str(r, "PointKind");
            var pl = Str(r, "Planet");
            return string.Equals(pk, "Graha", StringComparison.OrdinalIgnoreCase)
                || string.Equals(pl, "Lagna", StringComparison.OrdinalIgnoreCase)
                || string.Equals(pl, "Ascendant", StringComparison.OrdinalIgnoreCase);
        })
        .OrderBy(r => TransitLandingMath.PlanetRank(Str(r, "Planet")));

    private IEnumerable<PlanetTransitSnapshot> TransitRows =>
        _transits.OrderBy(s => TransitLandingMath.PlanetRank(s.Planet.ToString()));

    private int? HouseFromD1(PlanetTransitSnapshot s) =>
        TransitLandingMath.HouseFromD1(
            _natalSignByPlanet.GetValueOrDefault(s.Planet.ToString()), SignName(s.SignId));

    private string MotionCell(IReadOnlyDictionary<string, object?> r)
    {
        var planet = Str(r, "Planet");
        if (string.Equals(planet, "Lagna", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(planet, "Ascendant", StringComparison.OrdinalIgnoreCase)) return "—";
        return TransitLandingMath.FormatMotion(Flag(r, "IsRetrograde"), Flag(r, "IsCombust"));
    }

    private static string SignName(byte id) => id >= 1 && id <= 12 ? SignById[id] : "—";

    private static string? Str(IReadOnlyDictionary<string, object?> row, string key) =>
        row.TryGetValue(key, out var v) && v is not null and not DBNull
            ? Convert.ToString(v, CultureInfo.InvariantCulture)
            : null;

    private static bool Flag(IReadOnlyDictionary<string, object?> row, string key) =>
        row.TryGetValue(key, out var v) && v is not null and not DBNull && Convert.ToBoolean(v);
}
