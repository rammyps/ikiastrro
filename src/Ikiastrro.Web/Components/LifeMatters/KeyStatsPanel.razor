@using Ikiastrro.Data.Statistics
@inject PopulationEvidenceRepository PopulationEvidenceRepo
@inject LifeMatterPopulationEvidenceRepository LifeMatterEvidenceRepo
@inject DashaMatterPopulationEvidenceRepository DashaMatterEvidenceRepo
@inject LifeMatterReferenceRepository LifeMatterReferenceRepo
@inject LifeMatterFocusRepository LifeMatterFocusRepo

@* Key Stats tab — the latest v10 statistical build (v10-statisticalbuild.md) for the active
   person: where each D1 house's support sits among the eligible reference population, from the
   latest completed analytics run. Read-only; reuses PopulationEvidenceCard, so the unenrolled /
   ineligible / no-run / insufficient-data / available states and the "never render a missing
   percentile as zero" rule are the same as on Key Inference. *@

<div class="ks-card">
        @if (!_snapshot.IsAvailable)
        {
            <section class="ks-unlock" aria-label="What unlocks population statistics">
                <h2 class="ks-unlock-title">Population statistics are not available yet</h2>
                <p class="ks-unlock-lead">@PopulationEvidenceText.Message(_snapshot)</p>
                <ol class="ks-steps">
                    @foreach (var step in KeyStatsLogic.UnlockSteps(_snapshot))
                    {
                        <li class="@(step.Done ? "is-done" : "")">
                            <span class="ks-step-mark" aria-hidden="true">@(step.Done ? "✓" : "○")</span>
                            <span>@step.Text</span>
                        </li>
                    }
                </ol>
                <a class="ks-unlock-link" href="/charts">Open Saved Charts to manage enrolment</a>
            </section>
        }
        else
        {
            <section class="ks-summary" aria-label="Summary">
                <div class="ks-chip"><small>Strongest house</small><b>@Extreme(highest: true)</b></div>
                <div class="ks-chip"><small>Weakest house</small><b>@Extreme(highest: false)</b></div>
                <div class="ks-chip"><small>Limited reference data</small><b>@_rows.Count(KeyStatsLogic.IsThin) of @_rows.Count houses</b></div>
            </section>
            <div class="ks-filters" role="group" aria-label="Filter houses">
                @foreach (var (key, label) in Filters)
                {
                    <button type="button" class="ks-filter @(_filter == key ? "is-on" : "")" aria-pressed="@(_filter == key)"
                            @onclick="() => _filter = key">@label <small>@Count(key)</small></button>
                }
            </div>
            <p class="ks-meaning"><b>What this means.</b> Each percentile shows where this chart's house support sits among comparable saved charts. It describes position in a population, not an outcome probability, and it is withheld where fewer than 30 people were measured. House titles open the matching Key Inference reading.</p>
            <PopulationEvidenceCard Snapshot="_snapshot" Rows="Shown()" HouseLink="HouseHref" />
            @if (_matterGroups.Count > 0)
            {
                <section class="ks-matters" aria-label="Life matters">
                    <h2 class="ks-matters-title">Life matters</h2>
                    <p class="ks-meaning">Overall support for each life matter among comparable saved charts, first from the D1 promise and then from the Varga confirmation. A percentile is a position in the population, not an outcome probability.</p>
                    <ul class="ks-matter-list">
                        @foreach (var (code, name, rows) in _matterGroups)
                        {
                            <li class="ks-matter">
                                <b class="ks-matter-name">@name</b>
                                @foreach (var c in rows)
                                {
                                    <div class="ks-matter-row @(KeyStatsLogic.IsThin(c) ? "is-thin" : "")">
                                        <span class="ks-matter-lens">@KeyStatsLogic.LensLabel(c.EvidenceLensCode) <small>@c.ChartType</small></span>
                                        <span class="ks-matter-pct">@(c.Percentile is null ? "Not published" : PopulationStrip.Ordinal(c.Percentile) + " percentile")</span>
                                        <small class="ks-matter-note">@KeyStatsLogic.Reliability(c)@(KeyStatsLogic.IsThin(c) ? " · limited reference data" : "")</small>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                    @if (_matterSnapshot.CompletedAtUtc is { } done)
                    {
                        <details class="pop-prov"><summary>Provenance</summary>
                            <p>Dataset @_matterSnapshot.DatasetCode v@_matterSnapshot.DatasetVersion · feature @_matterSnapshot.FeatureContractVersion · rule set @_matterSnapshot.RuleSetId · run @_matterSnapshot.AnalyticsRunId · @done.ToString("dd MMM yyyy") UTC</p>
                        </details>
                    }
                </section>
            }
            @if (_dashaGroups.Count > 0)
            {
                <section class="ks-matters" aria-label="Dasha matters">
                    <h2 class="ks-matters-title">Dasha matters</h2>
                    <p class="ks-meaning">How many planets in this chart meet each natal dasha-matter rule, and how common that rule is among comparable saved charts. This describes the chart's structure and its prevalence in a population. It is not a prediction, and it does not say which period is running.</p>
                    @foreach (var (heading, items) in _dashaGroups)
                    {
                        <h3 class="ks-dasha-heading">@heading</h3>
                        <ul class="ks-matter-list">
                            @foreach (var d in items)
                            {
                                <li class="ks-matter">
                                    <b class="ks-matter-name">@d.Statement <small>@d.Varga</small></b>
                                    <div class="ks-matter-row @(d.IsThin ? "is-thin" : "")">
                                        <span class="ks-matter-lens">@d.Result</span>
                                        <span class="ks-matter-pct">@(d.PlanetCount is { } n ? $"{n:0} planet{(n == 1 ? "" : "s")}" : "Not evaluated")</span>
                                        <small class="ks-matter-note">@(d.PresentPercent is { } p ? $"Present in {p:0}% of other comparable charts · " : "")@d.Reliability@(d.IsThin ? " · limited reference data" : "")</small>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    @if (_dashaSnapshot.CompletedAtUtc is { } finished)
                    {
                        <details class="pop-prov"><summary>Provenance</summary>
                            <p>Dataset @_dashaSnapshot.DatasetCode v@_dashaSnapshot.DatasetVersion · feature @_dashaSnapshot.FeatureContractVersion · rule set @_dashaSnapshot.RuleSetId · run @_dashaSnapshot.AnalyticsRunId · @finished.ToString("dd MMM yyyy") UTC</p>
                        </details>
                    }
                </section>
            }
        }
</div>

@code {
    [Parameter, EditorRequired] public int Id { get; set; }
    /// <summary>Development preview only: render this snapshot instead of reading the latest run.</summary>
    [Parameter] public PopulationEvidenceSnapshot? PreviewSnapshot { get; set; }

    private PopulationEvidenceSnapshot _snapshot = default!;
    private IReadOnlyList<PopulationComparison> _rows = [];
    private LifeMatterPopulationEvidenceSnapshot _matterSnapshot = default!;
    private IReadOnlyList<(string Code, string Name, IReadOnlyList<LifeMatterPopulationComparison> Rows)> _matterGroups = [];
    private DashaMatterPopulationEvidenceSnapshot _dashaSnapshot = default!;
    private IReadOnlyList<(string Heading, IReadOnlyList<KeyStatsLogic.DashaMatterItem> Items)> _dashaGroups = [];
    private IReadOnlyDictionary<int, string> _houseMatters = new Dictionary<int, string>();
    private string _filter = "all";

    private static readonly (string Key, string Label)[] Filters =
        [("all", "All"), ("notable", "Notable"), ("thin", "Thin")];

    // A house's title opens the matter that reads most specifically from that house (Lagna perspective).
    private string? HouseHref(byte house) =>
        _houseMatters.TryGetValue(house, out var matter)
            ? KeyInferenceLink.Url(Id, matter, "LAGNA", null) + "&view=reading"
            : null;

    private int Count(string key) => KeyStatsLogic.Filter(_rows, key).Count();

    // Rows stay in house order (1–12); the card lays them out four to a row, so 1–4 / 5–8 / 9–12.
    private IReadOnlyList<PopulationComparison> Shown() => KeyStatsLogic.Filter(_rows, _filter).ToList();

    private string Extreme(bool highest) =>
        KeyStatsLogic.Extreme(_rows, highest) is { } c
            ? $"House {c.HouseFromLagna} · {PopulationStrip.Ordinal(c.Percentile)} percentile"
            : "Not published";

    protected override void OnParametersSet()
    {
        _snapshot = PreviewSnapshot ?? PopulationEvidenceRepo.GetLatestForBirthDetail(Id);
        // Life-matter run is independent of the house run; a development preview never reads it.
        _matterSnapshot = LifeMatterEvidenceRepo.GetLatestForBirthDetail(Id);
        _matterGroups = PreviewSnapshot is null && _matterSnapshot.IsAvailable
            ? KeyStatsLogic.MatterGroups(_matterSnapshot.Comparisons) : [];
        _dashaSnapshot = DashaMatterEvidenceRepo.GetLatestForBirthDetail(Id);
        _dashaGroups = PreviewSnapshot is null && _dashaSnapshot.IsAvailable
            ? KeyStatsLogic.DashaGroups(_dashaSnapshot.Comparisons) : [];
        const byte ruleSetId = 1;
        _houseMatters = KeyStatsLogic.BestMatterByHouse(
            LifeMatterReferenceRepo.GetAllSteps(ruleSetId), LifeMatterFocusRepo.GetFoci(ruleSetId),
            LifeMatterReferenceRepo.GetCategories(ruleSetId));
        var feature = _snapshot.Comparisons
            .Select(c => c.FeatureCode)
            .Where(f => f is "KI_D1_HOUSE_SUPPORT_V1" or "KI_D1_HOUSE_SUPPORT_V2")
            .OrderByDescending(f => f).FirstOrDefault();
        _rows = _snapshot.Comparisons
            .Where(c => c.FeatureCode == feature)
            .OrderBy(c => c.HouseFromLagna)
            .ToList();
    }
}
