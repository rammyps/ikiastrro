@using Ikiastrro.Core.Models
@* The 6 DB-sourced life-area categories (tbl_Dim_ChartType.Category, migration 25), each a
   Disclosure of MiniGrid tiles — replaces the old hardcoded classical Shadvarga/Saptavarga/
   Dasavarga/Shodasavarga/Extra-vargas bundles (rammyps's call, 2026-09-05; see VargaBundles.cs).
   A varga appears once, in its one Category. Missing chart -> EmptyState tile. *@
<div class="rail">
    @foreach (var (title, codes) in VargaBundles.Groups(ChartTypes))
    {
        <Disclosure Title="@title" Open="@(_open.Contains(title))" OnToggle="v => SetOpen(title, v)">
            <div class="rail-tiles">
                @foreach (var code in codes)
                {
                    @if (Charts.TryGetValue(code, out var lc))
                    {
                        <MiniGrid PlanetsBySign="GlyphsBySign(lc)" LagnaSign="@lc.AscendantSign"
                                  Href="@(code == "D1" ? $"/charts/{PersonId}" : $"/charts/{PersonId}/varga/{code}")"
                                  Caption="@Caption(code)" />
                    }
                    else
                    {
                        <div class="rail-missing">
                            <EmptyState Message="@($"{code} not computed")" Cli="backfill-charts" />
                        </div>
                    }
                }
            </div>
        </Disclosure>
    }
</div>

@code {
    [Parameter, EditorRequired] public int PersonId { get; set; }
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, LoadedChart> Charts { get; set; }
        = new Dictionary<string, LoadedChart>();

    /// <summary>tbl_Dim_ChartType rows — drives both the Category grouping (VargaBundles.Groups)
    /// and each tile's ChartShortDescription caption.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ChartTypeRow> ChartTypes { get; set; }
        = Array.Empty<ChartTypeRow>();

    /// <summary>Open by default: whichever Category D1 falls into ("Self &amp; Personality" as
    /// seeded by migration 25) — was "Shadvarga (6)" back when groups were the classical bundles.</summary>
    private HashSet<string> _open = new();
    private void SetOpen(string title, bool open) { if (open) _open.Add(title); else _open.Remove(title); }

    protected override void OnParametersSet()
    {
        if (_open.Count == 0)
        {
            var d1Category = ChartTypes.FirstOrDefault(t => t.Code == "D1")?.Category;
            if (d1Category is not null) _open.Add(d1Category);
        }
    }

    private static IReadOnlyDictionary<string, IReadOnlyList<string>> GlyphsBySign(LoadedChart lc) =>
        lc.Grahas.Where(k => k.Planet != "Ascendant")
            .GroupBy(k => k.Sign)
            .ToDictionary(g => g.Key, g => (IReadOnlyList<string>)g.Select(k => k.Planet).ToList());

    /// <summary>"D9 · Marriage / Dharma" — code + ChartShortDescription (the DB-sourced "Area"
    /// half of the Category-Area mapping), falling back to just the code when a chart type has no
    /// ChartShortDescription yet.</summary>
    private string Caption(string code)
    {
        var shortDesc = ChartTypes.FirstOrDefault(t => string.Equals(t.Code, code, StringComparison.OrdinalIgnoreCase))?.ChartShortDescription;
        return string.IsNullOrWhiteSpace(shortDesc) ? code : $"{code} · {shortDesc}";
    }
}
