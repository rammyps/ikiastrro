@inherits LayoutComponentBase
@implements IDisposable
@inject ActivePerson Active
@inject NavigationManager Nav
@inject BirthDetailsRepository BirthDetailsRepo

@* MudBlazor providers must sit in the interactive render scope (this layout is rendered by
   the InteractiveServer <Routes>). Kept out of App.razor, which is static SSR — see the note
   there. Without this, every MudSelect / MudDatePicker / MudTimePicker popover fails to open. *@
<MudThemeProvider Theme="Ikiastrro.Web.Components.IkiastrroTheme.Value" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Class="ik-appbar">
        <div class="ik-header-start">
            <nav class="ik-globalnav" aria-label="Main">
                <a href="/" class="ik-headtab @(CurrentPath == "/" ? "is-here" : "")">HOME</a>
            </nav>
            @if (Active.Id is int personId)
            {
                <nav class="ik-tabs" aria-label="Person sections">
                    @* ALL CHARTS is the divisional-chart gallery. Karakas and special Lagna
                       interpretation now live together as Step 4 inside KEY INFERENCE. *@
                    <a href="@($"/charts/{personId}")" class="ik-headtab @TabClass("charts")"><span>ALL</span> <span>CHARTS</span></a>
                    <a href="@($"/key-inference/{personId}")" class="ik-headtab @TabClass("keyinf")"><span>KEY</span> <span>INFERENCE</span></a>
                </nav>
            }
        </div>
        <span class="ik-brand">Iki-Astrro<span class="ik-tagline">&nbsp;| Where Passion, Purpose &amp; Planets Align.</span></span>
        <nav class="ik-header-save" aria-label="Saved charts">
            <a href="/charts" class="ik-headtab @(CurrentPath == "/charts" ? "is-here" : "")"><span>SAVED</span> <span>CHARTS</span></a>
        </nav>
    </MudAppBar>
    <MudMainContent>
        @if (Active is { Id: not null, Name: not null })
        {
            <div class="ik-band">
                <div class="ik-band-inner">
                    <div class="ik-person-wrap">
                        <button type="button" class="ik-person" @onclick="TogglePersonMenu"
                                aria-haspopup="listbox" aria-expanded="@_personMenuOpen" title="Switch person">
                            <span class="ik-person-name">@Active.Name</span>
                            <span class="ik-person-caret" aria-hidden="true">▾</span>
                        </button>
                        @if (_personMenuOpen)
                        {
                            <ul class="ik-person-menu" role="listbox">
                                @if (OtherPeople.Count == 0)
                                {
                                    <li class="ik-person-menu-empty">No other saved people</li>
                                }
                                else
                                {
                                    @foreach (var p in OtherPeople)
                                    {
                                        <li>
                                            <button type="button" @onclick="() => GoToPerson(p.Id)">
                                                <span class="ik-person-menu-name">@p.Name</span>
                                                <span class="ik-person-menu-birth">@p.DateOfBirth.ToString("dd MMM yyyy")</span>
                                            </button>
                                        </li>
                                    }
                                }
                                <li class="ik-person-menu-all">
                                    <button type="button" @onclick="GoToPicker">All saved people…</button>
                                </li>
                            </ul>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Active.BirthLine))
                    {
                        <span class="ik-person-birth">@Active.BirthLine</span>
                    }
                </div>
            </div>
            @if (_personMenuOpen)
            {
                <div class="ik-person-scrim" @onclick="ClosePersonMenu"></div>
            }
        }
        <div class="ik-page">
            @Body
        </div>
        <footer class="ik-footer">
            <div class="ik-footer-inner">
                <span class="ik-footer-line">Dedicated to my guru (Sundari Hemachandran)<span class="ik-footer-by"> — By Ramakrishnan P</span></span>
            </div>
        </footer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    <MudAlert Severity="Severity.Error">An unhandled error has occurred. <a href="" class="reload">Reload</a></MudAlert>
</div>

@code {
    // Route-relative path with no query/hash and no trailing slash, always leading "/".
    private string CurrentPath =>
        "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');

    protected override void OnInitialized()
    {
        Active.Changed += OnShellChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnShellChanged() => InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    // "Ramya ▾" opens a real dropdown of the other saved people (rammyps, per the mockup)
    // instead of just linking back to the picker page. Queried fresh each time it opens, not
    // cached, so a person saved/deleted elsewhere shows up without a reload.
    private bool _personMenuOpen;
    private IReadOnlyList<BirthDetails> OtherPeople { get; set; } = Array.Empty<BirthDetails>();

    private void TogglePersonMenu()
    {
        _personMenuOpen = !_personMenuOpen;
        OtherPeople = _personMenuOpen
            ? BirthDetailsRepo.GetAll().Where(p => p.Id != Active.Id)
                .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase).ToList()
            : Array.Empty<BirthDetails>();
    }

    private void ClosePersonMenu() => _personMenuOpen = false;

    private void GoToPerson(int id)
    {
        _personMenuOpen = false;
        Nav.NavigateTo($"/key-inference/{id}");
    }

    private void GoToPicker()
    {
        _personMenuOpen = false;
        Nav.NavigateTo("/");
    }

    private string TabClass(string key)
    {
        var p = CurrentPath;
        var here = key switch
        {
            "keyinf"  => p.Contains("/timing", StringComparison.Ordinal) || p.Contains("/key-inference", StringComparison.Ordinal),
            "charts"  => p.StartsWith("/charts", StringComparison.Ordinal)
                         && !p.Contains("/timing", StringComparison.Ordinal)
                         && !p.Contains("/key-inference", StringComparison.Ordinal),
            _ => false
        };
        return here ? "is-here" : "";
    }

    public void Dispose()
    {
        Active.Changed -= OnShellChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
