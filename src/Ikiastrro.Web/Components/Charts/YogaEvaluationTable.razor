@using System.Globalization
@using Ikiastrro.Data

<section class="yg" aria-labelledby="yg-title">
    <article class="yg-card">
        <header class="yg-card-head">
            <div>
                <h2 id="yg-title">Yogas Present</h2>
                <p>@PresentRows.Count formed of @EvaluatedCount evaluated (@NotEvaluatedCount not yet evaluated)</p>
            </div>
        </header>
        @if (PresentRows.Count == 0)
        {
            <p class="yg-empty">No yogas from the evaluated corpus are present in this chart.</p>
        }
        else
        {
            <div class="yg-table-scroll">
                <table>
                    <thead><tr><th>Type</th><th>Yoga</th><th>Rule</th><th>Interpretation</th><th>Source</th></tr></thead>
                    <tbody>
                        @foreach (var r in PresentRows)
                        {
                            var interp = Resolve(r.YogaCode, r.SourceRefCode);
                            <tr>
                                <td>@(r.YogaTypeCode ?? "—")</td>
                                <td>@DisplayYoga(r.YogaCode)</td>
                                <td>
                                    @(r.YogaRule ?? "—")
                                    @if (string.Equals(r.YogaTypeCode, "LAGNA", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(LagnaLordPlanet))
                                    {
                                        <div class="yg-lagnalord">Lagna lord: @LagnaLordPlanet</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(r.Notes))
                                    {
                                        <div class="yg-notes">@r.Notes</div>
                                    }
                                </td>
                                <td class="yg-interp">
                                    @if (interp is not null)
                                    {
                                        <InterpretationText StandardText="@interp.StandardText" ShortText="@interp.ShortText" />
                                    }
                                    else
                                    {
                                        <span class="yg-interp-empty">—</span>
                                    }
                                    <EditIconButton Title="@($"Edit interpretation for {DisplayYoga(r.YogaCode)} ({DisplaySource(r.SourceRefCode)})")"
                                                     OnClick="() => StartEdit(r, interp)" />
                                </td>
                                <td class="yg-source">@DisplaySource(r.SourceRefCode)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </article>
</section>

@if (_editRow is not null && !_pendingSave)
{
    <div class="yg-edit-backdrop" @onclick="CancelEdit">
        <div class="yg-edit-box" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <h2 class="yg-edit-title">Interpretation — @DisplayYoga(_editRow.YogaCode) (@DisplaySource(_editRow.SourceRefCode))</h2>

            <label class="yg-edit-field">
                <span>Standard text (desktop, up to 500 characters)</span>
                <textarea @bind="_editStandardText" @bind:event="oninput" maxlength="500" rows="4"></textarea>
            </label>
            <label class="yg-edit-field">
                <span>Short text (mobile/tablet, up to 160 characters)</span>
                <textarea @bind="_editShortText" @bind:event="oninput" maxlength="160" rows="2"></textarea>
            </label>

            @if (_editError is not null)
            {
                <p class="yg-edit-error">@_editError</p>
            }

            <div class="yg-edit-actions">
                <button type="button" class="btn-cancel" @onclick="CancelEdit">Cancel</button>
                <button type="button" class="btn-confirm" @onclick="RequestSave">Save</button>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsOpen="_pendingSave"
               Message="@ConfirmMessage"
               ConfirmLabel="Save" BusyLabel="Saving…"
               IsBusy="_isSaving" OnConfirm="ConfirmSave" OnCancel="() => _pendingSave = false" />

@code {
    [Parameter, EditorRequired] public IReadOnlyList<YogaEvaluationRow> Rows { get; set; } = Array.Empty<YogaEvaluationRow>();
    [Parameter] public string? LagnaLordPlanet { get; set; }
    [Parameter] public IReadOnlyList<InterpretationRow> Interpretations { get; set; } = Array.Empty<InterpretationRow>();
    [Parameter] public EventCallback<InterpretationEditRequest> OnSaveInterpretation { get; set; }

    public sealed record InterpretationEditRequest(string SubjectCode, string? SourceRefCode, string StandardText, string ShortText);

    // A YogaCode can be evaluated against several classical source citations independently (e.g.
    // Daridra matches Raman's combinations #148/#149/#151/#152 separately) — each becomes its
    // own row in vw_ChartYogaEvaluations, sharing the same YogaCode/Name/Rule. Group by YogaCode
    // so the same yoga isn't listed multiple times; a yoga counts as present/evaluated if any of
    // its source citations does, so a variant that didn't match never hides one that did.
    private IEnumerable<IGrouping<string, YogaEvaluationRow>> ByYoga =>
        Rows.GroupBy(r => r.YogaCode, StringComparer.OrdinalIgnoreCase);

    // rammyps's requested default order: Lagna, Sun, Moon, Combination first, any other
    // YogaTypeCode that shows up later follows alphabetically after those four.
    private static readonly string[] TypeOrder = { "LAGNA", "SUN", "MOON", "COMBINATION" };

    private static int TypeRank(string? type)
    {
        var i = Array.IndexOf(TypeOrder, type?.ToUpperInvariant() ?? string.Empty);
        return i < 0 ? TypeOrder.Length : i;
    }

    private IReadOnlyList<YogaEvaluationRow> PresentRows =>
        ByYoga.Where(g => g.Any(r => r.Present == true))
            .Select(g => g.First(r => r.Present == true))
            .OrderBy(r => TypeRank(r.YogaTypeCode)).ThenBy(r => r.YogaTypeCode).ThenBy(r => r.YogaCode)
            .ToList();

    private int EvaluatedCount => ByYoga.Count(g => g.Any(r => r.EvaluationStatus == "EVALUATED"));
    private int NotEvaluatedCount => ByYoga.Count(g => !g.Any(r => r.EvaluationStatus == "EVALUATED"));

    private static string DisplayYoga(string code) => CultureInfo.InvariantCulture.TextInfo.ToTitleCase(
        code.Replace("YOGA_", "", StringComparison.OrdinalIgnoreCase).Replace('_', ' ').ToLowerInvariant());

    private static string DisplaySource(string code) => CultureInfo.InvariantCulture.TextInfo.ToTitleCase(
        code.Replace("SRC_", "", StringComparison.OrdinalIgnoreCase).Replace('_', ' ').ToLowerInvariant());

    // Locally-saved edits take precedence over what the page passed in via Interpretations, so a
    // save shows immediately without waiting on the parent page to re-fetch and re-render.
    private readonly Dictionary<string, InterpretationRow> _overrides = new();

    private static string OverrideKey(string subjectCode, string? sourceRefCode) => $"{subjectCode}|{sourceRefCode}";

    private InterpretationRow? Resolve(string subjectCode, string sourceRefCode)
    {
        if (_overrides.TryGetValue(OverrideKey(subjectCode, sourceRefCode), out var exact)) return exact;
        if (_overrides.TryGetValue(OverrideKey(subjectCode, null), out var genericOverride)) return genericOverride;
        return InterpretationRepository.Resolve(Interpretations, subjectCode, sourceRefCode);
    }

    // --- interpretation edit state ---
    private YogaEvaluationRow? _editRow;
    private string _editStandardText = "";
    private string _editShortText = "";
    private string? _editError;
    private bool _pendingSave;
    private bool _isSaving;

    private string ConfirmMessage => _editRow is null ? "" :
        $"Save this interpretation for {DisplayYoga(_editRow.YogaCode)} ({DisplaySource(_editRow.SourceRefCode)})? This will be visible to everyone using this tool.";

    private void StartEdit(YogaEvaluationRow row, InterpretationRow? existing)
    {
        _editRow = row;
        _editStandardText = existing?.StandardText ?? "";
        _editShortText = existing?.ShortText ?? "";
        _editError = null;
        _pendingSave = false;
    }

    private void CancelEdit()
    {
        if (_isSaving) return;
        _editRow = null;
        _pendingSave = false;
        _editError = null;
    }

    private void RequestSave()
    {
        if (_editRow is null) return;
        if (string.IsNullOrWhiteSpace(_editStandardText) || string.IsNullOrWhiteSpace(_editShortText))
        {
            _editError = "Both the standard and short text need content.";
            return;
        }
        _editError = null;
        _pendingSave = true;
    }

    private async Task ConfirmSave()
    {
        if (_editRow is null || _isSaving) return;
        _isSaving = true;
        try
        {
            var standardText = _editStandardText.Trim();
            var shortText = _editShortText.Trim();
            var subjectCode = _editRow.YogaCode;
            var sourceRefCode = _editRow.SourceRefCode;

            await OnSaveInterpretation.InvokeAsync(new InterpretationEditRequest(subjectCode, sourceRefCode, standardText, shortText));

            _overrides[OverrideKey(subjectCode, sourceRefCode)] = new InterpretationRow(0, "YOGA", subjectCode, sourceRefCode, standardText, shortText);
            _editRow = null;
            _pendingSave = false;
        }
        finally
        {
            _isSaving = false;
        }
    }
}
