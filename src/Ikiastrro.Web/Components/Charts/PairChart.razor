@using Ikiastrro.Core.Engines.Astronomy
@using Ikiastrro.Core.Engines.Matching

@* A small South Indian D1 chart for the pair page: signs fixed in place, the Lagna sign marked, each graha
   shown by a two-letter code in the sign it sits in. Reads the same DoshaChart the matching code reads, so it
   always agrees with the numbers on the page. Facts only: no colour judgement. *@

<figure class="pc" aria-label="@Title">
    <div class="pc-grid" role="img" aria-label="@Describe()">
        @for (var sign = 0; sign < 12; sign++)
        {
            var s = sign;
            var (row, col) = Cells[s];
            <div class="pc-cell @(s == (int)Chart.Lagna ? "pc-lagna" : "")" style="grid-row:@(row + 1);grid-column:@(col + 1)">
                <span class="pc-sign">@Short[s]</span>
                @if (s == (int)Chart.Lagna) { <b class="pc-asc">Asc</b> }
                @foreach (var p in In(s)) { <span class="pc-g">@Code(p)</span> }
            </div>
        }
        <figcaption class="pc-centre">@Title</figcaption>
    </div>
</figure>

@code {
    [Parameter, EditorRequired] public DoshaChart Chart { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "Rasi (D1)";

    // South Indian layout: (row, column) of each sign, Aries at top second from left, signs running clockwise.
    private static readonly (int Row, int Col)[] Cells =
    [
        (0, 1), (0, 2), (0, 3), (1, 3), (2, 3), (3, 3),
        (3, 2), (3, 1), (3, 0), (2, 0), (1, 0), (0, 0),
    ];

    private static readonly string[] Short = ["Ari", "Tau", "Gem", "Can", "Leo", "Vir", "Lib", "Sco", "Sag", "Cap", "Aqu", "Pis"];

    private static string Code(PlanetName p) => p switch
    {
        PlanetName.Sun => "Su", PlanetName.Moon => "Mo", PlanetName.Mars => "Ma", PlanetName.Mercury => "Me",
        PlanetName.Jupiter => "Ju", PlanetName.Venus => "Ve", PlanetName.Saturn => "Sa", PlanetName.Rahu => "Ra",
        PlanetName.Ketu => "Ke", _ => p.ToString()[..2],
    };

    private IEnumerable<PlanetName> In(int sign) =>
        Chart.Signs.Where(kv => (int)kv.Value == sign).Select(kv => kv.Key).OrderBy(p => (int)p);

    private string Describe() =>
        $"{Title}: Lagna {SignLabels.For(Chart.Lagna)}; " +
        string.Join(", ", Chart.Signs.OrderBy(kv => (int)kv.Key).Select(kv => $"{kv.Key} in {SignLabels.For(kv.Value)}"));
}
