@using Ikiastrro.Core.Engines.PlanetaryStates
@using Ikiastrro.Data
@* Planetary positions for one chart. Variant "d1" includes nakshatra detail; "varga" omits it. Astro Facts 1.1 sets ShowAnalysis=false so the role and condition columns stay in 2.2 About Planets; the one condition column it does carry is ShowAvastha (D1), each graha's five avasthas with PVR 15.4's meaning, at the request of rammyps 2026-10-06. Other consumers retain analytical context by default. Special-point rows are excluded. *@
<div class="ppt-scroll">
    <table class="ppt">
        <thead>
            <tr>
                <th>Graha</th><th>Rasi</th><th>Degree</th>
                @if (Variant == "d1")
                {
                    <th>Nakshatra</th><th>Pada</th><th>Nak&nbsp;Lord</th><th>Sub&nbsp;Lord</th><th>Sub-Lord&nbsp;Chain&nbsp;(L2–L7)</th>
                }
                <th>Dir</th><th>House</th><th>House&nbsp;(Ch)</th>
                @if (ShowAnalysis && ShowDignity)
                {
                    <th>Dignity</th>
                }
                @if (ShowAnalysis)
                {
                    <th>Rules</th><th>Karaka</th><th>Aspected&nbsp;by</th>
                }
                @if (ShowAvastha)
                {
                    <th>Avasthas&nbsp;(PVR&nbsp;§15.4)</th>
                }
                @if (ShowTechnical)
                {
                    <th>Speed&nbsp;°/day</th><th>Ecl&nbsp;lat&nbsp;°</th><th>Varga&nbsp;long&nbsp;°</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Rows.Where(r => r.PointKind == "Graha"))
            {
                <tr class="@(row.Planet == "Ascendant" ? "asc" : "")">
                    <td>@(row.Planet == "Ascendant" ? "Lagna" : row.Planet)</td>
                    <td>@DisplaySign(row.Sign)</td>
                    <td class="mono">@(string.IsNullOrEmpty(row.DegreesInSignDisplay) ? "—" : row.DegreesInSignDisplay)@(row.IsCombust == true ? " 🔥" : "")</td>
                    @if (Variant == "d1")
                    {
                        <td>@(row.Nakshatra ?? "—")</td>
                        <td class="mono">@(row.NakshatraPada?.ToString() ?? "—")</td>
                        <td>@if (row.NakshatraLordPlanet is { } nakLord) { <PlanetChip Planet="@nakLord" /> } else { <span>—</span> }</td>
                        <td>@if (row.NakshatraSubLordPlanet is { } subLord) { <PlanetChip Planet="@subLord" /> } else { <span>—</span> }</td>
                        <td class="mono">@(row.SubLordChainL2ToL7 ?? "—")</td>
                    }
                    <td>@ChartViewModel.DirectionLabel(row.IsRetrograde)</td>
                    <td class="mono">@row.HouseFromLagna</td>
                    <td class="mono">@row.HouseFromMoon</td>
                    @if (ShowAnalysis && ShowDignity)
                    {
                        <td>
                            @if (row.DignityStatus is null) { <span class="muted">—</span> }
                            else { <span class="pill"><span class="dot" style="background:var(--dignity-@ChartViewModel.DignityToken(row.DignityStatus))"></span>@row.DignityStatus</span> }
                        </td>
                    }
                    @if (ShowAnalysis)
                    {
                        <td>@(row.RulesHouseNumbers ?? "—")</td>
                        <td>@(row.CharaKaraka ?? "—")</td>
                        <td class="mono asp">@(row.AspectedBy ?? "—")</td>
                    }
                    @if (ShowAvastha)
                    {
                        <td class="ppt-avastha">@AvasthaCell(row)</td>
                    }
                    @if (ShowTechnical)
                    {
                        <td class="mono">@(row.SpeedLongitudeDegPerDay?.ToString("0.0000") ?? "—")</td>
                        <td class="mono">@(row.EclipticLatitudeDegrees?.ToString("0.0000") ?? "—")</td>
                        <td class="mono">@row.VargaLongitudeDegrees.ToString("0.0000")</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PlanetRow> Rows { get; set; } = Array.Empty<PlanetRow>();
    [Parameter, EditorRequired] public string LagnaSign { get; set; } = "";
    [Parameter] public string Variant { get; set; } = "d1";
    [Parameter] public bool ShowTechnical { get; set; }
    [Parameter] public bool ShowDignity { get; set; } = true;
    [Parameter] public bool ShowAnalysis { get; set; } = true;
    /// <summary>Adds one column with each graha's five avasthas and what PVR §15.4 says each means. D1 only: the
    /// states come from the D1 chart, so the parent turns this on for D1 alone.</summary>
    [Parameter] public bool ShowAvastha { get; set; }
    [Parameter] public IReadOnlyList<PlanetaryStateFact> States { get; set; } = Array.Empty<PlanetaryStateFact>();
    [Parameter] public IReadOnlyDictionary<byte, PlanetaryStateRow> StateNames { get; set; } = new Dictionary<byte, PlanetaryStateRow>();
    [Parameter] public IReadOnlyDictionary<(byte PlanetaryStateId, byte PlanetId), PostureStateInterpretationRow> PostureInterpretations { get; set; } =
        new Dictionary<(byte PlanetaryStateId, byte PlanetId), PostureStateInterpretationRow>();

    private static string DisplaySign(string sign) => sign == "Capricornus" ? "Capricorn" : sign;

    private PlanetaryStateRow? State(byte? id) => id is { } v ? StateNames.GetValueOrDefault(v) : null;

    private RenderFragment AvasthaCell(PlanetRow row) => __builder =>
    {
        var fact = States.FirstOrDefault(f => f.Planet.Equals(row.Planet, StringComparison.OrdinalIgnoreCase));
        if (fact is null)
        {
            <span class="muted">—</span>
            return;
        }

        void Line(string label, PlanetaryStateRow? state, string? extra = null)
        {
            if (state is null) return;
            var meaning = AvasthaPvrNotes.Meaning(state.AvasthaSystem, state.StateName);
            <span class="ppt-av-line"><b>@label</b> @state.StateName@extra@if (meaning is not null) { <span class="ppt-av-meaning"> — @meaning</span> }</span>
        }

        Line("Bālādi", State(fact.AgeStateId), fact.AgeEffectFraction is { } f ? $" · {f:0.#%}" : null);
        Line("Jāgradādi", State(fact.WakefulnessStateId));
        foreach (var id in fact.DeeptadiStateIds) Line("Dīptādi", State(id));
        foreach (var id in fact.LajjitadiStateIds) Line("Lajjitādi", State(id));

        var posture = State(fact.PostureStateId);
        if (posture is not null)
        {
            var result = fact.PostureStateId is { } sid && fact.PlanetId is { } pid ? PostureInterpretations.GetValueOrDefault((sid, pid)) : null;
            <span class="ppt-av-line"><b>Śayanādi</b> @posture.StateName · @posture.SequenceOrder/12@if (!string.IsNullOrWhiteSpace(posture.Meaning)) { <span class="ppt-av-meaning"> — @posture.Meaning</span> }</span>
            @if (result is not null)
            {
                <span class="ppt-av-result">@result.InterpretationText <i>(@result.SourceRefCode @result.SourceLocator)</i></span>
            }
        }

        foreach (var text in AvasthaPvrNotes.HouseResults(fact.LajjitadiStateIds.Select(i => State(i)?.StateName ?? ""), row.HouseFromLagna))
        {
            <span class="ppt-av-result">@text</span>
        }
    };

}
