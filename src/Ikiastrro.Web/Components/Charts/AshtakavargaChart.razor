@using System.Globalization
@using Ikiastrro.Core.Presentation
@using Ikiastrro.Web.Components.Workspace

<section class="av" aria-labelledby="av-title">
    <article class="av-card">
        <header class="av-card-head">
            <div><h2 id="av-title">Sarvāṣṭavarga</h2><p class="av-context">@SelectedChart bindus · independently calculated</p></div>
            <div class="av-head-right">
                <label class="av-chart-select"><select aria-label="Chart" value="@SelectedChart" @onchange="OnChartChanged">@foreach (var chart in ChartOptions) { <option value="@chart.ChartType">@chart.Label</option> }</select></label>
                <div class="av-toggle" role="group" aria-label="Row order">
                    <button type="button" class="@(_sort == SortMode.HouseOrder ? "av-toggle-on" : "")" @onclick="() => _sort = SortMode.HouseOrder">House order</button>
                    <button type="button" class="@(_sort == SortMode.StrengthRank ? "av-toggle-on" : "")" @onclick="() => _sort = SortMode.StrengthRank">Strength rank</button>
                </div>
                <strong>@GrandTotal <span>total</span></strong>
            </div>
        </header>
        <div class="av-sav-body">
        <div class="av-south" role="img" aria-label="Sarvashtavarga bindus on a South Indian chart">
            @foreach (var cell in SouthCells)
            {
                var total = SavTotal(cell.SignNumber);
                <div class="av-south-cell @SavBand(total) @(HouseNumber(cell.SignNumber) == 1 ? "av-south-lagna" : "")" style="grid-column:@cell.Col;grid-row:@cell.Row;">
                    <span class="av-south-sign">@ShortSign(cell.SignNumber)</span>
                    <b class="av-south-val">@total</b>
                    <small class="av-south-house">H@(HouseNumber(cell.SignNumber))</small>
                </div>
            }
            <div class="av-south-center" style="grid-column:2/4;grid-row:2/4;"><strong>@GrandTotal</strong><span>@SelectedChart SAV</span></div>
        </div>
        <div class="av-bars" role="img" aria-label="Sarvashtavarga bindus by sign and house">
            @foreach (var row in SavRows)
            {
                <div class="av-bar-row">
                    <span class="av-sign"><b>@ShortSign(row.SignNumber)</b><small>H@(HouseNumber(row.SignNumber))</small></span>
                    <span class="av-track"><span class="av-fill @SavBand(row.TotalBindus)" style="width:@BarWidth(row.TotalBindus)%"></span></span>
                    <b class="av-value @SavBand(row.TotalBindus)">@row.TotalBindus</b>
                </div>
            }
        </div>
        </div>
    </article>

    <article class="av-card">
        <header class="av-card-head"><div><h2>Bhinnāṣṭavarga</h2></div></header>
        <div class="av-table-scroll">
            <table>
                <thead><tr><th>Recipient</th>@foreach (var sign in Signs) { <th><span>@ShortSign(sign)</span><small>H@(HouseNumber(sign))</small></th> }<th>Σ</th></tr></thead>
                <tbody>
                    @foreach (var recipient in Recipients)
                    {
                        var cells = SelectedRows.Where(r => r.RecipientCode.Equals(recipient, StringComparison.OrdinalIgnoreCase)).ToDictionary(r => (int)r.SignNumber);
                        <tr><th>@DisplayRecipient(recipient)</th>@foreach (var sign in Signs) { var value = cells.GetValueOrDefault(sign)?.BinduCount; <td class="av-bindu @BinduBand(recipient, value)">@(value?.ToString() ?? "—")</td> }<td class="av-sum">@cells.Values.Sum(r => r.BinduCount)</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </article>

    @if (Sodhita is { } sodhita)
    {
        <article class="av-card">
            <header class="av-card-head"><div><h2>Śodhita Aṣṭakavarga</h2><p class="av-context">@SelectedChart · after Ṭrikoṇa and Ekādhipatya Śodhana · occupancy from @SelectedChart</p></div></header>
            <div class="av-table-scroll">
                <table class="av-sodhita">
                    <thead><tr><th>Recipient</th>@foreach (var sign in Signs) { <th><span>@ShortSign(sign)</span><small>H@(HouseNumber(sign))</small></th> }<th>Σ</th></tr></thead>
                    <tbody>
                        @foreach (var (recipient, bindus) in sodhita)
                        {
                            <tr><th>@DisplayRecipient(recipient)</th>@foreach (var sign in Signs) { var v = bindus[sign - 1]; <td class="@(v == 0 ? "av-muted" : null)">@v</td> }<td class="av-sum">@bindus.Sum()</td></tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr><th title="Column sum of the seven reduced rows. JHora's SoAV 'SAV' box is built another, undocumented way and does not equal this sum.">Σ reduced</th>@foreach (var sign in Signs) { <td class="av-sum">@sodhita.Sum(r => r.Bindus[sign - 1])</td> }<td class="av-sum">@sodhita.Sum(r => r.Bindus.Sum())</td></tr>
                    </tfoot>
                </table>
            </div>
        </article>
    }

    @if (SelectedPindaRows.Count > 0)
    {
        <article class="av-card">
            <header class="av-card-head"><div><h2>Piṇḍa</h2></div></header>
            <div class="av-table-scroll"><table class="av-pinda"><thead><tr><th>Recipient</th><th>Rāśi Piṇḍa</th><th>Graha Piṇḍa</th><th>Śodhya Piṇḍa</th></tr></thead><tbody>
                @foreach (var row in SelectedPindaRows) { <tr><th>@DisplayRecipient(row.RecipientCode)</th><td>@Value(row.RasiPinda)</td><td>@Value(row.GrahaPinda)</td><td class="av-sum">@Value(row.SodhyaPinda)</td></tr> }
            </tbody></table></div>
        </article>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AshtakavargaRow> Rows { get; set; } = Array.Empty<AshtakavargaRow>();
    [Parameter] public IReadOnlyList<AshtakavargaPindaRow> PindaRows { get; set; } = Array.Empty<AshtakavargaPindaRow>();
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, LoadedChart> Charts { get; set; } = new Dictionary<string, LoadedChart>();

    private static readonly int[] Signs = Enumerable.Range(1, 12).ToArray();
    private static readonly string[] SignNames = { "", "Ari", "Tau", "Gem", "Can", "Leo", "Vir", "Lib", "Sco", "Sag", "Cap", "Aqu", "Pis" };
    private static readonly string[] RecipientOrder = { "SUN", "MOON", "MARS", "MERCURY", "JUPITER", "VENUS", "SATURN" };
    private IReadOnlyList<AshtakavargaRow> SelectedRows => Rows.Where(r => r.ChartType.Equals(SelectedChart, StringComparison.OrdinalIgnoreCase)).ToList();
    private IReadOnlyList<AshtakavargaPindaRow> SelectedPindaRows => PindaRows.Where(r => r.ChartType.Equals(SelectedChart, StringComparison.OrdinalIgnoreCase)).ToList();
    private IEnumerable<string> Recipients => RecipientOrder.Where(x => SelectedRows.Any(r => r.RecipientCode.Equals(x, StringComparison.OrdinalIgnoreCase)));

    /// <summary>Two-way bound to the caller's own chart picker (AstroFacts's
    /// `_natalChart`/`ChartColumn`, 2026-09-25, rammyps's call — "connect related drop-downs"):
    /// picking a chart here also moves the natal chart on the left, and vice versa, same
    /// `Name`/`NameChanged` pair Blazor's `@bind-SelectedChart` expects (GrahaDrishtiMatrix
    /// already declared this pair but never got a caller wired up to it — this is the first
    /// live use). See design-language.md "Related chart drop-downs" for the convention this
    /// establishes for any other picker pair found to represent the same chart selection.</summary>
    [Parameter] public string SelectedChart { get; set; } = "D1";
    [Parameter] public EventCallback<string> SelectedChartChanged { get; set; }

    private enum SortMode { HouseOrder, StrengthRank }
    private SortMode _sort = SortMode.HouseOrder;
    private IReadOnlyList<LoadedChart> ChartOptions => Charts.Values.Where(c => Rows.Any(r => r.ChartType.Equals(c.ChartType, StringComparison.OrdinalIgnoreCase))).OrderBy(c => ChartDivisor(c.ChartType)).ToList();
    private async Task OnChartChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? "D1";
        if (value == SelectedChart) return;
        SelectedChart = value;
        await SelectedChartChanged.InvokeAsync(value);
    }

    private IReadOnlyList<(int SignNumber, int TotalBindus)> SavRowsBySign =>
        Signs.Select(s => (s, SelectedRows.Where(r => r.SignNumber == s).Select(r => (int?)r.SarvaBindus).FirstOrDefault(v => v is not null) ?? SelectedRows.Where(r => r.SignNumber == s).Sum(r => (int)r.BinduCount))).ToList();

    private IReadOnlyList<(int SignNumber, int TotalBindus)> SavRows =>
        _sort == SortMode.HouseOrder
            ? SavRowsBySign.OrderBy(r => HouseNumber(r.SignNumber)).ToList()
            : SavRowsBySign.OrderByDescending(r => r.TotalBindus).ToList();

    /// <summary>South Indian layout is sign-fixed (Pisces top-left, clockwise), the same 4x4 ring
    /// MiniGrid uses; SignNumber 1 = Aries.</summary>
    private static readonly (int SignNumber, int Col, int Row)[] SouthCells =
    {
        (12,1,1), (1,2,1), (2,3,1), (3,4,1),
        (11,1,2), (4,4,2),
        (10,1,3), (5,4,3),
        (9,1,4), (8,2,4), (7,3,4), (6,4,4)
    };
    private int SavTotal(int sign) => SavRowsBySign.First(r => r.SignNumber == sign).TotalBindus;

    private int GrandTotal => SavRowsBySign.Sum(r => r.TotalBindus);

    private int HouseNumber(int signNumber)
    {
        return SelectedRows.FirstOrDefault(r => r.SignNumber == signNumber)?.HouseNumber ?? signNumber;
    }
    private static int ChartDivisor(string code) => int.TryParse(code.TrimStart('D', 'd'), out var divisor) ? divisor : int.MaxValue;
    /// <summary>Bhinnashtavarga cell shading: the cell takes the recipient graha's own band ramp, with 4 bindus
    /// as par (stop 0) and 0 / 8 as the -4 / +4 ends (PlanetBand.FromBindus) — the same
    /// -4..+4 scale Shadbala and dignity use, in planet-bands.css. Lagna, which has no graha
    /// colour, uses the Golden ramp.</summary>
    private static string BinduBand(string recipient, int? value) => value is null ? "" : PlanetBand.Class(DisplayRecipient(recipient), PlanetBand.FromBindus(value.Value));

    /// <summary>Sarvāṣṭavarga sign-total banding — StrengthBands.SarvaAshtakavargaBindus
    /// (tbl_Rule_StrengthBand, migration 154; SRC_PVR_INTEGRATED via docs/research/domain/
    /// transit-events.md, "SAV &gt;30 favorable and &lt;25 unfavorable"). Banded on the Golden ramp (the per-theme chart colour):
    /// 28 is par (stop 0), one stop per 3 bindus (PlanetBand.FromSarvaTotal), which keeps >30 above
    /// par and <25 below it. Deliberately NOT applied to the Piṇḍa table below — Rāśi/Graha/Śodhya Piṇḍa are
    /// multiplier/remainder values used to locate a target nakshatra or sign (same source), not
    /// strength scores, so there is no cited threshold to band them by.</summary>
    private static string SavBand(int totalBindus) => PlanetBand.Class(null, PlanetBand.FromSarvaTotal(totalBindus));

    private static readonly string[] Grahas = { "Sun", "Moon", "Mars", "Mercury", "Jupiter", "Venus", "Saturn" };

    /// <summary>Each Bhinnāṣṭakavarga after Ṭrikoṇa then Ekādhipatya Śodhana (Core
    /// AshtakavargaCalculator, the same reduction the Piṇḍa is built on), with the selected chart's
    /// own graha occupancy. Null when the chart or any recipient's twelve bindus are missing.</summary>
    private IReadOnlyList<(string Recipient, int[] Bindus)>? Sodhita
    {
        get
        {
            if (!Charts.TryGetValue(SelectedChart, out var chart)) return null;
            var occupied = new HashSet<int>();
            foreach (var g in Grahas)
            {
                var sign = chart.Grahas.FirstOrDefault(k => k.Planet == g)?.Sign;
                if (!Enum.TryParse<Ikiastrro.Core.Engines.Astronomy.ZodiacName>(sign, true, out var z)) return null;
                occupied.Add((int)z);
            }
            var rows = new List<(string, int[])>();
            foreach (var recipient in Recipients)
            {
                var bindus = new int[12];
                var cells = SelectedRows.Where(r => r.RecipientCode.Equals(recipient, StringComparison.OrdinalIgnoreCase)).ToList();
                if (cells.Count != 12) return null;
                foreach (var c in cells) bindus[c.SignNumber - 1] = c.BinduCount;
                rows.Add((recipient, Ikiastrro.Core.Engines.Ashtakavarga.AshtakavargaCalculator.EkadhipatyaSodhana(
                    Ikiastrro.Core.Engines.Ashtakavarga.AshtakavargaCalculator.TrikonaSodhana(bindus), occupied)));
            }
            return rows.Count == 0 ? null : rows;
        }
    }

    private static string ShortSign(int signNumber) => SignNames[signNumber];
    private static string DisplayRecipient(string code) => CultureInfo.InvariantCulture.TextInfo.ToTitleCase(code.ToLowerInvariant());
    private static string Value(short? value) => value?.ToString(CultureInfo.InvariantCulture) ?? "—";
    private static string BarWidth(int bindus) => Math.Clamp(bindus / 40d * 100d, 0, 100).ToString("0.##", CultureInfo.InvariantCulture);
}
