@using System.Globalization
@using Ikiastrro.Web.Components.Workspace

<section class="am" aria-labelledby="am-title">
    <article class="am-card">
        <header class="am-card-head">
            <div>
                <h2 id="am-title">@(_scheme == "VARGOTTAMA" ? "Vargottama" : $"Aṁśabala — {SchemeLabel(_scheme)}")</h2>
                <p class="am-subtext">@Subtext(_scheme)</p>
                <nav class="am-schemes" aria-label="Varga scheme">
                    @foreach (var s in SchemeOrder)
                    {
                        <button type="button" class="@(s == _scheme ? "is-active" : null)" @onclick="@(() => _scheme = s)">@SchemeShort(s)</button>
                    }
                </nav>
            </div>
        </header>

        @if (_scheme == "VARGOTTAMA")
        {
            <div class="am-table-scroll">
                <table>
                    <thead><tr><th>Graha</th><th>D1 Sign</th><th>D9 Sign</th><th>Match</th></tr></thead>
                    <tbody>
                        @foreach (var r in VargottamaRows)
                        {
                            <tr>
                                <th>@DisplayPlanet(r.PlanetCode)</th>
                                <td>@Disp(r.D1Sign)</td>
                                <td>@Disp(r.D9Sign)</td>
                                <td class="@(r.IsVargottama ? "am-high" : "am-zero")">@(r.IsVargottama ? "Yes" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="am-bars">
                @foreach (var r in SchemeRows)
                {
                    <div class="am-bar-row">
                        <span class="am-bar-planet">@DisplayPlanet(r.PlanetCode)</span>
                        <span class="am-stack">
                            @foreach (var seg in Segments(r.PlanetCode))
                            {
                                @if (seg.Token is "exalted" or "good")
                                {
                                    <span class="am-seg" style="background:var(--dignity-@seg.Token)" title="@seg.ChartType — @seg.DignityStatus">@seg.ChartType</span>
                                }
                                else
                                {
                                    <span class="am-seg am-seg-empty" title="@seg.ChartType — @seg.DignityStatus"></span>
                                }
                            }
                        </span>
                        <b class="am-bar-value @(r.GoodCount == 0 ? "am-zero" : r.GoodCount * 2 >= r.GroupSize ? "am-high" : "")">@r.GoodCount<span>/@r.GroupSize</span></b>
                    </div>
                }
            </div>
            <p class="am-key">
                @foreach (var token in DignityKey)
                {
                    <span><i style="background:var(--dignity-@token.Token)"></i> @token.Label</span>
                }
            </p>
        }
    </article>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AmsabalaRow> Rows { get; set; } = Array.Empty<AmsabalaRow>();
    [Parameter, EditorRequired] public IReadOnlyList<AmsabalaGroupMember> Groups { get; set; } = Array.Empty<AmsabalaGroupMember>();
    [Parameter, EditorRequired] public IReadOnlyList<VargottamaRow> Vargottama { get; set; } = Array.Empty<VargottamaRow>();
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, LoadedChart> Charts { get; set; } = new Dictionary<string, LoadedChart>();

    private static readonly string[] PlanetOrder = { "SUN", "MOON", "MARS", "MERCURY", "JUPITER", "VENUS", "SATURN" };
    private static readonly string[] SchemeOrder = { "VARGOTTAMA", "SHADVARGA", "SAPTAVARGA", "DASAVARGA", "SHODASAVARGA" };

    private string _scheme = "VARGOTTAMA";

    private IReadOnlyList<AmsabalaRow> SchemeRows =>
        PlanetOrder
            .Select(p => Rows.FirstOrDefault(r => r.PlanetCode.Equals(p, StringComparison.OrdinalIgnoreCase)
                                                 && r.SchemeCode.Equals(_scheme, StringComparison.OrdinalIgnoreCase)))
            .Where(r => r is not null)
            .Select(r => r!)
            .ToList();

    private IReadOnlyList<VargottamaRow> VargottamaRows =>
        PlanetOrder
            .Select(p => Vargottama.FirstOrDefault(r => r.PlanetCode.Equals(p, StringComparison.OrdinalIgnoreCase)))
            .Where(r => r is not null)
            .Select(r => r!)
            .ToList();

    // "N charts compared (Rasi chart with D-x,D-y,...)" — built off the actual seeded group
    // membership (tbl_Rule_AmsabalaGroup, db/101), not a hardcoded copy of it.
    private string Subtext(string scheme)
    {
        if (scheme == "VARGOTTAMA") return "2 charts compared (Rasi chart with D-9)";
        var members = Groups.Where(g => g.SchemeCode.Equals(scheme, StringComparison.OrdinalIgnoreCase)).ToList();
        var rest = members.Where(g => !g.ChartType.Equals("D1", StringComparison.OrdinalIgnoreCase))
            .Select(g => "D-" + g.ChartType.TrimStart('D', 'd'));
        return $"{members.Count} charts compared (Rasi chart with {string.Join(",", rest)})";
    }

    private static string SchemeLabel(string s) => s switch
    {
        "SHADVARGA" => "Shadvarga (6)",
        "SAPTAVARGA" => "Saptavarga (7)",
        "DASAVARGA" => "Dasavarga (10)",
        "SHODASAVARGA" => "Shodasavarga (16)",
        _ => s,
    };

    private static string SchemeShort(string s) => s switch
    {
        "VARGOTTAMA" => "Vargottama",
        "SHADVARGA" => "Shadvarga",
        "SAPTAVARGA" => "Saptavarga",
        "DASAVARGA" => "Dasavarga",
        "SHODASAVARGA" => "Shodasavarga",
        _ => s,
    };

    private static string DisplayPlanet(string code) => CultureInfo.InvariantCulture.TextInfo.ToTitleCase(code.ToLowerInvariant());
    private static string Disp(string s) => s == "Capricornus" ? "Capricorn" : s;

    // One slot per varga in the current scheme (so the row still reads as "N out of GroupSize"),
    // but only the ones that actually count toward GoodCount — Exalted or Own/Moolatrikona/Great
    // Friend (AmsabalaCalculator's "isGood") — get coloured and named; the rest render as plain
    // empty slots. Colour reuses the same --dignity-* tokens every other chart view in the app
    // already colours planets with, read live off Charts (already loaded by WorkspaceData).
    private IEnumerable<(string ChartType, string DignityStatus, string Token)> Segments(string planetCode) =>
        Groups.Where(g => g.SchemeCode.Equals(_scheme, StringComparison.OrdinalIgnoreCase))
            .Select(g =>
            {
                var status = Charts.TryGetValue(g.ChartType, out var chart)
                    ? chart.Grahas.FirstOrDefault(k => k.Planet.Equals(planetCode, StringComparison.OrdinalIgnoreCase))?.DignityStatus
                    : null;
                return (g.ChartType, DignityStatus: status ?? "Unknown",
                    Token: Ikiastrro.Core.Presentation.ChartViewModel.DignityToken(status));
            });

    private static readonly (string Token, string Label)[] DignityKey =
    {
        ("exalted", "Exalted"),
        ("good", "Own / Moolatrikona / Great Friend"),
    };
}
