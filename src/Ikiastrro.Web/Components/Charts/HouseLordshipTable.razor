@* House lordship for one chart — the classical "lord of the Nth house is placed in…" reading. *@
@using Ikiastrro.Web.Components.LifeMatters
<div class="hlt-scroll">
    <table class="hlt">
        <thead>
            <tr>
                <th>House</th><th>Sign</th><th>Lord</th><th>Placed in (Lagna)</th><th>Placed in (Chandra)</th><th>Lord's dignity</th>
                @if (Occupants is not null) { <th>Occupants</th> }
                @if (LifeMatters is not null) { <th>Life matters</th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Rows.OrderBy(r => r.HouseNumber))
            {
                <tr>
                    <td class="mono">@r.HouseNumber</td>
                    <td>@Disp(r.HouseSign)</td>
                    <td>@r.LordPlanet</td>
                    <td>House @r.LordPlacedInHouseFromLagna, @Disp(r.LordPlacedInSign)</td>
                    <td class="mono">House @r.LordPlacedInHouseFromMoon</td>
                    <td>
                        @if (r.LordDignityStatus is null) { <span class="muted">—</span> }
                        else { <span class="pill"><span class="dot" style="background:var(--dignity-@ChartViewModel.DignityToken(r.LordDignityStatus))"></span>@r.LordDignityStatus</span> }
                    </td>
                    @if (Occupants is not null)
                    {
                        <td>@Occupants.GetValueOrDefault(r.HouseNumber, "—")</td>
                    }
                    @if (LifeMatters is not null)
                    {
                        var matters = LifeMatters.GetValueOrDefault(r.HouseNumber) ?? [];
                        <td class="hlt-matters">
                            @if (matters.Count == 0) { <span class="muted">—</span> }
                            @foreach (var m in matters.Take(ShownMatters))
                            {
                                <a href="@MatterUrl(m)" title="@($"{m.AreaName} — read in Key Inference")">@m.MatterText</a>
                            }
                            @if (matters.Count > ShownMatters)
                            {
                                <details>
                                    <summary>@(matters.Count - ShownMatters) more</summary>
                                    @foreach (var m in matters.Skip(ShownMatters))
                                    {
                                        <a href="@MatterUrl(m)" title="@($"{m.AreaName} — read in Key Inference")">@m.MatterText</a>
                                    }
                                </details>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ChartHouseLord> Rows { get; set; } = Array.Empty<ChartHouseLord>();

    /// <summary>Optional: house number -> comma-joined occupant graha names. When supplied, adds an
    /// "Occupants" column — Astro Facts's "House Lord Placement" table (2.1 About Houses); left
    /// null everywhere else (VargaView's plain disclosure table).</summary>
    [Parameter] public IReadOnlyDictionary<int, string>? Occupants { get; set; }

    /// <summary>Optional: house number -> the life matters read from that house (LifeMatterHouseIndex).
    /// When supplied with <see cref="PersonId"/>, adds a "Life matters" column whose entries open
    /// that matter in Key Inference — Astro Facts's About Houses table only.</summary>
    [Parameter] public IReadOnlyDictionary<int, IReadOnlyList<HouseMatterLink>>? LifeMatters { get; set; }

    [Parameter] public int PersonId { get; set; }

    /// <summary>The chart this table shows; Key Inference links read the matter in it (left out
    /// for D1, so the matter opens in its own varga).</summary>
    [Parameter] public string? ChartType { get; set; }

    private const int ShownMatters = 2;

    private string MatterUrl(HouseMatterLink m) =>
        KeyInferenceLink.Url(PersonId, m.MatterCode, "LAGNA", ChartType is null or "D1" ? null : ChartType);

    private static string Disp(string s) => s == "Capricornus" ? "Capricorn" : s;
}
