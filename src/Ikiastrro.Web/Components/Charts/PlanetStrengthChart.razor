@using System.Globalization
@* Astro Facts 3.1 "Planet Strength" — one stacked bar per graha on a shared rūpa axis
   (vw_ChartShadbala + tbl_Fact_PlanetaryStrengthComponent), docs/ui/components/astro-facts.md
   step 3. Segments are the six balas + Yuddha, or (BALAS / SUB-COMPONENTS switch) every stored
   sub-component shaded within its bala's colour. Each bar carries its planet's required-minimum
   tick; hovering a segment lists what it is made of. Negative values (Dṛk Bala) draw left of zero.
   Plain absolutely-positioned spans, no charting library (chart-catalog.md); geometry lives in
   StackedBarLayout so it is testable without rendering. *@
<div class="psc">
    <div class="psc-head">
        <div class="psc-legend">
            @foreach (var g in BalaGroups)
            {
                <span class="psc-legend-item"><span class="psc-dot psc-bala-@g.Token"></span>@g.Label</span>
            }
            <span class="psc-legend-item"><span class="psc-minkey"></span>Required minimum</span>
        </div>
        <div class="psc-toggle" role="group" aria-label="Bar segments">
            <button type="button" class="@(_subComponents ? "" : "psc-toggle-on")" aria-pressed="@(!_subComponents)" @onclick="() => _subComponents = false">Balas</button>
            <button type="button" class="@(_subComponents ? "psc-toggle-on" : "")" aria-pressed="@_subComponents" @onclick="() => _subComponents = true">Sub-components</button>
        </div>
    </div>

    <div class="psc-colheads">
        <span class="psc-c-rank">Rank</span>
        <span class="psc-c-planet">Planet</span>
        <span class="psc-c-bar">
            <span class="psc-scale" aria-hidden="true">
                @foreach (var t in _axis.Ticks())
                {
                    <span class="psc-tick" style="left:@Pct(_axis.Position(t))%">@t.ToString("0", CultureInfo.InvariantCulture)</span>
                }
            </span>
            <span class="psc-scale-title">Shadbala (rūpas)</span>
        </span>
        <span class="psc-c-num">Rūpas</span>
        <span class="psc-c-num">Min.</span>
        <span class="psc-c-num">% Min.</span>
        <span class="psc-c-num">Capacity</span>
        <span class="psc-c-num">Ishta · Kashta</span>
        <span class="psc-c-status">Status</span>
    </div>

    @foreach (var (rank, row) in Ranked)
    {
        var (label, css) = StatusOf(row.PercentOfMinimum);
        <div class="psc-row">
            <span class="psc-c-rank"><span class="psc-rankbadge @css">@rank</span></span>
            <span class="psc-c-planet">@row.Planet</span>
            <span class="psc-c-bar">
                <span class="psc-bar" role="img" aria-label="@AriaLabel(row)">
                    @foreach (var s in StackedBarLayout.Layout(Parts(row), _axis))
                    {
                        <span class="psc-seg @(s.IsNegative ? "psc-seg-neg" : "")"
                              style="left:@Pct(s.LeftPercent)%;width:@Pct(s.WidthPercent)%;background:@Fill(s.Part)"
                              title="@Tooltip(s.Part)">@(s.WidthPercent >= 7 ? s.Part.Value.ToString("0.00", CultureInfo.InvariantCulture) : "")</span>
                    }
                    @if (_axis.Min < 0)
                    {
                        <span class="psc-zero" style="left:@Pct(_axis.Position(0))%"></span>
                    }
                    @if (row.MinimumRequiredRupas is { } min)
                    {
                        <span class="psc-min" style="left:@Pct(_axis.Position(min))%" title="Required minimum @min.ToString("0.0", CultureInfo.InvariantCulture) rūpas"></span>
                    }
                </span>
            </span>
            <span class="psc-c-num psc-mono">@row.ShadbalaRupas.ToString("0.00", CultureInfo.InvariantCulture)</span>
            <span class="psc-c-num psc-mono">@(row.MinimumRequiredRupas is { } m ? m.ToString("0.0", CultureInfo.InvariantCulture) : "—")</span>
            <span class="psc-c-num psc-mono">@(row.PercentOfMinimum is { } pm ? $"{pm:0}%" : "—")</span>
            <span class="psc-c-num psc-mono" title="@(row.PercentOfMinimum is { } cb ? CapacityBand(cb) : "—")">@(row.PercentOfMinimum is { } cp ? $"{CapacityScore(cp):0}" : "—")</span>
            <span class="psc-c-num psc-mono psc-ik" title="Ishta = √(Uchcha × Cheṣṭā), Kashta = √((60 − Uchcha) × (60 − Cheṣṭā)) — the share of the planet's results that is good / bad, out of 60">
                @(row.IshtaBala is { } ishta && row.KashtaBala is { } kashta
                    ? $"{ishta.ToString("0.0", CultureInfo.InvariantCulture)} · {kashta.ToString("0.0", CultureInfo.InvariantCulture)}"
                    : "—")
            </span>
            <span class="psc-c-status"><span class="psc-pill @css">@label</span></span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ShadbalaSummaryRow> Rows { get; set; } = Array.Empty<ShadbalaSummaryRow>();
    [Parameter, EditorRequired] public IReadOnlyList<ShadbalaComponentRow> Components { get; set; } = Array.Empty<ShadbalaComponentRow>();

    private bool _subComponents;
    private StackAxis _axis = new(0, 1);

    // One axis for both views — the bala totals and their sub-component sums span the same range,
    // so switching views never rescales the chart.
    protected override void OnParametersSet() =>
        _axis = StackedBarLayout.Axis(Rows.Select(BalaParts), Rows.Select(r => r.MinimumRequiredRupas));

    /// <summary>Ranked strongest-first (PercentOfMinimum desc).</summary>
    private IReadOnlyList<(int Rank, ShadbalaSummaryRow Row)> Ranked =>
        Rows.OrderByDescending(r => r.PercentOfMinimum ?? -1)
            .Select((r, i) => (i + 1, r)).ToList();

    private static readonly (string Code, string Label, string Token)[] BalaGroups =
    {
        ("STHANA_BALA", "Sthāna", "sthana"),
        ("DIG_BALA", "Dig", "dig"),
        ("KALA_BALA", "Kāla", "kala"),
        ("CHESTA_BALA", "Cheṣṭā", "cheshta"),
        ("NAISARGIKA_BALA", "Naisargika", "naisargika"),
        ("DRIK_BALA", "Dṛk", "drik"),
        ("YUDDHA_BALA", "Yuddha", "yuddha"),
    };

    /// <summary>Sub-component labels, in the order they stack inside their bala.</summary>
    private static readonly (string Code, string Label)[] SubComponents =
    {
        ("UCHCHA_BALA", "Uchcha"), ("SAPTAVARGAJA_BALA", "Saptavargaja"), ("OJHA_YUGMA_RASYAMSA_BALA", "Ojayugma"),
        ("KENDRADI_BALA", "Kendrādi"), ("DREKKANA_BALA", "Drekkāṇa"),
        ("DIG_BALA", "Dig"),
        ("NATHONNATA_BALA", "Nathonnata"), ("PAKSHA_BALA", "Pakṣa"), ("TRIBHAGA_BALA", "Tribhāga"),
        ("VARSHA_BALA", "Abda"), ("MASA_BALA", "Māsa"), ("DINA_BALA", "Vāra"), ("HORA_BALA", "Horā"),
        ("AYANA_BALA", "Ayana"),
        ("CHESTA_BALA", "Cheṣṭā"), ("NAISARGIKA_BALA", "Naisargika"), ("DRIK_BALA", "Dṛk"), ("YUDDHA_BALA", "Yuddha"),
    };

    private IReadOnlyList<StackPart> Parts(ShadbalaSummaryRow row) => _subComponents ? SubParts(row) : BalaParts(row);

    private IReadOnlyList<StackPart> BalaParts(ShadbalaSummaryRow row)
    {
        decimal[] virupas =
        {
            row.SthanaBalaVirupas, row.DigBalaVirupas, row.KalaBalaVirupas,
            row.CheshtaBalaVirupas, row.NaisargikaBalaVirupas, row.DrikBalaVirupas, row.YuddhaBalaVirupas,
        };
        return BalaGroups.Select((g, i) => new StackPart(g.Code, g.Label, g.Token, Math.Round(virupas[i] / 60m, 2),
            Breakdown(row.Planet, g.Code))).ToList();
    }

    private IReadOnlyList<StackPart> SubParts(ShadbalaSummaryRow row)
    {
        var mine = Components.Where(c => c.Planet.Equals(row.Planet, StringComparison.OrdinalIgnoreCase)).ToList();
        var parts = new List<StackPart>();
        foreach (var g in BalaGroups)
        {
            var subs = mine.Where(c => c.BalaCode == g.Code).OrderBy(c => SubOrder(c.SubComponentCode)).ToList();
            for (var i = 0; i < subs.Count; i++)
                parts.Add(new StackPart(subs[i].SubComponentCode, $"{g.Label} · {SubLabel(subs[i].SubComponentCode)}", g.Token,
                    Math.Round(subs[i].ValueVirupas / 60m, 2), $"{subs[i].ValueVirupas.ToString("0.00", CultureInfo.InvariantCulture)} virūpas", i));
        }
        return parts;
    }

    /// <summary>"Nathonnata 60.00 · Pakṣa 9.70 · …" (virūpas) — the hover detail of one bala segment.</summary>
    private string? Breakdown(string planet, string balaCode)
    {
        var subs = Components.Where(c => c.Planet.Equals(planet, StringComparison.OrdinalIgnoreCase) && c.BalaCode == balaCode)
            .OrderBy(c => SubOrder(c.SubComponentCode))
            .Select(c => $"{SubLabel(c.SubComponentCode)} {c.ValueVirupas.ToString("0.00", CultureInfo.InvariantCulture)}").ToList();
        return subs.Count > 1 ? string.Join(" · ", subs) + " (virūpas)" : null;
    }

    private static string Tooltip(StackPart p) =>
        $"{p.Label}: {p.Value.ToString("0.00", CultureInfo.InvariantCulture)} rūpas" + (p.Detail is null ? "" : $"\n{p.Detail}");

    /// <summary>The bala's colour; successive sub-components fade toward the card so neighbours stay distinct.</summary>
    private static string Fill(StackPart p) =>
        p.Shade == 0 ? $"var(--bala-{p.Token})"
        : $"color-mix(in srgb, var(--bala-{p.Token}) {Math.Max(100 - p.Shade * 16, 36)}%, var(--card-bg))";

    private static int SubOrder(string code)
    {
        var i = Array.FindIndex(SubComponents, s => s.Code == code);
        return i < 0 ? int.MaxValue : i;
    }

    private static string SubLabel(string code)
    {
        foreach (var s in SubComponents) { if (s.Code == code) return s.Label; }
        return code;
    }

    private static string AriaLabel(ShadbalaSummaryRow row) =>
        $"{row.Planet}: {row.ShadbalaRupas.ToString("0.00", CultureInfo.InvariantCulture)} rūpas" +
        (row.MinimumRequiredRupas is { } m ? $" against a minimum of {m.ToString("0.0", CultureInfo.InvariantCulture)}" : "");

    private static string Pct(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    /// <summary>StrengthBands.ShadbalaPercentOfMinimum (tbl_Rule_StrengthBand, migration 154): Strong
    /// from Parāśara's required minimum (SRC_BPHS_27), Moderate floor a project heuristic.</summary>
    private static readonly StrengthBandScale Band = StrengthBands.ShadbalaPercentOfMinimum;

    private static (string Label, string CssClass) StatusOf(decimal? percent) => Band.Classify(percent) switch
    {
        StrengthTier.Strong => ("Strong", "psc-status-strong"),
        StrengthTier.Moderate => ("Moderate", "psc-status-moderate"),
        StrengthTier.Weak => ("Weak", "psc-status-weak"),
        _ => ("—", "psc-status-none"),
    };

    /// <summary>"Capacity" — Shadbala %-of-minimum capped at 150% (docs/research/domain/
    /// stat_strength.md §1.1 S*), so a planet already far past its requirement doesn't visually
    /// dominate. Distinct from the Strong/Moderate/Weak Status column (this table's own StrengthBands
    /// cut-offs) — the coarser 5-band CapacityBand below is the statistics doc's scale,
    /// kept for future cross-measure (Shadbala/Amsabala/Bhavabala) comparison, not a replacement
    /// for Status.</summary>
    private static decimal CapacityScore(decimal percentOfMinimum) => Math.Min(percentOfMinimum, 150);

    private static string CapacityBand(decimal percentOfMinimum) => percentOfMinimum switch
    {
        < 75 => "Very weak",
        < 90 => "Weak",
        < 110 => "Adequate",
        < 130 => "Strong",
        _ => "Very strong",
    };
}
