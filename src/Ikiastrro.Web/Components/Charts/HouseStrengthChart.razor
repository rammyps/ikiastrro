@using System.Globalization
@using Ikiastrro.Core.Presentation
@* Astro Facts 3.2 "House Strength" — one stacked bar per house on a shared rūpa axis
   (vw_ChartBhavaBala + tbl_Fact_BhavaStrengthComponent: Bhāvādhipati / Bhava Dig / Bhava Dṛk,
   BhavaBalaCalculator), docs/ui/components/astro-facts.md step 3 — same shape as 3.1
   PlanetStrengthChart. Dashed lines mark the Moderate and Strong cut-offs; a negative Bhava Dṛk
   draws left of zero. House order / Strength rank toggle keeps rank = strength either way.
   Dignity pill and rank badge use the planet-band standard (PlanetBand, planet-bands.css). "hsc" = HouseStrengthChart. *@
<div class="hsc">
    <div class="hsc-head">
        <div class="hsc-legend">
            @foreach (var c in Parts)
            {
                <span class="hsc-legend-item"><span class="hsc-dot" style="background:var(--bala-@c.Token)"></span>@c.Label</span>
            }
            <span class="hsc-legend-item"><span class="hsc-bandkey"></span>Moderate @Band.ModerateFrom.ToString("0", CultureInfo.InvariantCulture) · Strong @Band.StrongFrom.ToString("0", CultureInfo.InvariantCulture) rūpas</span>
        </div>
        <div class="hsc-toggle" role="group" aria-label="Row order">
            <button type="button" class="@(_sort == SortMode.HouseOrder ? "hsc-toggle-on" : "")" aria-pressed="@(_sort == SortMode.HouseOrder)" @onclick="() => _sort = SortMode.HouseOrder">House order</button>
            <button type="button" class="@(_sort == SortMode.StrengthRank ? "hsc-toggle-on" : "")" aria-pressed="@(_sort == SortMode.StrengthRank)" @onclick="() => _sort = SortMode.StrengthRank">Strength rank</button>
        </div>
    </div>

    <div class="hsc-colheads">
        <span class="hsc-c-rank">Rank</span>
        <span class="hsc-c-house">House</span>
        <span>Sign</span>
        <span>Lord</span>
        <span>Lord placed</span>
        <span>Dignity</span>
        <span class="hsc-c-bar">
            <span class="hsc-scale" aria-hidden="true">
                @foreach (var t in _axis.Ticks())
                {
                    <span class="hsc-tick" style="left:@Pct(_axis.Position(t))%">@t.ToString("0", CultureInfo.InvariantCulture)</span>
                }
            </span>
            <span>Bhava Bala (rūpas)</span>
        </span>
        <span class="hsc-c-num">Rūpas</span>
        <span class="hsc-c-num" title="Bhava Dig + Bhava Dṛk only — without Bhāvādhipati Bala, which is the lord's own Ṣaḍbala (stat_strength.md §1.3)">Indep.</span>
    </div>

    @foreach (var (rank, row) in Displayed)
    {
        var css = StatusCss(row.BhavaBalaRupas);
        <div class="hsc-row">
            <span class="hsc-c-rank"><span class="hsc-rankbadge @css" title="@StatusLabel(row.BhavaBalaRupas)">@rank</span></span>
            <span class="hsc-c-house">H@(row.HouseNumber)</span>
            <span class="hsc-c-text">@(row.HouseSign ?? "—")</span>
            <span class="hsc-c-text">@(row.LordPlanet ?? "—")</span>
            <span class="hsc-c-text">@LordPlacedDisplay(row)</span>
            <span>
                @if (row.LordDignityStatus is null)
                { <span class="hsc-muted">—</span> }
                else
                { <span class="hsc-pill @PlanetBand.Class(row.LordPlanet, PlanetBand.FromDignity(row.LordDignityStatus))">@row.LordDignityStatus</span> }
            </span>
            <span class="hsc-c-bar">
                <span class="hsc-bar" role="img" aria-label="@($"H{row.HouseNumber}: {row.BhavaBalaRupas.ToString("0.00", CultureInfo.InvariantCulture)} rūpas, {StatusLabel(row.BhavaBalaRupas)}")">
                    @foreach (var s in StackedBarLayout.Layout(PartsFor(row.HouseNumber), _axis))
                    {
                        <span class="hsc-seg @(s.IsNegative ? "hsc-seg-neg" : "")"
                              style="left:@Pct(s.LeftPercent)%;width:@Pct(s.WidthPercent)%;background:var(--bala-@s.Part.Token)"
                              title="@($"{s.Part.Label}: {s.Part.Value.ToString("0.00", CultureInfo.InvariantCulture)} rūpas")">@(s.WidthPercent >= 7 ? s.Part.Value.ToString("0.00", CultureInfo.InvariantCulture) : "")</span>
                    }
                    @if (_axis.Min < 0)
                    {
                        <span class="hsc-zero" style="left:@Pct(_axis.Position(0))%"></span>
                    }
                    <span class="hsc-band" style="left:@Pct(_axis.Position(Band.ModerateFrom))%"></span>
                    <span class="hsc-band" style="left:@Pct(_axis.Position(Band.StrongFrom))%"></span>
                </span>
            </span>
            <span class="hsc-c-num hsc-mono">@row.BhavaBalaRupas.ToString("0.00", CultureInfo.InvariantCulture)</span>
            <span class="hsc-c-num hsc-mono">@IndependentRupas(row.HouseNumber).ToString("0.00", CultureInfo.InvariantCulture)</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<BhavaBalaSummaryRow> Rows { get; set; } = Array.Empty<BhavaBalaSummaryRow>();
    [Parameter, EditorRequired] public IReadOnlyList<BhavaBalaComponentRow> Components { get; set; } = Array.Empty<BhavaBalaComponentRow>();

    private enum SortMode { HouseOrder, StrengthRank }
    private SortMode _sort = SortMode.StrengthRank;
    private StackAxis _axis = new(0, 1);

    private static readonly (string Code, string Label, string Token)[] Parts =
    {
        ("BHAVADHIPATI_BALA", "Bhāvādhipati", "bhavadhipati"),
        ("BHAVA_DIG_BALA", "Bhava Dig", "dig"),
        ("BHAVA_DRIK_BALA", "Bhava Dṛk", "drik"),
    };

    // One axis for all twelve houses, always reaching the Strong cut-off so its line is drawn.
    protected override void OnParametersSet() =>
        _axis = StackedBarLayout.Axis(Rows.Select(r => PartsFor(r.HouseNumber)), [Band.StrongFrom]);

    private IReadOnlyList<StackPart> PartsFor(int house) =>
        Parts.Select(p => new StackPart(p.Code, p.Label, p.Token,
            Math.Round(Components.Where(c => c.HouseNumber == house && c.ComponentCode.Equals(p.Code, StringComparison.OrdinalIgnoreCase))
                .Sum(c => c.ValueVirupas) / 60m, 2))).ToList();

    /// <summary>Rank is always by strength (1 = highest Bhava Bala Rūpas) — "House order" only
    /// changes display order, never renumbers rank.</summary>
    private IReadOnlyList<(int Rank, BhavaBalaSummaryRow Row)> RankedByStrength =>
        Rows.OrderByDescending(r => r.BhavaBalaRupas).Select((r, i) => (i + 1, r)).ToList();

    private IReadOnlyList<(int Rank, BhavaBalaSummaryRow Row)> Displayed =>
        _sort == SortMode.HouseOrder ? RankedByStrength.OrderBy(x => x.Row.HouseNumber).ToList() : RankedByStrength;

    /// <summary>StrengthBands.BhavaBalaRupas (tbl_Rule_StrengthBand, migration 154). No classical
    /// cut-off exists for Bhava Bala, so both boundaries are SRC_IKIASTRRO_SYNTHESIS heuristics.</summary>
    private static readonly StrengthBandScale Band = StrengthBands.BhavaBalaRupas;

    private static string StatusCss(decimal rupas) => PlanetBand.Class(null, PlanetBand.FromBhavaRupas(rupas));

    private static string StatusLabel(decimal rupas) => Band.Classify(rupas) switch
    {
        StrengthTier.Strong => "Strong",
        StrengthTier.Moderate => "Moderate",
        _ => "Weak",
    };

    private static string LordPlacedDisplay(BhavaBalaSummaryRow row) =>
        row.LordPlacedInHouseFromLagna is { } h ? $"H{h} · {row.LordPlacedInSign ?? "—"}" : "—";

    /// <summary>Bhava Dig + Bhava Dṛk only (stat_strength.md §1.3's B^independent).</summary>
    private decimal IndependentRupas(int house) =>
        Components.Where(c => c.HouseNumber == house && IndependentBhavaBala.ComponentCodes.Contains(c.ComponentCode))
            .Sum(c => c.ValueVirupas) / 60m;

    private static string Pct(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}
